---
// src/pages/index.astro — Home. Copy fuente: doc maestro "Mobile One 2.0 — Sitio Web de Ventas" §4.
import Layout from '../layouts/Layout.astro';
import ClientLogos from '../components/home/ClientLogos.astro';
import ProblemHook from '../components/home/ProblemHook.astro';
import SolutionSlide from '../components/home/SolutionSlide.astro';
import HeroSplit from '../components/home/HeroSplit.astro';
import BrandCompat from '../components/home/BrandCompat.astro';
import SolutionPair from '../components/home/SolutionPair.astro';
import HowItWorksFlow from '../components/home/HowItWorksFlow.astro';
import ArchitectureTeaser from '../components/home/ArchitectureTeaser.astro';
import SocialProofStat from '../components/home/SocialProofStat.astro';
import CtaClose from '../components/home/CtaClose.astro';

const schemaData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Mobile One',
  url: 'https://mobileone.dotsolutions.io',
};
---

<Layout
  title="Mobile One 2.0: POS móvil para retail con inventario conectado"
  description="Convierte a tus vendedores en un punto de venta móvil. Vende con el stock de toda tu red, integrado a SAP Business One y a tu hardware de pago actual. Implementación en horas."
  image="/images/og-default.png"
  schemaData={schemaData}
>
  <HeroSplit
    eyebrow="Plataforma de venta asistida omnicanal"
    headline="Cada terminal de cobro, un punto de venta completo. Toda la tienda, sin filas."
    accentPhrase="punto de venta completo"
    breakAfterAccent={true}
    subheadline="Mobile One 2.0 elimina la caja fija: tus vendedores venden, cobran y facturan desde cualquier lugar de la sala usando el mismo terminal Getnet, Transbank o Mercado Pago que ya tienen, con acceso al stock de toda la red."
    ctaText="Agendar demo"
    ctaHref="/contacto"
    ctaSecondaryText="Ver cómo funciona"
    ctaSecondaryHref="#compatibilidad"
  />

  <ClientLogos
    claim="Compatible con el stack de pago y ERP que ya usan las cadenas retail más exigentes."
    logos={['Nordén', 'Cassia', 'Verax Retail', 'Lumen', 'Ostra', 'Platto Group']}
  />

  <ProblemHook
    lines={[
      '¿Cuántos clientes se fueron hoy solo por hacer fila?',
      '¿Y si lo que buscaban sí estaba, pero en otra tienda?',
      '¿Cuántas horas se pierden contando cajas, una por una?',
      'Imagina resolver las tres desde un solo dispositivo.',
    ]}
    images={[
      '/images/hook-frustracion.webp',
      '/images/hook-stock.webp',
      '/images/hook-bulto.webp',
      '/images/hook-resuelto.webp',
    ]}
  />

  <SolutionSlide
    eyebrow="Así lo resuelve"
    title="La misma pregunta, respondida tres veces"
    panels={[
      {
        num: '01',
        image: '/images/solucion-fila.webp',
        alt: 'Dos vendedoras cobrando en distintos puntos de la tienda al mismo tiempo, sin caja fija ni fila',
        heading: 'La fila desaparece',
        text: 'El vendedor cobra donde está el cliente, con el mismo terminal de pago. Ninguna caja fija decide cuánto vendes.',
      },
      {
        num: '02',
        image: '/images/solucion-stock.webp',
        alt: 'Vendedor con terminal Mobile One despachando un producto grande que solo puede salir por envío',
        heading: 'El stock deja de estar escondido',
        text: 'El terminal consulta el inventario de toda la red en tiempo real y reserva el despacho ahí mismo, frente al cliente.',
      },
      {
        num: '03',
        image: '/images/solucion-bulto.webp',
        alt: 'Trabajador escaneando un bulto sellado con el terminal, sin abrirlo',
        heading: 'Contar a mano ya no es el trabajo',
        text: 'Se escanea el bulto una vez y el sistema reconcilia todo su contenido contra la orden de compra.',
      },
    ]}
  />

  <BrandCompat
    eyebrow="Compatibilidad total"
    title="El mismo terminal que ya usas para cobrar"
  />

  <SolutionPair
    eyebrow="Más allá de la caja"
    title="El resto de la venta también corre en el mismo terminal"
    items={[
      {
        image: '/images/solucion-promo.webp',
        alt: 'Vendedora cobrando con terminal Mobile One con un descuento aplicado automáticamente',
        heading: 'Las promociones se aplican solas',
        text: 'Reglas por cliente, categoría, marca o ticket total, con CloudPromo y Prism conectados en tiempo real. El vendedor no calcula nada a mano.',
      },
      {
        image: '/images/solucion-backoffice.webp',
        alt: 'Encargada de tienda revisando ventas y stock en un panel web desde laptop y tablet',
        heading: 'El BackOffice ya no es otro sistema',
        text: 'Ventas, tiendas, artículos, clientes y usuarios desde un panel web sincronizado con tu ERP, sin digitar la misma información dos veces.',
      },
    ]}
  />

  <HowItWorksFlow
    title="Cómo funciona, en 4 pasos"
    headings={[
      'Entra con un QR',
      'Encuentra el producto',
      'El descuento se aplica solo',
      'Todo queda sincronizado',
    ]}
    steps={[
      'El vendedor escanea el QR de la tienda y su credencial',
      'Escanea o busca el producto y ve stock real, local y de red',
      'Aplica promos automáticas, cobra y elige entrega',
      'Se emite el documento y la venta se integra a SAP B1',
    ]}
  />

  <ArchitectureTeaser
    title="Se integra con lo que ya tienes, no lo reemplaza"
    text="Mobile One no duplica reglas de negocio: consulta el stock a tu ERP, delega las promociones a tu motor de promociones y opera sobre el hardware de pago que ya certificaste."
    badges={['Service Layer nativo', 'Agnóstico de hardware POS', 'Multi-tenant con feature flags']}
    inputs={[
      {
        label: 'Transbank · Getnet · Mercado Pago',
        sub: 'El hardware de pago que ya certificaste',
        logos: [
          { src: '/images/logo-transbank-white.png', tone: 'transbank' },
          { src: '/images/logo-getnet-white.png', tone: 'getnet' },
          { src: '/images/logo-mercadopago-color.svg', tone: 'light' },
        ],
      },
      { label: 'SAP Business One', sub: 'Tu ERP, sin duplicar datos' },
      { label: 'CloudPromo / Prism', sub: 'Tu motor de promociones' },
    ]}
    hub={{ label: 'Mobile One Core', sub: 'Orquesta, no reemplaza' }}
    outputs={[
      { label: 'App de venta móvil', sub: 'Vendedores en la sala' },
      { label: 'Facturador electrónico', sub: 'Boleta y factura al instante' },
    ]}
  />

  <SocialProofStat
    title="Retailers que ya vendieron su primer producto sin usar una caja"
    statLabel="Implementación típica"
    statText="Horas, no semanas."
    note="Casos de clientes reales se publican solo con autorización expresa. Mientras tanto, agenda una demo y te mostramos el flujo completo con tu catálogo."
  />

  <CtaClose
    title="¿Listo para dejar de perder ventas en la caja?"
    body="Agenda una demo de 30 minutos y te mostramos Mobile One funcionando con tu catálogo."
    ctaText="Agendar demo"
    ctaHref="/contacto"
    ctaSecondaryText="Hablar con un especialista"
    ctaSecondaryHref="/contacto"
  />
</Layout>
