---
// src/pages/integraciones/erp/sap-business-one.astro. Mobile One con SAP Business One. Sin datos inventados: ver DATO PENDIENTE.
import Layout from '../../../layouts/Layout.astro';
import IntegrationHero from '../../../components/integraciones/IntegrationHero.astro';
import Section from '../../../components/pages/Section.astro';
import FaqList from '../../../components/pages/FaqList.astro';
import CtaBand from '../../../components/pages/CtaBand.astro';
import { withBase } from '../../../utils/base.js';
import { graph, faqSchema, breadcrumbSchema, orgSchema } from '../../../utils/seo.js';
// DATO PENDIENTE: lista exacta de entidades que se sincronizan con SAP Business One

const crumbs = [
  {
    "label": "Integraciones",
    "href": "/integraciones"
  },
  {
    "label": "Tu ERP",
    "href": "/integraciones/erp"
  },
  {
    "label": "SAP Business One"
  }
];
const trail = [
  {
    "label": "Inicio",
    "href": "/"
  },
  {
    "label": "Integraciones",
    "href": "/integraciones"
  },
  {
    "label": "Tu ERP",
    "href": "/integraciones/erp"
  },
  {
    "label": "SAP Business One",
    "href": "/integraciones/erp/sap-business-one"
  }
];
const faqs = [
  {
    "q": "¿Mobile One reemplaza a SAP Business One?",
    "a": "No. Mobile One se conecta a tu ERP y no lo reemplaza: consulta el stock y registra las ventas."
  },
  {
    "q": "¿Qué información se sincroniza?",
    "a": "El stock, las ventas y los maestros de tiendas, artículos, clientes y usuarios."
  },
  {
    "q": "¿Funciona con otros ERP?",
    "a": "Sí. Mobile One también se integra con Retail Pro y con Retail Pro Prism."
  },
  {
    "q": "¿Sirve para tiendas en Chile y en Perú?",
    "a": "Sí. El ERP se integra igual; cambia el documento electrónico según la normativa de cada país."
  },
  {
    "q": "¿Cuánto demora conectar el ERP?",
    "a": "La implementación completa toma menos de una semana."
  }
];
const steps = [
  {
    "t": "Stock desde tu ERP",
    "d": "Mobile One consulta el stock en SAP Business One para que el vendedor vea la disponibilidad real."
  },
  {
    "t": "Venta en el punto de venta",
    "d": "El vendedor vende y cobra desde el POS móvil o la caja de pago."
  },
  {
    "t": "Registro en el ERP",
    "d": "La venta se integra a SAP Business One, sin que nadie la digite de nuevo."
  },
  {
    "t": "Recepción de mercadería",
    "d": "El contenido de cada bulto se cuadra contra la orden de compra del ERP."
  },
  {
    "t": "Maestros sincronizados",
    "d": "Tiendas, artículos, clientes y usuarios se gestionan en un panel sincronizado con tu ERP."
  }
];
const modules = [
  {
    "name": "POS móvil y caja de pago",
    "text": "Consultan el stock del ERP al armar la venta y registran la venta al cobrar."
  },
  {
    "name": "Recepción de mercadería",
    "text": "Cuadra los bultos que escaneas con la cámara o el infrarrojo del terminal contra el documento de tu ERP."
  },
  {
    "name": "Medición",
    "text": "Ventas, tiendas y vendedores en un panel sincronizado con tu ERP."
  }
];
const extra = {
  "title": "Qué no cambia",
  "intro": "Mobile One no duplica reglas de negocio.",
  "points": [
    "Tu ERP sigue siendo la fuente de verdad del stock.",
    "No hay que digitar la misma información dos veces.",
    "El mismo esquema sirve en tus tiendas de Chile y de Perú.",
    "La implementación toma menos de una semana."
  ]
};
const related = [
  {
    "name": "Retail Pro",
    "href": "/integraciones/erp/retail-pro",
    "text": "Otro ERP con el que se integra Mobile One."
  },
  {
    "name": "Retail Pro Prism",
    "href": "/integraciones/erp/retail-pro-prism",
    "text": "Otro ERP con el que se integra Mobile One."
  },
  {
    "name": "Medios de pago",
    "href": "/integraciones/medios-de-pago",
    "text": "Transbank, Getnet, Mercado Pago y Niubiz."
  },
  {
    "name": "Facturación electrónica",
    "href": "/integraciones/facturacion",
    "text": "Documento electrónico al cobrar."
  },
  {
    "name": "Todas las integraciones",
    "href": "/integraciones",
    "text": "ERP, pagos y facturación."
  }
];
const schemaData = graph(orgSchema, breadcrumbSchema(trail), faqSchema(faqs));
---

<Layout title="Mobile One con SAP Business One: POS integrado" description="Mobile One consulta el stock en SAP Business One y registra cada venta, sin digitar dos veces. POS móvil y caja de pago. Chile y Perú." image="/images/og-default.jpg" schemaData={schemaData}>
  <IntegrationHero crumbs={crumbs} title="Mobile One con" accent="SAP Business One" lead="El punto de venta que se integra a SAP Business One. Consulta el stock y registra cada venta, sin duplicar datos ni reemplazar tu ERP." ctaText="Agendar demo" ctaHref="/contacto" ctaSecondaryText="Ver el producto" ctaSecondaryHref="/producto" focus="erp1" />
  <Section title="Sobre SAP Business One" bg="light"><p class="text-lead">SAP Business One es un software de gestión empresarial para medianas y pequeñas empresas. Unifica finanzas, ventas e inventario en una sola plataforma.</p><div class="logo-strip"><span class="logo-chip logo-chip--light"><img src={withBase("/images/logo-sap-business-one.png")} alt="SAP Business One" loading="lazy" /></span><span class="tag">Chile y Perú</span></div></Section>
  <Section title="Cómo se conectan Mobile One y tu ERP" bg="white">
    <ol class="step-list">{steps.map((s) => (<li><h3>{s.t}</h3><p>{s.d}</p></li>))}</ol>
  </Section>
  <Section title="Qué módulos usan el ERP" bg="light">
    <div class="card-grid">{modules.map((m) => (<div><h3>{m.name}</h3><p>{m.text}</p></div>))}</div>
  </Section>
  <Section title={extra.title} intro={extra.intro} bg={'white'}>
    <ul class="check-list">{extra.points.map((t) => (<li set:html={t} />))}</ul>
  </Section>
  <Section title="Preguntas frecuentes" bg="light">
    <FaqList items={faqs} />
  </Section>
  <Section title="Más integraciones" bg="white">
    <div class="card-grid">{related.map((r) => (<a href={withBase(r.href)}><h3>{r.name}</h3><p>{r.text}</p></a>))}</div>
  </Section>
  <CtaBand title="¿Quieres verlo con tu operación?" text="Agenda una demo de 30 minutos con tu catálogo." />
</Layout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);
  document.addEventListener('astro:page-load', () => {
    // Solo esta página: los otros scripts de la web también escuchan astro:page-load y no deben tocar estos elementos.
    if (!location.pathname.replace(/\/$/, '').endsWith('/integraciones/erp/sap-business-one')) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    gsap.utils.toArray('[data-rv]').forEach((el, i) => { if (el.dataset.rvDone) return; el.dataset.rvDone = '1'; gsap.from(el, { opacity: 0, y: 32, duration: 1, ease: 'expo.out', delay: (i % 3) * 0.08, scrollTrigger: { trigger: el, start: 'top 88%', once: true } }); });
  });
</script>
