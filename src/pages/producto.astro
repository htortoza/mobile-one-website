---
// src/pages/producto.astro
// Deep-dive de producto (§5 doc maestro + spec 2026-08-24). Scroll único de
// 9 capítulos narrativos agrupados por momento del flujo de trabajo (spec:
// docs/superpowers/specs/2026-08-24-mobile-one-producto-chapters-design.md).
// Reemplaza el modelo de switcher (ver git history de este archivo antes de
// este commit para el modelo anterior).
import Layout from '../layouts/Layout.astro';
import ProductoHero from '../components/producto/ProductoHero.astro';
import ProductoChapterNav from '../components/producto/ProductoChapterNav.astro';
import ProductoChapter from '../components/producto/ProductoChapter.astro';
import ProductoPasilloMoment from '../components/producto/ProductoPasilloMoment.astro';
import ProductoFeatureSticky from '../components/producto/ProductoFeatureSticky.astro';
import ProductoBridge from '../components/producto/ProductoBridge.astro';
import ProductoFeatureBento from '../components/producto/ProductoFeatureBento.astro';
import ProductoNetworkDiagram from '../components/producto/ProductoNetworkDiagram.astro';
import ProductoSystemStat from '../components/producto/ProductoSystemStat.astro';
import ProductoScaleBand from '../components/producto/ProductoScaleBand.astro';
import ProductoBlockHead from '../components/producto/ProductoBlockHead.astro';
import ProductoProblem from '../components/producto/ProductoProblem.astro';
import ModuleShowcase from '../components/showcase/ModuleShowcase.astro';
import MoreModules from '../components/showcase/MoreModules.astro';
import { showcaseModules } from '../data/showcase-modules.js';
import CtaClose from '../components/home/CtaClose.astro';
import { whiteClientLogos } from '../utils/client-logos.js';

const schemaData = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Mobile One - Producto',
  url: 'https://mobile-one.io/producto',
};

const chapters = [
  { id: 'abrir-turno', num: '01', label: 'Abrir turno', group: 'pos' },
  { id: 'armar-venta', num: '02', label: 'Armar la venta', group: 'pos' },
  { id: 'cerrar-venta', num: '03', label: 'Cerrar la venta', group: 'pos' },
  { id: 'pasillo-infinito', num: '04', label: 'Pasillo infinito', group: 'pos' },
  { id: 'despues-de-vender', num: '05', label: 'Después de vender', group: 'pos' },
  { id: 'recepcion', num: '06', label: 'Recepción', group: 'pos' },
  { id: 'en-la-tienda', num: '07', label: 'En la tienda', group: 'backoffice' },
  { id: 'red-completa', num: '08', label: 'La red completa', group: 'backoffice' },
  { id: 'control-sistema', num: '09', label: 'Control del sistema', group: 'backoffice' },
];
---

<Layout
  title="Producto: POS Mobile y Panel de control | Mobile One"
  description="Conoce Mobile One: POS móvil, caja de pago, medición, facturación electrónica, recepción de mercadería y promociones en una sola plataforma para tu retail."
  image="/images/og-default.jpg"
  schemaData={schemaData}
>
  <ProductoHero
    headline={[
      { text: 'Un' }, { text: 'producto,' }, { text: 'dos' }, { text: 'superficies:', break: true },
      { text: 'el', accent: 'accent' }, { text: 'terminal', accent: 'accent' }, { text: 'de', accent: 'accent' }, { text: 'venta', accent: 'accent' },
      { text: 'y', break: true }, { text: 'el', accent: 'navy' }, { text: 'panel', accent: 'navy' }, { text: 'de', accent: 'navy' }, { text: 'administración', accent: 'navy' },
    ]}
    subheadline="Todo lo que necesitas para operar la venta directamente en tu terminal de cobro, y todo lo que necesitas para controlarla desde un panel web, en un solo sistema."
  />

  <!-- Bloque 1: Problema y dolor -->
  <ProductoProblem
    eyebrow="Lo que pasa hoy"
    title="Tres pérdidas que se repiten cada día en tu tienda"
    items={[
      { label: 'Filas y espera', image: '/images/hook-frustracion.webp', alt: 'Clientes esperando en fila para pagar', question: '¿Cuántos clientes se fueron hoy solo por hacer fila?' },
      { label: 'Falta de recomendación', image: '/images/hook-stock.webp', alt: 'Vendedor sin información de stock para recomendar', question: '¿Cuántas ventas se pierden por falta de una recomendación?' },
      { label: 'Conteo manual', image: '/images/hook-bulto.webp', alt: 'Trabajador contando cajas una por una', question: '¿Cuántas horas se pierden contando cajas, una por una?' },
    ]}
  />

  <!-- Bloque 2: Producto y solución -->
  <ModuleShowcase
    eyebrow="Lo que cambia"
    title="Una plataforma completa, del terminal al panel"
    intro="Del vendedor en sala a la caja de pago y al panel de control, todo sobre una misma plataforma. Elige un módulo y mira cómo funciona."
    modules={showcaseModules}
  />
  <MoreModules />

  <ProductoChapterNav chapters={chapters} />

  <ProductoChapter
    id="abrir-turno"
    variant="pos"
    eyebrow="09:00 · Abres turno"
    num="01"
    title="Abrir turno"
    items={[
      { icon: 'qr', title: 'Acceso rápido por QR', text: 'El vendedor escanea su credencial y el QR de la tienda directamente en el terminal; el sistema valida vigencia y pertenencia antes de dejarlo operar.' },
    ]}
  />

  <ProductoChapter
    id="armar-venta"
    variant="duo"
    eyebrow="11:30 · Llega un cliente"
    num="02"
    title="Armar la venta"
    image="/images/solucion-fila.webp"
    imageAlt="Vendedora cobrando con terminal Mobile One en la sala de venta"
    items={[
      { icon: 'search', title: 'Catálogo con categorías y búsqueda', text: 'Navega el catálogo completo por categoría y subcategoría, o busca un producto directamente por nombre o código, con su detalle, variantes y el pasillo infinito de stock de toda la red al tiro.' },
      { icon: 'cart', title: 'Carrito de venta flexible', text: 'Crear, modificar y eliminar líneas de producto libremente. Cantidad mínima de línea es 1; para retirar un producto se ejecuta la acción explícita de eliminar, evitando errores de digitación.' },
    ]}
  />

  <ProductoChapter
    id="cerrar-venta"
    variant="photo-callout"
    eyebrow="11:34 · Cobras"
    num="03"
    title="Cerrar la venta"
    image="/images/retail-payment-scene-mercadopago.webp"
    imageAlt="Vendedora de retail cobrando a un cliente en una tienda de ropa"
    items={[
      { title: 'Cobro sin fricción', text: 'El monto a pagar aparece automáticamente en la pantalla de cobro. Soporta pagos mixtos: efectivo + tarjeta, o dos tarjetas distintas, con cálculo automático de vuelto.' },
      { icon: 'receipt', title: 'Documentos electrónicos al instante', text: 'Boleta o factura se genera e imprime apenas se aprueba el pago, integrado a tu facturador electrónico.' },
    ]}
  />

  <ProductoPasilloMoment
    id="pasillo-infinito"
    eyebrow="Cuando falta stock"
    title="Con el pasillo infinito, nunca te quedas sin stock"
    text="Si el producto no está en tu tienda, está en otra sucursal, en una bodega o en el centro de distribución. El vendedor lo ve al instante desde el terminal y cierra la venta igual, sin decirle que no al cliente."
    points={[
      { title: 'Venta directa', text: 'El cliente se lleva el producto hoy, desde el stock de la tienda.' },
      { title: 'Retiro en otra tienda', text: 'Lo retira donde le acomode, en la fecha que quede programada.' },
      { title: 'Despacho a domicilio', text: 'Le llega a su casa, aunque un mismo pedido salga desde más de un lugar.' },
    ]}
    image="/images/solucion-stock.webp"
    imageAlt="Vendedor consultando stock de toda la red para despachar un pedido"
  />

  <ProductoFeatureSticky
    id="despues-de-vender"
    num="05"
    eyebrow="Después de la venta"
    title="Después de vender"
    features={[
      { title: 'Búsqueda y postventa', text: 'Buscador de ventas por folio, RUT/cliente o fecha, con reimpresión de documentos y generación de tickets de cambio. También busca clientes existentes para asignarlos directo a la venta.' },
      { title: 'Resumen de ventas del día', text: 'El vendedor consulta el total vendido y el detalle de cada boleta o factura emitida en su turno, sin salir del terminal ni pedirle el reporte a otra persona.' },
    ]}
  />

  <ProductoChapter
    id="recepcion"
    variant="photo-callout"
    eyebrow="16:00 · Llega mercadería"
    num="06"
    title="Recepción de mercadería"
    image="/images/recepcion-camara.webp"
    imageAlt="Trabajadora escaneando el código de barras de un bulto con la cámara del terminal Mobile One mientras revisa el documento de la recepción"
    items={[
      { title: 'Recepción de mercadería', text: 'Ingreso vinculado al documento de transferencia del ERP (almacenes en tránsito), que trae lo que debería venir en el paquete. Cada bulto se escanea con la cámara o el lector infrarrojo del mismo terminal (reconoce EAN-13 y UPC-A automáticamente) para ir cuadrando que llegue lo mismo que dice el documento, y al final se emite el comprobante de recepción.' },
    ]}
  />

  <ProductoBridge text="Del mostrador al panel de control." />

  <ProductoFeatureBento
    id="en-la-tienda"
    eyebrow="Mientras tanto, en la oficina"
    title="Todo lo que pasó en la tienda, en un solo lugar"
    image="/images/solucion-backoffice.webp"
    imageAlt="Encargada de tienda revisando ventas y stock en un panel web desde laptop y tablet"
    features={[
      { title: 'Gestión de ventas', text: 'Consulta de todas las ventas por tienda, estado o folio, con detalle completo: transacción, cliente, ítems, pagos y resumen financiero. Descarga de DTE en PDF.' },
      { title: 'Carros con pago pendiente', text: 'Visibilidad de ventas que quedaron a mitad de camino en el POS, con verificación directa del estado del cobro en Mercado Pago para decidir si se completa o se retira.' },
      { title: 'Trazabilidad y auditoría', text: 'Nada se borra: las transacciones con incidencias se marcan como no visibles pero se conservan para auditoría completa.' },
    ]}
  />

  <ProductoNetworkDiagram
    id="red-completa"
    eyebrow="Todas las tiendas, una sola vista"
    title="La red completa, siempre sincronizada"
    inputs={[
      { label: 'Stock por tienda y almacén', sub: 'Consulta y ajusta el stock de cada producto en cada tienda y almacén, sincronizado con tu ERP.' },
      { label: 'Maestros centralizados', sub: 'Tiendas, artículos, clientes y catálogo sincronizados con tu ERP.' },
    ]}
    hub={{ label: 'Red sincronizada', sub: 'Una sola fuente de verdad' }}
    outputs={[
      { label: 'Entregas y despachos', sub: 'Sigue cada despacho por separado: dirección, número de seguimiento y estado.' },
    ]}
  />

  <!-- Bloque 3: Confianza y métricas -->
  <ProductoBlockHead
    eyebrow="Y todo con respaldo"
    title="Control del sistema y una implementación sin sorpresas"
    text="Usuarios con perfiles, trazabilidad de cada transacción y funcionalidades que se activan por cliente, sobre una plataforma sincronizada con tu ERP."
  />

  <ProductoSystemStat
    id="control-sistema"
    eyebrow="Quién puede qué"
    title="Control del sistema"
    text="Gestión de usuarios (perfiles, credenciales QR, vigencia) y de releases (registro de versiones), con activación/desactivación de funcionalidades por cliente vía feature flags, sin tocar código ni afectar a otros clientes."
    stats={[
      { value: 'Personaliza tu forma de vender', label: 'funcionalidades activables por cliente', isNumeric: false },
      { value: 'Tiempo de implementación', label: 'menos de una semana', isNumeric: false },
    ]}
  />

  <ProductoScaleBand
    stat={1}
    statLabel="Plataforma para toda tu red"
    title="Activa lo que tu operación necesita, en todas tus tiendas a la vez"
    text="Elige qué funcionalidades usar en cada tienda y súmalas cuando las necesites, sin desarrollos a medida. Todo corre sobre una misma plataforma: cada mejora llega a toda tu red al mismo tiempo y tu equipo siempre vende con la última versión."
  />

  <!-- Bloque 4: Cierre -->
  <CtaClose
    title="Quiero ver el producto con mi catálogo"
    body="Agenda una demo de 30 minutos y te mostramos Mobile One funcionando con tu catálogo."
    ctaText="Agendar demo"
    ctaHref="/contacto"
    ctaSecondaryText="Contactar un consultor"
    ctaSecondaryHref="/contacto"
    logosLabel="Súmate a las marcas que ya trabajan con nosotros"
    logos={whiteClientLogos()}
  />
</Layout>

<style is:global>
  /* Rótulos de historia: píldora legible (texto más grande, fondo propio) en lugar de la etiqueta de categoría */
  html .pch__eyebrow.pch__eyebrow, html .pbh__eyebrow.pbh__eyebrow, html .pfs__eyebrow.pfs__eyebrow, html .pnd__eyebrow.pnd__eyebrow, html .pfb__eyebrow.pfb__eyebrow, html .ppr__eyebrow.ppr__eyebrow, html .msh__eyebrow.msh__eyebrow, html .pss__eyebrow.pss__eyebrow, html .ppm__eyebrow.ppm__eyebrow {
    display: inline-flex; align-items: center; gap: .6rem; width: fit-content;
    text-transform: none; letter-spacing: 0; font-weight: 500; font-size: var(--text-base); line-height: 1.2;
    color: var(--accent); background: var(--tint-strong); border: 1px solid color-mix(in srgb, var(--accent) 22%, transparent);
    padding: .5rem 1rem .5rem .8rem; border-radius: var(--radius-full);
  }
  html .pch__eyebrow.pch__eyebrow::before, html .pbh__eyebrow.pbh__eyebrow::before, html .pfs__eyebrow.pfs__eyebrow::before, html .pnd__eyebrow.pnd__eyebrow::before, html .pfb__eyebrow.pfb__eyebrow::before, html .ppr__eyebrow.ppr__eyebrow::before, html .msh__eyebrow.msh__eyebrow::before, html .pss__eyebrow.pss__eyebrow::before, html .ppm__eyebrow.ppm__eyebrow::before {
    content: ''; flex: none; width: 8px; height: 8px; border-radius: 50%; background: var(--grad-brand);
  }
  html .ppm__eyebrow.ppm__eyebrow { color: var(--on-accent); background: color-mix(in srgb, var(--navy) 45%, transparent); border-color: color-mix(in srgb, var(--on-accent) 35%, transparent); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); }
  html .ppm__eyebrow.ppm__eyebrow::before { background: var(--on-accent); }
</style>
