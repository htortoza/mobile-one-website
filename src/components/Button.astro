---
// src/components/Button.astro — ÚNICO botón/CTA del sitio (design system, CLAUDE.md §22).
// Estilos globales en src/styles/components.css (.btn). No crear botones ad-hoc ni
// redefinir .btn en páginas o componentes.
//
// Props:
//   href      → si existe renderiza <a>, si no <button>. El caller pasa la URL ya con withBase().
//   variant   → 'primary' | 'ghost' | 'light' | 'outline-light'   (default 'primary')
//   size      → 'md' | 'sm'                                         (default 'md')
//   block     → ancho completo
//   track     → ubicación para analítica (data-cta), p. ej. 'header', 'hero'
//   external  → abre en pestaña nueva
//   class     → clases extra (layout del contexto, nunca color/tamaño del botón)
//   ...rest   → atributos HTML/data-* adicionales
// Slot: texto e ícono opcional (<svg class="btn__icon">).
const {
  href,
  variant = 'primary',
  size = 'md',
  block = false,
  track,
  external = false,
  class: className,
  ...rest
} = Astro.props;

// compatibilidad con la API anterior ('secondary' era el botón con borde)
const v = variant === 'secondary' ? 'ghost' : variant;
const Tag = href ? 'a' : 'button';
const ext = external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

<Tag
  href={href}
  class:list={['btn', `btn--${v}`, size !== 'md' && `btn--${size}`, block && 'btn--block', className]}
  data-cta={track}
  {...ext}
  {...rest}
>
  <slot />
</Tag>
