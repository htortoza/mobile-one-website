---
// src/components/showcase/MoreModules.astro
// "Y mucho más": los otros módulos más relevantes del panel y del terminal. Va justo después del explorador de módulos
// (Home y /producto) para que no se lea que la plataforma son solo cinco.
import { moreModules } from '../../data/showcase-modules.js';
const { eyebrow = 'Y mucho más', title = 'Más módulos para operar toda la red', intro = 'Lo que usa cada área de tu empresa, sobre la misma plataforma: del terminal al panel de control.' } = Astro.props;
---
<section class="mm" data-mm>
  <div class="container mm__inner">
    <div class="mm__head">
      <p class="mm__eyebrow">{eyebrow}</p>
      <h3 class="mm__title">{title}</h3>
      <p class="mm__intro">{intro}</p>
    </div>
    <ul class="mm__grid" role="list">
      {moreModules.map((m, i) => (
        <li class="mm__card" data-mm-card>
          <span class="mm__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <b>{m.name}</b>
          <span>{m.text}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);
  document.addEventListener('astro:page-load', () => {
    const sec = document.querySelector('[data-mm]');
    if (!sec || sec.dataset.mmInit) return;
    sec.dataset.mmInit = '1';
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    gsap.fromTo(sec.querySelectorAll('[data-mm-card]'), { opacity: 0, y: 26 }, {
      opacity: 1, y: 0, duration: 0.8, ease: 'expo.out', stagger: 0.06, clearProps: 'transform',
      scrollTrigger: { trigger: sec.querySelector('.mm__grid'), start: 'top 88%', once: true },
    });
  });
</script>

<style>
  .mm { background: var(--bg-primary); padding-block: var(--space-xl); }
  .mm__inner { display: grid; gap: var(--space-lg); }
  .mm__head { display: grid; gap: var(--space-xs); max-width: 44rem; }
  .mm__eyebrow { font-size: var(--text-sm); letter-spacing: .12em; text-transform: uppercase; color: var(--accent); font-weight: 500; }
  .mm__title { font-family: var(--font-heading); font-size: clamp(1.9rem, 4vw, 3rem); letter-spacing: -.03em; line-height: 1.06; color: var(--navy); font-weight: 500; }
  .mm__intro { font-size: var(--text-lg); color: var(--text-secondary); line-height: 1.55; }
  .mm__grid { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-sm); grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .mm__card { position: relative; display: grid; gap: .4rem; align-content: start; padding: 1.2rem 1.2rem 1.3rem; border-radius: calc(var(--radius-lg) * 1.2); background: var(--tint); border: 1px solid var(--border); min-width: 0; transition: transform .5s var(--ease-expo), box-shadow .5s var(--ease-expo), background-color .4s; overflow: hidden; }
  .mm__card::before { content: ''; position: absolute; left: 0; top: 0; width: 100%; height: 3px; background: var(--grad-brand); transform: scaleX(0); transform-origin: left; transition: transform .6s var(--ease-expo); }
  .mm__card:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); background: var(--tint-strong); }
  .mm__card:hover::before { transform: scaleX(1); }
  .mm__n { font-size: var(--text-xs); letter-spacing: .12em; color: var(--accent); font-weight: 500; }
  .mm__card b { font-family: var(--font-heading); font-size: var(--text-lg); letter-spacing: -.015em; font-weight: 500; color: var(--navy); line-height: 1.2; }
  .mm__card span:last-child { color: var(--text-secondary); font-size: var(--text-sm); line-height: 1.45; }
  @media (min-width: 900px) { .mm__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
</style>
