---
// src/components/pages/PageHero.astro
// Cabecera común de las páginas interiores: migas, titular (h1), bajada y CTAs.
import Button from '../Button.astro';
import { withBase } from '../../utils/base.js';
const { crumbs = [], title, lead, ctaText, ctaHref, ctaSecondaryText, ctaSecondaryHref, tone = 'light' } = Astro.props;
---
<section class={`phero phero--${tone}`}>
  <div class="container phero__inner">
    {crumbs.length > 0 && (
      <nav class="phero__crumbs" aria-label="Migas de pan">
        <a href={withBase('/')}>Inicio</a>
        {crumbs.map((c) => (<><span aria-hidden="true">/</span>{c.href ? <a href={withBase(c.href)}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</>))}
      </nav>
    )}
    <h1 class="phero__title">{title}</h1>
    {lead && <p class="phero__lead">{lead}</p>}
    {(ctaText || ctaSecondaryText) && (
      <div class="btn-group phero__cta">
        {ctaText && <Button href={withBase(ctaHref)}>{ctaText}</Button>}
        {ctaSecondaryText && <Button href={withBase(ctaSecondaryHref)} variant={tone === 'dark' ? 'outline-light' : 'ghost'}>{ctaSecondaryText}</Button>}
      </div>
    )}
  </div>
</section>
<style>
  .phero { padding-block: var(--space-xl) var(--space-lg); }
  .phero--dark { background: var(--grad-brand); color: var(--on-accent); }
  .phero--light { background: var(--grad-soft); color: var(--navy); }
  .phero__inner { display:grid; gap:var(--space-sm); }
  .phero__inner > * { max-width: 62rem; }
  .phero__crumbs { display:flex; flex-wrap:wrap; gap:.5rem; font-size:var(--text-sm); opacity:.8; }
  .phero__crumbs a { color:inherit; text-decoration:none; }
  .phero__crumbs a:hover { text-decoration:underline; }
  .phero__title { font-family:var(--font-heading); font-size:clamp(2.2rem,5.4vw,4.2rem); letter-spacing:-0.03em; line-height:1.04; font-weight:500; max-width:20ch; }
  .phero__lead { font-size:clamp(1.05rem,1.6vw,1.3rem); line-height:1.55; max-width:56ch; opacity:.88; }
  .phero__cta { margin-top:var(--space-xs); }
</style>
