---
// src/components/pages/CtaBand.astro — cierre con degradado de marca y botón único de demo.
import Button from '../Button.astro';
import { withBase } from '../../utils/base.js';
const { title = '¿Listo para ver Mobile One con tu catálogo?', text = 'Agenda una demo de 30 minutos.', ctaText = 'Agendar demo', ctaHref = '/contacto' } = Astro.props;
---
<section class="cband">
  <div class="container cband__inner">
    <h2 class="cband__title">{title}</h2>
    <p class="cband__text">{text}</p>
    <Button href={withBase(ctaHref)} variant="light">{ctaText}</Button>
  </div>
</section>
<style>
  .cband { background:var(--accent-gradient); color:var(--on-accent); padding-block:var(--space-xl); }
  .cband__inner { display:grid; gap:var(--space-sm); justify-items:start; }
  .cband__title { font-family:var(--font-heading); font-size:clamp(2rem,4.6vw,3.6rem); letter-spacing:-0.03em; line-height:1.06; font-weight:500; max-width:20ch; }
  .cband__text { font-size:var(--text-lg); opacity:.88; }
</style>
