---
// src/components/pages/FaqList.astro
// Preguntas frecuentes (details/summary accesibles). El JSON-LD FAQPage lo arma
// la página con faqSchema() de src/utils/seo.js y lo pasa al Layout (schemaData).
const { items = [] } = Astro.props;
---
<div class="faq">
  {items.map((f) => (
    <details class="faq__item">
      <summary>{f.q}</summary>
      <p>{f.a}</p>
    </details>
  ))}
</div>
<style>
  .faq { display:grid; gap:var(--space-xs); max-width:52rem; }
  .faq__item { background:var(--bg-primary); border:1px solid var(--border); border-radius:var(--radius-lg); padding:1rem 1.25rem; }
  .faq__item summary { cursor:pointer; font-weight:500; color:var(--navy); font-size:var(--text-lg); list-style:none; }
  .faq__item summary::-webkit-details-marker { display:none; }
  .faq__item summary::after { content:'+'; float:right; color:var(--accent); }
  .faq__item[open] summary::after { content:'−'; }
  .faq__item p { margin-top:.6rem; color:var(--text-secondary); line-height:1.6; }
</style>
