---
// src/components/home/ProblemLedger.astro
// Home §4.4 — El problema. Ledger numerado, regla que se dibuja. Formato distinto a 4.3 (galería horizontal).
const { title, items, closing, closingHref } = Astro.props;
const list = items ?? [];
---

<section class="problem" data-gsap-section="problem">
  <div class="container problem__inner">
    <h2 class="problem__title" data-gsap-animate="fade-up">{title}</h2>

    <ol class="ledger">
      {list.map((item, i) => (
        <li class="ledger__row" data-ledger-row>
          <span class="ledger__index">{String(i + 1).padStart(2, '0')}</span>
          <div class="ledger__body">
            <h3 class="ledger__heading">{item.heading}</h3>
            <p class="ledger__text">{item.text}</p>
          </div>
          <span class="ledger__rule" data-ledger-rule></span>
        </li>
      ))}
    </ol>

    {closing && (
      <p class="problem__closing" data-gsap-animate="fade-up">
        {closing} {closingHref && <a href={closingHref}>→</a>}
      </p>
    )}
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initProblem() {
    const section = document.querySelector('[data-gsap-section="problem"]');
    if (!section) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    section.querySelectorAll('[data-ledger-row]').forEach((row) => {
      const rule = row.querySelector('[data-ledger-rule]');
      gsap.from(row, {
        opacity: 0,
        y: 24,
        duration: 0.7,
        ease: 'expo.out',
        scrollTrigger: { trigger: row, start: 'top 82%' },
      });
      if (rule) {
        gsap.fromTo(rule, { scaleX: 0 }, {
          scaleX: 1,
          duration: 0.8,
          ease: 'expo.out',
          scrollTrigger: { trigger: row, start: 'top 78%' },
        });
      }
    });
  }

  document.addEventListener('astro:page-load', initProblem);
</script>

<style>
  .problem { padding-block: var(--space-2xl); background-color: var(--bg-primary); }
  .problem__inner { display: grid; gap: var(--space-lg); }
  .problem__title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 5vw, 3.2rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    max-width: 20ch;
  }

  .ledger { list-style: none; display: grid; }
  .ledger__row {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-md);
    padding-block: var(--space-lg);
    position: relative;
  }
  .ledger__rule {
    position: absolute;
    left: 0; right: 0; top: 0;
    height: 1px;
    background-color: var(--border);
    transform-origin: left;
  }
  .ledger__row:last-child { border-bottom: 1px solid var(--border); }
  .ledger__index {
    font-family: var(--font-heading);
    font-size: clamp(2.4rem, 6vw, 4rem);
    color: var(--navy);
    opacity: 0.18;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .ledger__body { display: grid; gap: var(--space-xs); align-content: center; }
  .ledger__heading {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    color: var(--text-primary);
  }
  .ledger__text { color: var(--text-secondary); max-width: 60ch; line-height: 1.6; }

  .problem__closing {
    font-size: var(--text-lg);
    color: var(--navy);
    font-weight: 500;
  }
  .problem__closing a { color: var(--accent); text-decoration: none; }

  @media (min-width: 768px) {
    .ledger__row { grid-template-columns: 140px 1fr; }
  }
</style>
