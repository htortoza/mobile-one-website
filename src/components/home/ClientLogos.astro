---
// src/components/home/ClientLogos.astro
// Fila de logos + claim de capacidad (no de adopción). PLACEHOLDER: logos ficticios
// (wordmarks genéricos, no marcas reales) — reemplazar por logos reales de clientes
// con autorización antes de publicar. No usar para prometer clientes que no existen.
const { claim, logos } = Astro.props;
const list = logos ?? [];
---

<section class="client-logos" data-gsap-section="client-logos">
  <div class="container">
    <p class="client-logos__claim" data-gsap-animate="fade-up">{claim}</p>
  </div>

  <div class="client-logos__marquee" data-gsap-animate="fade-up-delay" aria-hidden="true">
    <div class="client-logos__track">
      {list.map((name) => (
        <span class="client-logos__logo">{name}</span>
      ))}
      {list.map((name) => (
        <span class="client-logos__logo" data-logo-dupe>{name}</span>
      ))}
    </div>
  </div>
  <p class="sr-only">{list.join(' · ')}</p>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initClientLogos() {
    const section = document.querySelector('[data-gsap-section="client-logos"]');
    if (!section) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const claim = section.querySelector('[data-gsap-animate="fade-up"]');
    const row = section.querySelector('[data-gsap-animate="fade-up-delay"]');

    gsap.from([claim, row], {
      opacity: 0,
      y: 16,
      duration: 0.7,
      stagger: 0.1,
      ease: 'power2.out',
      scrollTrigger: { trigger: section, start: 'top 85%' },
    });
  }

  document.addEventListener('astro:page-load', initClientLogos);
</script>

<style>
  .client-logos {
    padding-block: var(--space-2xl);
    background-color: var(--bg-secondary);
    border-block: 1px solid var(--border);
    display: grid;
    gap: var(--space-lg);
  }
  .client-logos__claim {
    font-size: var(--text-sm);
    letter-spacing: 0.03em;
    color: var(--text-secondary);
    max-width: 46ch;
    margin-inline: auto;
    text-align: center;
  }

  .client-logos__marquee {
    overflow: hidden;
  }
  .client-logos__marquee:hover .client-logos__track { animation-play-state: paused; }
  .client-logos__track {
    display: flex;
    align-items: center;
    gap: var(--space-xl);
    width: max-content;
    animation: client-logos-marquee 28s linear infinite;
  }
  .client-logos__logo {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--text-secondary);
    opacity: 0.5;
    filter: grayscale(1);
    transition: opacity var(--transition-fast), filter var(--transition-fast);
    white-space: nowrap;
  }
  .client-logos__marquee:hover .client-logos__logo { opacity: 1; filter: grayscale(0); color: var(--accent); }

  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  @keyframes client-logos-marquee {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  @media (max-width: 599px) {
    .client-logos__track { gap: var(--space-lg); }
    .client-logos__logo { font-size: var(--text-lg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .client-logos__track { animation: none; flex-wrap: wrap; width: 100%; justify-content: center; }
    .client-logos__logo[data-logo-dupe] { display: none; }
  }
</style>
