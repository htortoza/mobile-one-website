---
// src/components/home/HeroSplit.astro
// Home §4.1 — Split blue(izq)/claro(der). Mockup real de carrito + card BackOffice.
import { withBase } from '../../utils/base.js';
const {
  eyebrow,
  headline,
  accentPhrase,
  breakAfterAccent = false,
  subheadline,
  ctaText,
  ctaHref,
  ctaSecondaryText,
  ctaSecondaryHref,
  logosLabel,
  logos,
} = Astro.props;
const logoList = logos ?? [];

const words = headline ? headline.split(' ') : [];
const normalize = (w) => w.replace(/[.,]/g, '').toLowerCase();

// Ubica la frase a resaltar como subsecuencia contigua de palabras (soporta 1 o varias palabras)
const phraseWords = accentPhrase ? accentPhrase.split(' ').map(normalize) : [];
let accentStart = -1;
if (phraseWords.length) {
  for (let i = 0; i <= words.length - phraseWords.length; i++) {
    if (phraseWords.every((pw, j) => normalize(words[i + j]) === pw)) {
      accentStart = i;
      break;
    }
  }
}
const isAccent = (i) => accentStart >= 0 && i >= accentStart && i < accentStart + phraseWords.length;
---

<!-- Oculta las piezas del hero ANTES del primer paint (el módulo GSAP carga
     después): evita que se vea completo, desaparezca y recién se anime.
     Solo en carga real de documento (no en navegación con ClientRouter, donde
     el módulo ya no se re-ejecuta). Respaldo: se libera a los 3s si el JS falla. -->
<script is:inline>
  if (!window.__heroIntroDone && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.documentElement.classList.add('hero-intro-pending');
    setTimeout(() => document.documentElement.classList.remove('hero-intro-pending'), 3000);
  }
</script>

<section class="hero-split" data-gsap-section="hero-split">
  <div class="hero-split__blue">
    <div class="hero-split__blue-inner">
      {eyebrow && <p class="hero-split__eyebrow" data-gsap-animate="fade-up">{eyebrow}</p>}

      <h1 class="hero-split__headline" data-gsap-split="words">
        {words.map((word, i) => (
          <>
            <span class="hero-split__word-outer">
              <span class={`hero-split__word ${isAccent(i) ? 'hero-split__word--accent' : ''}`}>{word}</span>
            </span>
            {breakAfterAccent && accentStart >= 0 && i === accentStart + phraseWords.length - 1 && (
              <span class="hero-split__break" aria-hidden="true"></span>
            )}
          </>
        ))}
      </h1>

      <p class="hero-split__sub" data-gsap-animate="fade-up">{subheadline}</p>

      <div class="hero-split__cta" data-gsap-animate="fade-up-delay">
        <a href={withBase(ctaHref)} class="hero-split__btn hero-split__btn--primary">{ctaText}</a>
        <a href={withBase(ctaSecondaryHref)} class="hero-split__btn hero-split__btn--ghost">{ctaSecondaryText}</a>
      </div>

      {logoList.length > 0 && (
        <div class="hero-split__logos" data-gsap-animate="fade-up-logos">
          {logosLabel && <p class="hero-split__logos-label">{logosLabel}</p>}
          <div class="hero-split__logos-marquee" aria-hidden="true">
            <div class="hero-split__logos-track">
              {logoList.map((l) => (
                <img src={withBase(l.src)} alt={l.alt} class="hero-split__logo" />
              ))}
              {logoList.map((l) => (
                <img src={withBase(l.src)} alt="" class="hero-split__logo" data-logo-dupe />
              ))}
            </div>
          </div>
          <p class="sr-only">{logoList.map((l) => l.alt).join(' · ')}</p>
        </div>
      )}
    </div>
  </div>

  <div class="hero-split__light">
    <img
      src={withBase('/images/hero-mobile-pos-v2-final.webp')}
      alt="Terminal Mobile One mostrando un carrito de venta con productos, descuento aplicado y botón de cobro"
      class="hero-pos-image"
      data-gsap-animate="mockup"
    />
  </div>
</section>

<script>
  import { gsap } from 'gsap';

  const section = document.querySelector('[data-gsap-section="hero-split"]');
  if (section && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const words = section.querySelectorAll('.hero-split__word');
    const eyebrow = section.querySelector('[data-gsap-animate="fade-up"]');
    const sub = section.querySelectorAll('[data-gsap-animate="fade-up"]')[1];
    const cta = section.querySelector('[data-gsap-animate="fade-up-delay"]');
    const logosRow = section.querySelector('[data-gsap-animate="fade-up-logos"]');
    const mockups = section.querySelector('[data-gsap-animate="mockup"]');

    // Intro pausada y orgánica: power3/power4 reparten el movimiento en toda
    // la duración (expo.out resolvía casi todo en el primer 20% y se sentía
    // de golpe). Solapes amplios para que cada parte entre como una ola.
    // Estado inicial explícito (set + to): con from() en timeline GSAP
    // difería el render inicial y las piezas se veían un instante antes de
    // animarse. Así quedan ocultas desde el primer frame.
    const pieces = [eyebrow, sub, cta, logosRow].filter(Boolean);
    gsap.set(pieces, { opacity: 0, y: 22 });
    gsap.set(words, { opacity: 0, y: 48 });
    if (mockups) gsap.set(mockups, { opacity: 0, scale: 0.96 });
    // Ya ocultas inline — se libera el ocultamiento CSS previo al paint.
    document.documentElement.classList.remove('hero-intro-pending');
    window.__heroIntroDone = true;

    const tl = gsap.timeline({ delay: 0.1, defaults: { ease: 'power3.out', opacity: 1, y: 0 } });
    if (eyebrow) tl.to(eyebrow, { duration: 1.1 });
    tl.to(words, { stagger: 0.09, duration: 1.3, ease: 'power4.out' }, '-=0.6');
    if (sub) tl.to(sub, { duration: 1.2 }, '-=0.8');
    if (cta) tl.to(cta, { duration: 1.1 }, '-=0.85');
    if (logosRow) tl.to(logosRow, { duration: 1.1 }, '-=0.8');
    if (mockups) tl.to(mockups, { scale: 1, duration: 1.4 }, '-=1.0');

    // CTA magnético — desktop (pointer: fine) only
    const primaryBtn = section.querySelector('.hero-split__btn--primary');
    if (primaryBtn && window.matchMedia('(pointer: fine)').matches) {
      const qx = gsap.quickTo(primaryBtn, 'x', { duration: 0.5, ease: 'power3.out' });
      const qy = gsap.quickTo(primaryBtn, 'y', { duration: 0.5, ease: 'power3.out' });
      primaryBtn.addEventListener('mousemove', (e) => {
        const r = primaryBtn.getBoundingClientRect();
        qx((e.clientX - (r.left + r.width / 2)) * 0.3);
        qy((e.clientY - (r.top + r.height / 2)) * 0.3);
      });
      primaryBtn.addEventListener('mouseleave', () => {
        gsap.to(primaryBtn, { x: 0, y: 0, duration: 0.7, ease: 'elastic.out(1, 0.3)' });
      });
    }
  }
</script>

<style>
  .hero-split {
    display: grid;
    grid-template-columns: 1fr;
    min-height: 100vh;
    min-height: 100svh;
  }

  /* ── Panel azul ──
     Fondo full-bleed (llena el 70% del viewport siempre), pero el contenido
     nunca supera ~1444px combinado entre ambos paneles: el padding exterior
     (hacia el borde de la pantalla) crece con max() en pantallas gigantes. */
  .hero-split__blue {
    min-width: 0;
    background: var(--accent-gradient);
    color: var(--on-accent);
    display: flex;
    align-items: center;
    padding-block: var(--space-xl);
    padding-inline-start: max(var(--container-pad), calc((100vw - var(--content-max-xl)) / 2));
    padding-inline-end: var(--space-lg);
  }
  .hero-split__blue-inner {
    min-width: 0;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }
  .hero-split__eyebrow {
    font-family: var(--font-body);
    /* Fluido: se ajusta bajo ~411px de viewport, tope en 0.875rem (--text-sm)
       desde ahí hacia arriba — no un tamaño fijo que se sienta grande en
       phones angostos. */
    font-size: clamp(0.6875rem, 3.4vw, 0.875rem);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--on-accent) 80%, transparent);
  }
  .hero-split__headline {
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.22em;
    row-gap: 0.05em;
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(2.2rem, 5.4vw, 3.8rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
  }
  .hero-split__word-outer { overflow: hidden; padding-bottom: 0.06em; margin-bottom: -0.06em; }
  .hero-split__break { flex-basis: 100%; height: 0; }
  .hero-split__word { display: block; }
  .hero-split__word--accent {
    font-weight: 500;
  }
  .hero-split__sub {
    font-size: var(--text-base);
    line-height: 1.6;
    color: color-mix(in srgb, var(--on-accent) 88%, transparent);
    max-width: 46ch;
  }
  .hero-split__cta { display: flex; flex-wrap: nowrap; gap: var(--space-sm); }

  .hero-split__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 1 auto;
    white-space: nowrap;
    text-align: center;
    font-family: var(--font-body);
    font-weight: 500;
    /* Fluido en vez de un salto brusco a los 560px: nunca envuelve texto
       ("Ver cómo funciona" en una sola línea) y se lee bien desde ~340px. */
    font-size: clamp(0.8125rem, 3.4vw, 1rem);
    padding: var(--space-sm) clamp(0.85rem, 4vw, var(--space-lg));
    border-radius: var(--radius-full);
    text-decoration: none;
    transition: transform var(--transition-fast), background-color var(--transition-fast);
  }
  .hero-split__btn--primary {
    background-color: var(--on-accent);
    color: var(--accent-hover);
  }
  .hero-split__btn--primary:hover { transform: translateY(-2px); }
  .hero-split__btn--ghost {
    color: var(--on-accent);
    border: 1px solid color-mix(in srgb, var(--on-accent) 45%, transparent);
  }
  .hero-split__btn--ghost:hover { background-color: color-mix(in srgb, var(--on-accent) 12%, transparent); }

  /* ── Barra de logos de clientes — pequeña, dentro del panel azul,
     acotada a su ancho (min-width:0 + overflow:hidden) para que el
     marquee nunca invada el panel claro ni el espacio bajo el hero. ── */
  .hero-split__logos { min-width: 0; margin-top: var(--space-xs); }
  .hero-split__logos-label {
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--on-accent) 65%, transparent);
    margin-bottom: var(--space-xs);
  }
  .hero-split__logos-marquee {
    overflow: hidden;
    min-width: 0;
    width: 100%;
    -webkit-mask-image: linear-gradient(90deg, transparent, black 6%, black 94%, transparent);
    mask-image: linear-gradient(90deg, transparent, black 6%, black 94%, transparent);
  }
  .hero-split__logos-marquee:hover .hero-split__logos-track { animation-play-state: paused; }
  .hero-split__logos-track {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    width: max-content;
    animation: hero-split-logos-marquee 26s linear infinite;
  }
  .hero-split__logo {
    height: 18px;
    width: auto;
    opacity: 0.7;
    transition: opacity var(--transition-fast);
  }
  .hero-split__logos-marquee:hover .hero-split__logo { opacity: 1; }

  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  @keyframes hero-split-logos-marquee {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-split__logos-track { animation: none; flex-wrap: wrap; width: 100%; }
    .hero-split__logo[data-logo-dupe] { display: none; }
  }

  :global(html.hero-intro-pending) .hero-split [data-gsap-animate],
  :global(html.hero-intro-pending) .hero-split__word { opacity: 0; }

  /* ── Panel claro / mockups ── */
  .hero-split__light {
    position: relative;
    min-width: 0;
    background-color: var(--bg-secondary);
    display: flex;
    align-items: center;
    justify-content: center;
    padding-block: var(--space-lg);
    padding-inline-start: var(--space-lg);
    padding-inline-end: max(var(--container-pad), calc((100vw - var(--content-max-xl)) / 2));
  }
  /* Grid en su propia capa para poder degradarla hacia los bordes sin afectar el contenido encima */
  .hero-split__light::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(color-mix(in srgb, var(--navy) 8%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--navy) 8%, transparent) 1px, transparent 1px);
    background-size: 32px 32px;
    -webkit-mask-image: radial-gradient(circle at 60% 50%, black 0%, black 30%, transparent 72%);
    mask-image: radial-gradient(circle at 60% 50%, black 0%, black 30%, transparent 72%);
  }
  /* Imagen real del producto (hero-mobile-pos-v2-final). Mobile: contenida en su
     propio flujo. Desktop: se agranda y sube/cruza hacia el panel azul (bleed). */
  .hero-pos-image {
    position: relative;
    display: block;
    width: 85%;
    max-width: 420px;
    margin-inline: auto;
    filter: drop-shadow(0 24px 40px rgba(0, 0, 0, 0.2));
  }

  /* ── Mobile: todo el primer bloque (eyebrow, título, bajada, botones y
     logos) debe caber en el primer vistazo, sin forzar 100vh de alto ni
     el padding/gaps pensados para desktop (--space-xl=8rem, --space-lg
     entre logos). ── */
  @media (max-width: 1023px) {
    .hero-split { min-height: auto; }
    .hero-split__blue { padding-block: 2.75rem var(--space-md); }
    .hero-split__blue-inner { gap: var(--space-sm); }
    .hero-split__cta { margin-top: var(--space-xs); }
    .hero-split__logos { margin-top: var(--space-xs); }
    .hero-split__logos-track { gap: var(--space-md); }
    .hero-split__logo { height: 15px; }
    /* Sin el bleed de desktop, el POS queda flotando solo bajo el panel azul
       sin aportar: se oculta el panel completo (imagen + grid). */
    .hero-split__light { display: none; }
  }

  @media (min-width: 1024px) {
    .hero-split { grid-template-columns: 60% 40%; }

    .hero-pos-image {
      /* Sigue en flujo normal — el flex del panel (align-items:center) lo centra
         verticalmente solo, sin pelear con el transform que usa GSAP para animarlo. */
      z-index: 1;
      width: 120%;
      max-width: 640px;
      margin-left: -34%;
      margin-right: 0;
    }
  }

</style>
