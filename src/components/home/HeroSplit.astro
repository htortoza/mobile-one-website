---
// src/components/home/HeroSplit.astro
// Home §4.1 — Split blue(izq)/claro(der). Mockup real de carrito + card BackOffice.
const {
  eyebrow,
  headline,
  accentPhrase,
  subheadline,
  ctaText,
  ctaHref,
  ctaSecondaryText,
  ctaSecondaryHref,
} = Astro.props;

const words = headline ? headline.split(' ') : [];
const normalize = (w) => w.replace(/[.,]/g, '').toLowerCase();

// Ubica la frase a resaltar como subsecuencia contigua de palabras (soporta 1 o varias palabras)
const phraseWords = accentPhrase ? accentPhrase.split(' ').map(normalize) : [];
let accentStart = -1;
if (phraseWords.length) {
  for (let i = 0; i <= words.length - phraseWords.length; i++) {
    if (phraseWords.every((pw, j) => normalize(words[i + j]) === pw)) {
      accentStart = i;
      break;
    }
  }
}
const isAccent = (i) => accentStart >= 0 && i >= accentStart && i < accentStart + phraseWords.length;
---

<section class="hero-split" data-gsap-section="hero-split">
  <div class="hero-split__blue">
    <div class="hero-split__blue-inner">
      {eyebrow && <p class="hero-split__eyebrow" data-gsap-animate="fade-up">{eyebrow}</p>}

      <h1 class="hero-split__headline" data-gsap-split="words">
        {words.map((word, i) => (
          <span class="hero-split__word-outer">
            <span class={`hero-split__word ${isAccent(i) ? 'hero-split__word--accent' : ''}`}>{word}</span>
          </span>
        ))}
      </h1>

      <p class="hero-split__sub" data-gsap-animate="fade-up">{subheadline}</p>

      <div class="hero-split__cta" data-gsap-animate="fade-up-delay">
        <a href={ctaHref} class="hero-split__btn hero-split__btn--primary">{ctaText}</a>
        <a href={ctaSecondaryHref} class="hero-split__btn hero-split__btn--ghost">{ctaSecondaryText}</a>
      </div>
    </div>
  </div>

  <div class="hero-split__light">
    <img
      src="/images/hero-mobile-pos-v2-final.png"
      alt="Terminal Mobile One mostrando un carrito de venta con productos, descuento aplicado y botón de cobro"
      class="hero-pos-image"
      data-gsap-animate="mockup"
    />
  </div>
</section>

<script>
  import { gsap } from 'gsap';

  const section = document.querySelector('[data-gsap-section="hero-split"]');
  if (section && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const words = section.querySelectorAll('.hero-split__word');
    const eyebrow = section.querySelector('[data-gsap-animate="fade-up"]');
    const sub = section.querySelectorAll('[data-gsap-animate="fade-up"]')[1];
    const cta = section.querySelector('[data-gsap-animate="fade-up-delay"]');
    const mockups = section.querySelector('[data-gsap-animate="mockup"]');

    const tl = gsap.timeline({ defaults: { ease: 'expo.out' } });
    if (eyebrow) tl.from(eyebrow, { y: 16, opacity: 0, duration: 0.7 });
    tl.from(words, { y: 40, opacity: 0, stagger: 0.05, duration: 0.9 }, '-=0.3');
    if (sub) tl.from(sub, { y: 20, opacity: 0, duration: 0.8 }, '-=0.4');
    if (cta) tl.from(cta, { y: 20, opacity: 0, duration: 0.7 }, '-=0.5');
    if (mockups) tl.from(mockups, { opacity: 0, scale: 0.96, duration: 0.9 }, '-=0.6');

    // CTA magnético — desktop (pointer: fine) only
    const primaryBtn = section.querySelector('.hero-split__btn--primary');
    if (primaryBtn && window.matchMedia('(pointer: fine)').matches) {
      const qx = gsap.quickTo(primaryBtn, 'x', { duration: 0.5, ease: 'power3.out' });
      const qy = gsap.quickTo(primaryBtn, 'y', { duration: 0.5, ease: 'power3.out' });
      primaryBtn.addEventListener('mousemove', (e) => {
        const r = primaryBtn.getBoundingClientRect();
        qx((e.clientX - (r.left + r.width / 2)) * 0.3);
        qy((e.clientY - (r.top + r.height / 2)) * 0.3);
      });
      primaryBtn.addEventListener('mouseleave', () => {
        gsap.to(primaryBtn, { x: 0, y: 0, duration: 0.7, ease: 'elastic.out(1, 0.3)' });
      });
    }
  }
</script>

<style>
  .hero-split {
    display: grid;
    grid-template-columns: 1fr;
    min-height: 100vh;
    min-height: 100svh;
  }

  /* ── Panel azul ──
     Fondo full-bleed (llena el 70% del viewport siempre), pero el contenido
     nunca supera ~1444px combinado entre ambos paneles: el padding exterior
     (hacia el borde de la pantalla) crece con max() en pantallas gigantes. */
  .hero-split__blue {
    min-width: 0;
    background: var(--accent-gradient);
    color: var(--on-accent);
    display: flex;
    align-items: center;
    padding-block: var(--space-xl) var(--space-lg);
    padding-inline-start: max(var(--container-pad), calc((100vw - var(--content-max-xl)) / 2));
    padding-inline-end: var(--space-lg);
  }
  .hero-split__blue-inner {
    min-width: 0;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }
  .hero-split__eyebrow {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--on-accent) 80%, transparent);
  }
  .hero-split__headline {
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.22em;
    row-gap: 0.05em;
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(2.2rem, 5.4vw, 3.8rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
  }
  .hero-split__word-outer { overflow: hidden; padding-bottom: 0.06em; margin-bottom: -0.06em; }
  .hero-split__word { display: block; }
  .hero-split__word--accent {
    font-weight: 500;
  }
  .hero-split__sub {
    font-size: var(--text-lg);
    line-height: 1.6;
    color: color-mix(in srgb, var(--on-accent) 88%, transparent);
    max-width: 46ch;
  }
  .hero-split__cta { display: flex; flex-wrap: nowrap; gap: var(--space-sm); }

  .hero-split__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 1 1 0;
    min-width: 0;
    white-space: normal;
    text-align: center;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: var(--text-sm);
    padding: var(--space-sm) var(--space-sm);
    border-radius: var(--radius-full);
    text-decoration: none;
    transition: transform var(--transition-fast), background-color var(--transition-fast);
  }
  @media (min-width: 560px) {
    .hero-split__btn {
      flex: 0 0 auto;
      white-space: nowrap;
      font-size: var(--text-base);
      padding: var(--space-sm) var(--space-lg);
    }
  }
  .hero-split__btn--primary {
    background-color: var(--on-accent);
    color: var(--accent-hover);
  }
  .hero-split__btn--primary:hover { transform: translateY(-2px); }
  .hero-split__btn--ghost {
    color: var(--on-accent);
    border: 1px solid color-mix(in srgb, var(--on-accent) 45%, transparent);
  }
  .hero-split__btn--ghost:hover { background-color: color-mix(in srgb, var(--on-accent) 12%, transparent); }

  /* ── Panel claro / mockups ── */
  .hero-split__light {
    position: relative;
    min-width: 0;
    background-color: var(--bg-secondary);
    display: flex;
    align-items: center;
    justify-content: center;
    padding-block: var(--space-lg);
    padding-inline-start: var(--space-lg);
    padding-inline-end: max(var(--container-pad), calc((100vw - var(--content-max-xl)) / 2));
  }
  /* Grid en su propia capa para poder degradarla hacia los bordes sin afectar el contenido encima */
  .hero-split__light::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(color-mix(in srgb, var(--navy) 8%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--navy) 8%, transparent) 1px, transparent 1px);
    background-size: 32px 32px;
    -webkit-mask-image: radial-gradient(circle at 60% 50%, black 0%, black 30%, transparent 72%);
    mask-image: radial-gradient(circle at 60% 50%, black 0%, black 30%, transparent 72%);
  }
  /* Imagen real del producto (hero-mobile-pos-v2-final). Mobile: contenida en su
     propio flujo. Desktop: se agranda y sube/cruza hacia el panel azul (bleed). */
  .hero-pos-image {
    position: relative;
    display: block;
    width: 85%;
    max-width: 420px;
    margin-inline: auto;
    filter: drop-shadow(0 24px 40px rgba(0, 0, 0, 0.2));
  }

  @media (min-width: 1024px) {
    .hero-split { grid-template-columns: 60% 40%; }

    .hero-pos-image {
      position: absolute;
      z-index: 1;
      top: -8%;
      left: -22%;
      width: 80%;
      max-width: 640px;
      margin: 0;
    }
  }

</style>
