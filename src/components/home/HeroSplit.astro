---
// src/components/home/HeroSplit.astro
// Home §4.1 — Split blue(izq)/claro(der). Mockup real de carrito + card BackOffice.
const {
  eyebrow,
  headline,
  subheadline,
  ctaText,
  ctaHref,
  ctaSecondaryText,
  ctaSecondaryHref,
} = Astro.props;

const words = headline ? headline.split(' ') : [];
---

<section class="hero-split" data-gsap-section="hero-split">
  <div class="hero-split__blue bg-pattern-m">
    <div class="hero-split__blue-inner">
      {eyebrow && <p class="hero-split__eyebrow" data-gsap-animate="fade-up">{eyebrow}</p>}

      <h1 class="hero-split__headline" data-gsap-split="words">
        {words.map((word) => (
          <span class="hero-split__word-outer">
            <span class="hero-split__word">{word}</span>
          </span>
        ))}
      </h1>

      <p class="hero-split__sub" data-gsap-animate="fade-up">{subheadline}</p>

      <div class="hero-split__cta" data-gsap-animate="fade-up-delay">
        <a href={ctaHref} class="hero-split__btn hero-split__btn--primary">{ctaText}</a>
        <a href={ctaSecondaryHref} class="hero-split__btn hero-split__btn--ghost">{ctaSecondaryText}</a>
      </div>
    </div>
  </div>

  <div class="hero-split__light">
    <div class="hero-split__mockups" data-gsap-animate="mockup">
      <div class="mock-backoffice" aria-hidden="true">
        <div class="mock-backoffice__dot"></div>
        <div class="mock-backoffice__line mock-backoffice__line--lg"></div>
        <div class="mock-backoffice__line"></div>
        <div class="mock-backoffice__line"></div>
        <div class="mock-backoffice__chip">Stock multitienda en tiempo real</div>
      </div>

      <div class="mock-cart" aria-hidden="true">
        <div class="mock-cart__header">
          <span class="mock-cart__folio">186 · Boleta</span>
          <span class="mock-cart__badge">● en línea</span>
        </div>
        <div class="mock-cart__item">
          <span class="mock-cart__item-name">Chaqueta Cortavientos</span>
          <span class="mock-cart__item-price">$19.990</span>
        </div>
        <div class="mock-cart__item">
          <span class="mock-cart__item-name">Gorro trucker</span>
          <span class="mock-cart__item-price">$8.990</span>
        </div>
        <div class="mock-cart__total">
          <span>Total</span>
          <span>$28.980</span>
        </div>
        <div class="mock-cart__pay">Confirmar cobro</div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';

  const section = document.querySelector('[data-gsap-section="hero-split"]');
  if (section && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const words = section.querySelectorAll('.hero-split__word');
    const eyebrow = section.querySelector('[data-gsap-animate="fade-up"]');
    const sub = section.querySelectorAll('[data-gsap-animate="fade-up"]')[1];
    const cta = section.querySelector('[data-gsap-animate="fade-up-delay"]');
    const mockups = section.querySelector('[data-gsap-animate="mockup"]');

    const tl = gsap.timeline({ defaults: { ease: 'expo.out' } });
    if (eyebrow) tl.from(eyebrow, { y: 16, opacity: 0, duration: 0.7 });
    tl.from(words, { y: 40, opacity: 0, stagger: 0.05, duration: 0.9 }, '-=0.3');
    if (sub) tl.from(sub, { y: 20, opacity: 0, duration: 0.8 }, '-=0.4');
    if (cta) tl.from(cta, { y: 20, opacity: 0, duration: 0.7 }, '-=0.5');
    if (mockups) tl.from(mockups, { opacity: 0, scale: 0.96, duration: 0.9 }, '-=0.6');

    // CTA magnético — desktop (pointer: fine) only
    const primaryBtn = section.querySelector('.hero-split__btn--primary');
    if (primaryBtn && window.matchMedia('(pointer: fine)').matches) {
      const qx = gsap.quickTo(primaryBtn, 'x', { duration: 0.5, ease: 'power3.out' });
      const qy = gsap.quickTo(primaryBtn, 'y', { duration: 0.5, ease: 'power3.out' });
      primaryBtn.addEventListener('mousemove', (e) => {
        const r = primaryBtn.getBoundingClientRect();
        qx((e.clientX - (r.left + r.width / 2)) * 0.3);
        qy((e.clientY - (r.top + r.height / 2)) * 0.3);
      });
      primaryBtn.addEventListener('mouseleave', () => {
        gsap.to(primaryBtn, { x: 0, y: 0, duration: 0.7, ease: 'elastic.out(1, 0.3)' });
      });
    }
  }
</script>

<style>
  .hero-split {
    display: grid;
    grid-template-columns: 1fr;
    min-height: 100vh;
    min-height: 100svh;
  }

  /* ── Panel azul ── */
  .hero-split__blue {
    color: var(--on-accent);
    display: flex;
    align-items: center;
    padding-block: var(--space-xl) var(--space-lg);
  }
  .hero-split__blue-inner {
    width: 100%;
    max-width: 560px;
    margin-inline: auto;
    padding-inline: var(--container-pad);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }
  .hero-split__eyebrow {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--on-accent) 80%, transparent);
  }
  .hero-split__headline {
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.22em;
    row-gap: 0.05em;
    font-family: var(--font-heading);
    font-size: clamp(2.2rem, 6vw, 3.6rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
  }
  .hero-split__word-outer { overflow: hidden; padding-bottom: 0.06em; margin-bottom: -0.06em; }
  .hero-split__word { display: block; }
  .hero-split__sub {
    font-size: var(--text-lg);
    line-height: 1.6;
    color: color-mix(in srgb, var(--on-accent) 88%, transparent);
    max-width: 46ch;
  }
  .hero-split__cta { display: flex; flex-wrap: wrap; gap: var(--space-sm); }

  .hero-split__btn {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--text-base);
    padding: var(--space-sm) var(--space-lg);
    border-radius: var(--radius-full);
    text-decoration: none;
    transition: transform var(--transition-fast), background-color var(--transition-fast);
  }
  .hero-split__btn--primary {
    background-color: var(--on-accent);
    color: var(--accent-hover);
  }
  .hero-split__btn--primary:hover { transform: translateY(-2px); }
  .hero-split__btn--ghost {
    color: var(--on-accent);
    border: 1px solid color-mix(in srgb, var(--on-accent) 45%, transparent);
  }
  .hero-split__btn--ghost:hover { background-color: color-mix(in srgb, var(--on-accent) 12%, transparent); }

  /* ── Panel claro / mockups ── */
  .hero-split__light {
    background-color: var(--bg-secondary);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-lg) var(--container-pad);
  }
  .hero-split__mockups {
    position: relative;
    width: 100%;
    max-width: 380px;
  }

  .mock-backoffice {
    position: absolute;
    top: -10%;
    right: -8%;
    width: 78%;
    background-color: var(--bg-primary);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    padding: var(--space-md);
    display: grid;
    gap: var(--space-xs);
    transform: rotate(3deg);
  }
  .mock-backoffice__dot {
    width: 10px; height: 10px;
    border-radius: var(--radius-full);
    background-color: var(--accent);
    margin-bottom: var(--space-xs);
  }
  .mock-backoffice__line { height: 8px; border-radius: var(--radius-sm); background-color: var(--border); }
  .mock-backoffice__line--lg { width: 70%; height: 12px; background-color: var(--navy); opacity: 0.15; }
  .mock-backoffice__chip {
    margin-top: var(--space-xs);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--accent-hover);
    background-color: color-mix(in srgb, var(--accent) 10%, transparent);
    padding: 6px 10px;
    border-radius: var(--radius-full);
    width: fit-content;
  }

  .mock-cart {
    position: relative;
    background-color: var(--bg-primary);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    padding: var(--space-md);
    display: grid;
    gap: var(--space-sm);
    margin-top: 22%;
  }
  .mock-cart__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: var(--text-xs);
    color: var(--text-secondary);
  }
  .mock-cart__badge { color: var(--accent-hover); font-weight: 500; }
  .mock-cart__item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: var(--text-sm);
    padding-block: var(--space-xs);
    border-bottom: 1px solid var(--border);
  }
  .mock-cart__item-price { font-variant-numeric: tabular-nums; color: var(--text-secondary); }
  .mock-cart__total {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-weight: 500;
    font-size: var(--text-lg);
    color: var(--text-primary);
    font-variant-numeric: tabular-nums;
  }
  .mock-cart__pay {
    text-align: center;
    font-weight: 600;
    font-size: var(--text-sm);
    color: var(--on-accent);
    background: var(--accent-gradient);
    padding: var(--space-sm);
    border-radius: var(--radius-md);
  }

  @media (min-width: 1024px) {
    .hero-split { grid-template-columns: 1fr 1fr; }
    .hero-split__blue-inner { margin-inline: 0; margin-inline-start: auto; }
  }

  @media (max-width: 640px) {
    .mock-backoffice { display: none; }
    .mock-cart { margin-top: 0; }
  }
</style>
