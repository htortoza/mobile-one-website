---
// src/components/home/BrandCompat.astro
// Home §4.3 (rediseñado) — Compatibilidad de hardware. Reemplaza el scroll-horizontal de 9 escenas.
// Stage inset (no full-bleed): 1 foto real + bloque de color que invierten de lado y
// mutan de tono entre 3 capítulos (Transbank → Getnet → Mercado Pago), pin+scrub corto.
const { title, eyebrow } = Astro.props;

const chapters = [
  {
    brand: 'Transbank',
    kicker: 'Disponible en',
    claim: 'El terminal que ya tienes, listo para vender más.',
    tone: 'var(--tone-transbank)',
    onDark: true,
  },
  {
    brand: 'Getnet',
    kicker: 'También en',
    claim: 'Sin cambiar de hardware, sin curva de aprendizaje.',
    tone: 'var(--tone-getnet)',
    onDark: false,
  },
  {
    brand: 'Mercado Pago',
    kicker: 'Y en',
    claim: 'Un solo Mobile One que habla el idioma de cada terminal.',
    tone: 'var(--tone-mercadopago)',
    onDark: false,
  },
];
---

<section class="compat" id="compatibilidad" data-gsap-section="compat">
  <div class="container compat__head">
    {eyebrow && <p class="compat__eyebrow" data-gsap-animate="fade-up">{eyebrow}</p>}
    <h2 class="compat__title" data-gsap-animate="fade-up">{title}</h2>
  </div>

  <div class="container compat__stage-wrap">
    <div class="compat__stage" data-compat-stage>
      <div class="compat__slot compat__slot--image" data-slot-image>
        <img
          src="/images/retail-payment-scene.webp"
          alt="Vendedora de retail cobrando a una clienta con el terminal de pago, usando Mobile One"
          data-compat-image
        />
      </div>

      <div class="compat__slot compat__slot--color" data-slot-color>
        {chapters.map((ch, i) => (
          <div
            class={`compat__text ${ch.onDark ? 'compat__text--on-dark' : ''}`}
            data-compat-text={i}
            style={i > 0 ? 'opacity:0' : ''}
          >
            <p class="compat__kicker">{ch.kicker}</p>
            <h3 class="compat__brand">{ch.brand}</h3>
            <p class="compat__claim">{ch.claim}</p>
          </div>
        ))}
      </div>
    </div>
  </div>

  <div class="container compat__foot">
    <a href="/integraciones" class="compat__link">Ver todas las integraciones →</a>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);
  ScrollTrigger.config({ ignoreMobileResize: true });

  // Deben coincidir con --tone-* en theme.css (GSAP necesita un valor concreto para interpolar color)
  const TONES = ['#0022aa', '#e8531f', '#ffcc00'];
  // Misma estructura de funciones en los 3 — así GSAP puede tweenear el filter suavemente
  const GRADES = [
    'saturate(1.05) sepia(0) hue-rotate(0deg) brightness(1)',
    'saturate(1.3) sepia(0.4) hue-rotate(300deg) brightness(1.05)',
    'saturate(1.3) sepia(0.4) hue-rotate(28deg) brightness(1.08)',
  ];

  function initCompat() {
    const section = document.querySelector('[data-gsap-section="compat"]');
    if (!section) return;

    const stageWrap = section.querySelector('.compat__stage-wrap');
    const image = section.querySelector('[data-compat-image]');
    const colorSlot = section.querySelector('[data-slot-color]');
    const imageSlot = section.querySelector('[data-slot-image]');
    const texts = section.querySelectorAll('[data-compat-text]');
    if (!stageWrap || !image || !colorSlot || !imageSlot) return;

    gsap.set(image, { filter: GRADES[0] });
    gsap.set(colorSlot, { backgroundColor: TONES[0] });

    const mm = gsap.matchMedia();

    mm.add('(min-width: 900px) and (prefers-reduced-motion: no-preference)', () => {
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: section,
          start: 'top top',
          end: '+=220%',
          scrub: 1,
          pin: stageWrap,
          anticipatePin: 1,
          invalidateOnRefresh: true,
        },
      });

      function transition(toIndex, swap) {
        const seg = gsap.timeline();
        seg.to(texts[toIndex - 1], { opacity: 0, y: -10, duration: 0.18, ease: 'power1.in' }, 0);
        seg.to(imageSlot, { xPercent: swap ? 100 : 0, duration: 0.4, ease: 'power2.inOut' }, 0.05);
        seg.to(colorSlot, { xPercent: swap ? -100 : 0, duration: 0.4, ease: 'power2.inOut' }, 0.05);
        seg.to(colorSlot, { backgroundColor: TONES[toIndex], duration: 0.4, ease: 'power1.inOut' }, 0.08);
        seg.to(image, { filter: GRADES[toIndex], duration: 0.4, ease: 'power1.inOut' }, 0.08);
        seg.to(texts[toIndex], { opacity: 1, y: 0, duration: 0.22, ease: 'power2.out' }, 0.32);
        return seg;
      }

      tl.to({}, { duration: 0.6 }); // hold capítulo 1
      tl.add(transition(1, true), '+=0');
      tl.to({}, { duration: 0.6 }); // hold capítulo 2
      tl.add(transition(2, false), '+=0');
      tl.to({}, { duration: 0.6 }); // hold capítulo 3
    });
  }

  document.addEventListener('astro:page-load', initCompat);
</script>

<style>
  .compat {
    padding-block: var(--space-2xl);
    background-color: var(--bg-primary);
  }

  .compat__head { display: grid; gap: var(--space-sm); margin-bottom: var(--space-lg); }
  .compat__eyebrow {
    font-size: var(--text-sm);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-secondary);
  }
  .compat__title {
    font-family: var(--font-heading);
    font-size: clamp(1.8rem, 4.5vw, 2.8rem);
    letter-spacing: -0.02em;
    max-width: 30ch;
  }

  .compat__stage-wrap { display: flex; justify-content: center; }
  .compat__stage {
    position: relative;
    width: 100%;
    max-width: 1180px;
    aspect-ratio: 16 / 9;
    border-radius: 32px;
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    background-color: var(--bg-secondary);
  }

  .compat__slot {
    position: absolute;
    top: 0;
    width: 50%;
    height: 100%;
  }
  .compat__slot--image { left: 0; overflow: hidden; }
  .compat__slot--image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .compat__slot--color {
    left: 50%;
    display: flex;
    align-items: center;
    padding: var(--space-lg);
  }

  .compat__text { position: absolute; inset: var(--space-lg); display: grid; align-content: center; gap: var(--space-xs); }
  .compat__kicker { font-size: var(--text-sm); color: color-mix(in srgb, var(--navy) 70%, transparent); }
  .compat__brand {
    font-family: var(--font-heading);
    font-size: clamp(1.8rem, 3.4vw, 2.6rem);
    color: var(--navy);
    letter-spacing: -0.01em;
  }
  .compat__claim { color: color-mix(in srgb, var(--navy) 75%, transparent); max-width: 26ch; line-height: 1.5; }

  /* Capítulo con fondo oscuro (Transbank) — invierte a texto claro para contraste */
  .compat__text--on-dark .compat__kicker { color: color-mix(in srgb, var(--on-accent) 75%, transparent); }
  .compat__text--on-dark .compat__brand { color: var(--on-accent); }
  .compat__text--on-dark .compat__claim { color: color-mix(in srgb, var(--on-accent) 88%, transparent); }

  .compat__foot { margin-top: var(--space-md); text-align: center; }
  .compat__link { color: var(--accent); font-weight: 600; text-decoration: none; }

  /* ── Mobile / reduced-motion: 3 tarjetas apiladas, sin pin ni wipe ── */
  @media (max-width: 899px), (prefers-reduced-motion: reduce) {
    .compat__stage-wrap { display: block; }
    .compat__stage {
      display: grid;
      gap: var(--space-md);
      aspect-ratio: auto;
      height: auto;
      border-radius: 0;
      overflow: visible;
      box-shadow: none;
      background: none;
    }
    .compat__slot {
      position: relative;
      width: 100%;
      height: auto;
      left: auto !important;
      transform: none !important;
    }
    .compat__slot--image {
      border-radius: var(--radius-lg);
      overflow: hidden;
      aspect-ratio: 4 / 3;
    }
    .compat__slot--color {
      border-radius: var(--radius-lg);
      padding: var(--space-lg);
      display: grid;
      gap: var(--space-md);
      background-color: transparent !important;
    }
    .compat__text {
      position: relative;
      inset: auto;
      opacity: 1 !important;
      padding: var(--space-lg);
      border-radius: var(--radius-lg);
    }
    .compat__text[data-compat-text='0'] { background-color: var(--tone-transbank); }
    .compat__text[data-compat-text='1'] { background-color: var(--tone-getnet); }
    .compat__text[data-compat-text='2'] { background-color: var(--tone-mercadopago); }
    .compat__kicker, .compat__brand, .compat__claim { color: var(--navy); }
    .compat__text--on-dark .compat__kicker,
    .compat__text--on-dark .compat__brand,
    .compat__text--on-dark .compat__claim { color: var(--on-accent); }
  }
</style>
