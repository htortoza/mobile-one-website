---
// src/components/home/BrandCompat.astro
// Home §4.3 (rediseñado) — Compatibilidad de hardware. Reemplaza el scroll-horizontal de 9 escenas.
// Layout fijo: foto a la izquierda, bloque de color+texto a la derecha (no invierten de lado).
// Fondo (foto + color) hace crossfade entre 3 capítulos — Transbank (azul) → Getnet (naranja) →
// Mercado Pago (amarillo).
const { title, eyebrow } = Astro.props;

const chapters = [
  {
    brand: 'Transbank',
    kicker: 'Compatibilidad con',
    logo: '/images/logo-transbank-white.png',
    claim: 'Mobile One corre directo en tu terminal Transbank — el mismo con el que ya cobras.',
    detail: 'Catálogo, cobro con pago mixto y boleta o factura electrónica, todo en un solo dispositivo, sin hardware adicional.',
    image: '/images/retail-payment-scene-transbank.webp',
    alt: 'Vendedora de retail cobrando a una clienta en un local de ropa',
    tone: 'var(--tone-transbank)',
    onDark: true,
  },
  {
    brand: 'Getnet',
    kicker: 'Compatibilidad con',
    logo: '/images/logo-getnet-white.png',
    claim: 'Activa Mobile One sobre tu terminal Getnet sin cambiar de hardware.',
    detail: 'Mismo flujo de venta, mismo dispositivo, sin curva de aprendizaje para tu equipo y con el stock de toda la red disponible al instante.',
    image: '/images/retail-payment-scene-getnet.webp',
    alt: 'Vendedora de retail cobrando a una clienta en una tienda de barrio',
    tone: 'var(--tone-getnet)',
    onDark: true,
  },
  {
    brand: 'Mercado Pago',
    kicker: 'Compatibilidad con',
    logo: '/images/logo-mercadopago-color.svg',
    logoHeight: '58px',
    claim: 'En tu terminal Mercado Pago, Mobile One cobra y emite el documento tributario al instante.',
    detail: 'El stock se sincroniza con tu ERP igual que en el resto de tus tiendas — un solo sistema para toda la red.',
    image: '/images/retail-payment-scene-mercadopago.webp',
    alt: 'Vendedora de retail cobrando a un cliente en una tienda de ropa',
    tone: 'var(--tone-mercadopago)',
    onDark: false,
  },
];
---

<section class="compat" id="compatibilidad" data-gsap-section="compat">
  <div class="container compat__head">
    {eyebrow && <p class="compat__eyebrow" data-gsap-animate="fade-up">{eyebrow}</p>}
    <h2 class="compat__title" data-gsap-animate="fade-up">{title}</h2>
  </div>

  <div class="compat__pin compat__desktop-only" data-compat-pin>
    <div class="container compat__stage-wrap">
      <div class="compat__stage" data-compat-stage>
        <div class="compat__half compat__half--image" data-image-half>
          {chapters.map((ch, i) => (
            <img class="compat__bg" data-compat-image={i} style={i > 0 ? 'opacity:0' : ''} src={ch.image} alt={ch.alt} />
          ))}
        </div>

        <div class="compat__half compat__half--color" data-color-half>
          {chapters.map((ch, i) => (
            <div
              class={`compat__text ${ch.onDark ? 'compat__text--on-dark' : ''}`}
              data-compat-text={i}
              style={i > 0 ? 'opacity:0' : ''}
            >
              <p class="compat__kicker">{ch.kicker}</p>
              <img class="compat__brand-logo" src={ch.logo} alt={ch.brand} style={ch.logoHeight ? `height:${ch.logoHeight}` : ''} />
              <p class="compat__claim">{ch.claim}</p>
              <p class="compat__detail">{ch.detail}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>

  <div class="container compat__mobile-only">
    {chapters.map((ch) => (
      <div class="compat__card">
        <img class="compat__card-image" src={ch.image} alt={ch.alt} />
        <div class={`compat__text ${ch.onDark ? 'compat__text--on-dark' : ''}`} style={`background-color:${ch.tone}`}>
          <p class="compat__kicker">{ch.kicker}</p>
          <img class="compat__brand-logo" src={ch.logo} alt={ch.brand} style={ch.logoHeight ? `height:${ch.logoHeight}` : ''} />
          <p class="compat__claim">{ch.claim}</p>
          <p class="compat__detail">{ch.detail}</p>
        </div>
      </div>
    ))}
  </div>

  <div class="container compat__foot">
    <a href="/integraciones" class="compat__link">Ver todas las integraciones →</a>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);
  ScrollTrigger.config({ ignoreMobileResize: true });

  // Deben coincidir con --tone-* en theme.css (GSAP necesita un valor concreto para interpolar color)
  const TONES = ['#0022aa', '#e8531f', '#ffcc00'];

  function initCompat() {
    const section = document.querySelector('[data-gsap-section="compat"]');
    if (!section) return;

    const pinEl = section.querySelector('[data-compat-pin]');
    const stage = section.querySelector('[data-compat-stage]');
    const colorHalf = section.querySelector('[data-color-half]');
    const imageHalf = section.querySelector('[data-image-half]');
    const bgImages = section.querySelectorAll('[data-compat-image]');
    const texts = section.querySelectorAll('[data-compat-text]');
    if (!pinEl || !stage || !colorHalf || !imageHalf) return;

    gsap.set(colorHalf, { backgroundColor: TONES[0] });

    const mm = gsap.matchMedia();

    mm.add('(min-width: 900px) and (prefers-reduced-motion: no-preference)', () => {
      // Entrada: la stage aparece con un fade+scale suave al entrar en viewport.
      gsap.from(stage, {
        opacity: 0,
        y: 24,
        scale: 0.96,
        duration: 1,
        ease: 'power2.out',
        scrollTrigger: { trigger: pinEl, start: 'top 80%' },
      });

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: pinEl,
          start: 'top top',
          end: '+=200%',
          scrub: 1,
          pin: pinEl,
          anticipatePin: 1,
          invalidateOnRefresh: true,
        },
      });

      function transition(toIndex, swap) {
        const seg = gsap.timeline();
        seg.to(texts[toIndex - 1], { opacity: 0, y: -10, duration: 0.18, ease: 'power1.in' }, 0);
        seg.to(bgImages[toIndex - 1], { opacity: 0, duration: 0.3, ease: 'power1.inOut' }, 0.05);
        seg.to(imageHalf, { xPercent: swap ? 100 : 0, duration: 0.45, ease: 'power2.inOut' }, 0.05);
        seg.to(colorHalf, { xPercent: swap ? -100 : 0, duration: 0.45, ease: 'power2.inOut' }, 0.05);
        seg.to(colorHalf, { backgroundColor: TONES[toIndex], duration: 0.4, ease: 'power1.inOut' }, 0.1);
        seg.to(bgImages[toIndex], { opacity: 1, duration: 0.32, ease: 'power1.inOut' }, 0.24);
        seg.to(texts[toIndex], { opacity: 1, y: 0, duration: 0.22, ease: 'power2.out' }, 0.36);
        return seg;
      }

      tl.to({}, { duration: 0.55 }); // hold capítulo 1
      tl.add(transition(1, true), '+=0'); // imagen -> derecha, color -> izquierda
      tl.to({}, { duration: 0.55 }); // hold capítulo 2
      tl.add(transition(2, false), '+=0'); // vuelve: imagen -> izquierda, color -> derecha
      tl.to({}, { duration: 0.55 }); // hold capítulo 3
    });
  }

  document.addEventListener('astro:page-load', initCompat);
</script>

<style>
  .compat {
    padding-block: var(--space-2xl);
    background-color: var(--bg-primary);
  }

  .compat__head { display: grid; gap: var(--space-sm); margin-bottom: var(--space-lg); }
  .compat__eyebrow {
    font-size: var(--text-sm);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-secondary);
  }
  .compat__title {
    font-family: var(--font-heading);
    font-size: clamp(1.8rem, 4.5vw, 2.8rem);
    letter-spacing: -0.02em;
    max-width: 30ch;
  }

  /* Contenedor pinneado: siempre 100vh y centra la stage sin importar cuánto mida el head de arriba */
  .compat__pin {
    min-height: 100vh;
    display: flex;
    align-items: center;
  }
  .compat__stage-wrap { position: relative; width: 100%; display: flex; justify-content: center; }

  .compat__stage {
    position: relative;
    width: 100%;
    max-width: 1180px;
    aspect-ratio: 16 / 9;
    border-radius: 32px;
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    background-color: var(--bg-secondary);
  }

  .compat__half { position: absolute; top: 0; width: 50%; height: 100%; }
  .compat__half--image { left: 0; overflow: hidden; }
  .compat__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .compat__half--color {
    left: 50%;
    display: flex;
    align-items: center;
    padding: var(--space-lg);
  }

  .compat__text { position: absolute; inset: var(--space-lg); display: grid; align-content: center; gap: var(--space-sm); }
  .compat__kicker { font-size: var(--text-sm); color: color-mix(in srgb, var(--navy) 70%, transparent); }
  .compat__brand-logo {
    height: 34px;
    width: auto;
    margin-block: 2px 4px;
    /* Logos siempre en blanco (pedido de marca) — drop-shadow para que no se pierdan sobre el amarillo */
    filter: drop-shadow(0 1px 3px rgba(0, 0, 0, 0.3));
  }
  .compat__claim {
    font-family: var(--font-heading);
    font-size: clamp(1.4rem, 2.6vw, 1.9rem);
    color: var(--navy);
    letter-spacing: -0.01em;
    line-height: 1.28;
    max-width: 30ch;
  }
  .compat__detail {
    font-size: var(--text-lg);
    color: color-mix(in srgb, var(--navy) 72%, transparent);
    max-width: 32ch;
    line-height: 1.55;
  }

  .compat__text--on-dark .compat__kicker { color: color-mix(in srgb, var(--on-accent) 75%, transparent); }
  .compat__text--on-dark .compat__claim { color: var(--on-accent); }
  .compat__text--on-dark .compat__detail { color: color-mix(in srgb, var(--on-accent) 82%, transparent); }

  .compat__foot { margin-top: var(--space-md); text-align: center; }
  .compat__link { color: var(--accent); font-weight: 600; text-decoration: none; }

  /* ── Mobile / reduced-motion: bloque independiente, 3 tarjetas imagen+color apiladas ── */
  .compat__mobile-only { display: none; }

  @media (max-width: 899px), (prefers-reduced-motion: reduce) {
    .compat__desktop-only { display: none; }
    .compat__mobile-only { display: grid; gap: var(--space-lg); }

    .compat__card { display: grid; gap: var(--space-md); }
    .compat__card-image {
      width: 100%;
      aspect-ratio: 4 / 3;
      object-fit: cover;
      border-radius: var(--radius-lg);
      display: block;
    }
    .compat__card .compat__text {
      position: relative;
      inset: auto;
      padding: var(--space-lg);
      border-radius: var(--radius-lg);
    }
  }
</style>
