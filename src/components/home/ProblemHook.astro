---
// src/components/home/ProblemHook.astro
// Hook de retención tras el logo strip: NO es full-bleed. Card cuadrada grande
// (foto real, mismo estilo cálido/luz natural que BrandCompat) que alterna de
// lado por línea (izq/der/izq/der) y cambia de foto en cada transición, sin
// girar ni flotar. El texto se revela letra por letra y lleva un chip de fondo
// para mantener contraste al pasar sobre la imagen. Formato distinto a
// BrandCompat/SolutionBento/ProblemLedger.
import { withBase } from '../../utils/base.js';
const { lines, images } = Astro.props;
const list = lines ?? [];
const imgs = images ?? [];
---

<section class="hook" data-gsap-section="hook">
  <div class="hook__pin" data-hook-pin>
    <div class="container hook__stage" data-hook-stage data-side="left">
      <div class="hook__text">
        {list.map((line, i) => {
          const words = line.split(' ');
          return (
            <p class={`hook__line ${i === 0 ? 'is-first' : ''}`} data-hook-line={i}>
              {words.map((word, wi) => (
                <>
                  <span class="hook__word">
                    {word.split('').map((ch) => <span class="hook__letter">{ch}</span>)}
                  </span>
                  {wi < words.length - 1 && ' '}
                </>
              ))}
            </p>
          );
        })}
      </div>

      <div class="hook__card" data-hook-card>
        {imgs.map((src, i) => (
          <img class="hook__cardimg" src={withBase(src)} alt="" style={i > 0 ? 'opacity:0' : ''} data-hook-cardimg={i} />
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);
  ScrollTrigger.config({ ignoreMobileResize: true });

  function initHook() {
    const section = document.querySelector('[data-gsap-section="hook"]');
    if (!section) return;

    const pinEl = section.querySelector('[data-hook-pin]');
    const stage = section.querySelector('[data-hook-stage]');
    const card = section.querySelector('[data-hook-card]');
    const lines = section.querySelectorAll('[data-hook-line]');
    const cardImgs = section.querySelectorAll('[data-hook-cardimg]');
    if (!pinEl || !lines.length) return;

    const mm = gsap.matchMedia();

    mm.add('(min-width: 768px) and (prefers-reduced-motion: no-preference)', () => {
      gsap.from(lines[0].querySelectorAll('.hook__letter'), {
        opacity: 0,
        y: 14,
        duration: 0.6,
        stagger: 0.02,
        ease: 'power2.out',
        scrollTrigger: { trigger: pinEl, start: 'top 80%' },
      });

      // Cambio de lado ORGÁNICO: en vez de reordenar el DOM (la card saltaba
      // de un lado a otro en un solo frame), el layout queda fijo y la card y
      // el texto se DESLIZAN hacia el lado opuesto. Se miden ambos layouts
      // (offsetLeft ignora transforms) y se animan solo con x.
      const textEl = section.querySelector('.hook__text');
      const measure = () => {
        const read = () => ({ card: card.offsetLeft, text: textEl.offsetLeft + (parseFloat(getComputedStyle(textEl).paddingLeft) || 0) });
        stage.setAttribute('data-side', 'right'); const r = read();
        stage.setAttribute('data-side', 'left'); const l = read();
        return { card: r.card - l.card, text: r.text - l.text };
      };
      let delta = measure();
      const onRefreshInit = () => { gsap.set([card, textEl], { x: 0 }); delta = measure(); };
      ScrollTrigger.addEventListener('refreshInit', onRefreshInit);
      const sideX = (i, key) => () => (i % 2 === 1 ? delta[key] : 0);

      const letters = (el) => el.querySelectorAll('.hook__letter');
      const words = (el) => el.querySelectorAll('.hook__word');

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: pinEl,
          start: 'top top',
          // más recorrido por pregunta: transiciones lentas + tiempo de lectura
          end: '+=' + (lines.length * 150) + '%',
          scrub: 1.2,
          pin: pinEl,
          anticipatePin: 1,
          invalidateOnRefresh: true,
        },
      });

      lines.forEach((line, i) => {
        if (i === 0) return;
        const prevLine = lines[i - 1];
        tl.to({}, { duration: 0.6 }); // lectura de la pregunta anterior
        const at = tl.duration();

        // 1) la pregunta anterior se disuelve palabra a palabra, hacia arriba
        tl.to(words(prevLine), { opacity: 0, y: -18, duration: 0.45, stagger: 0.03, ease: 'power2.in' }, at);
        tl.set(prevLine, { opacity: 0 }, at + 0.7);

        // 2) card y texto se deslizan al lado opuesto con una curva suave;
        //    la card "respira" (baja un poco su escala a mitad del viaje)
        tl.to(card, { x: sideX(i, 'card'), duration: 1.6, ease: 'power3.inOut' }, at + 0.15);
        tl.to(card, { scale: 0.94, duration: 0.8, ease: 'sine.inOut', yoyo: true, repeat: 1 }, at + 0.15);
        tl.to(textEl, { x: sideX(i, 'text'), duration: 1.6, ease: 'power3.inOut' }, at + 0.15);

        // 3) la foto cambia durante el viaje, con un leve zoom de asentamiento
        if (cardImgs[i - 1]) tl.to(cardImgs[i - 1], { opacity: 0, duration: 1, ease: 'sine.inOut' }, at + 0.45);
        if (cardImgs[i]) tl.fromTo(cardImgs[i], { opacity: 0, scale: 1.1 }, { opacity: 1, scale: 1, duration: 1.2, ease: 'power2.out' }, at + 0.45);

        // 4) la nueva pregunta se escribe cuando la card ya está llegando
        tl.set(line, { opacity: 1 }, at + 1.15);
        gsap.set(words(line), { opacity: 1, y: 0 });
        tl.fromTo(letters(line), { opacity: 0, y: 16 }, { opacity: 1, y: 0, duration: 0.7, stagger: 0.014, ease: 'power3.out' }, at + 1.15);
      });
      tl.to({}, { duration: 0.5 }); // respiro final antes de soltar el pin

      return () => ScrollTrigger.removeEventListener('refreshInit', onRefreshInit);
    });

    // Mobile: pin "bueno" (§15.6.1) — el contenido avanza con el scroll.
    // Por cada línea: primero entra su imagen, luego se revela el texto.
    mm.add('(max-width: 767px) and (prefers-reduced-motion: no-preference)', () => {
      section.classList.add('is-mobile-pin');
      gsap.set(lines, { opacity: 0 });
      gsap.set(cardImgs, { opacity: 0 });

      // Imagen 1 + card entran mientras la sección sube hasta fijarse,
      // así el stage nunca llega vacío al pin.
      const intro = gsap.timeline({
        scrollTrigger: { trigger: pinEl, start: 'top 85%', end: 'top top', scrub: 1 },
      });
      if (card) intro.fromTo(card, { opacity: 0, y: 40 }, { opacity: 1, y: 0, ease: 'power2.out' });
      if (cardImgs[0]) intro.fromTo(cardImgs[0], { opacity: 0, scale: 1.12 }, { opacity: 1, scale: 1, ease: 'power2.out' }, '<');

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: pinEl,
          start: 'top top',
          end: '+=' + (lines.length * 130) + '%',
          scrub: 1.2,
          pin: pinEl,
          anticipatePin: 1,
          invalidateOnRefresh: true,
        },
      });

      // La celda de texto mide lo que la línea más larga: cada línea más corta
      // desplaza el stage la mitad de la diferencia para que card + texto
      // queden con el mismo margen arriba y abajo.
      const textBox = section.querySelector('.hook__text');
      const centerOffset = (i) => (textBox.offsetHeight - lines[i].offsetHeight) / 2;
      tl.set(stage, { y: () => centerOffset(0) }, 0);

      // Transición en capas (no todo a la vez): la pregunta se disuelve
      // palabra a palabra → la foto cambia con un crossfade largo y zoom de
      // asentamiento → la nueva pregunta se escribe cuando la foto ya llegó.
      const words = (el) => el.querySelectorAll('.hook__word');
      lines.forEach((line, i) => {
        let at = tl.duration();
        if (i > 0) {
          tl.to(words(lines[i - 1]), { opacity: 0, y: -14, duration: 0.45, stagger: 0.03, ease: 'power2.in' }, at);
          tl.set(lines[i - 1], { opacity: 0 }, at + 0.7);
          tl.to(stage, { y: () => centerOffset(i), duration: 0.9, ease: 'power3.inOut' }, at + 0.2);
          if (cardImgs[i - 1]) tl.to(cardImgs[i - 1], { opacity: 0, duration: 0.8, ease: 'sine.inOut' }, at + 0.25);
          if (cardImgs[i]) tl.fromTo(cardImgs[i], { opacity: 0, scale: 1.1 }, { opacity: 1, scale: 1, duration: 1, ease: 'power2.out' }, at + 0.25);
          if (card) tl.to(card, { scale: 0.96, duration: 0.5, ease: 'sine.inOut', yoyo: true, repeat: 1 }, at + 0.25);
          at += 0.85;
        }
        tl.set(line, { opacity: 1, y: 0 }, at);
        gsap.set(words(line), { opacity: 1, y: 0 });
        tl.fromTo(
          line.querySelectorAll('.hook__letter'),
          { opacity: 0, y: 14 },
          { opacity: 1, y: 0, duration: 0.7, stagger: 0.012, ease: 'power3.out' },
          at
        );
        tl.to({}, { duration: 0.6 }); // lectura
      });

      return () => section.classList.remove('is-mobile-pin');
    });

    mm.add('(prefers-reduced-motion: reduce)', () => {
      gsap.utils.toArray(lines).forEach((line) => {
        gsap.from(line, {
          opacity: 0,
          y: 16,
          duration: 0.6,
          ease: 'power2.out',
          scrollTrigger: { trigger: line, start: 'top 85%' },
        });
      });
    });
  }

  document.addEventListener('astro:page-load', initHook);
</script>

<style>
  .hook { background-color: var(--bg-secondary); }

  .hook__pin {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .hook__stage {
    position: relative;
    display: flex;
    align-items: center;
  }

  .hook__card {
    position: relative;
    flex-shrink: 0;
    width: clamp(260px, 38vw, 520px);
    aspect-ratio: 1;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    background-color: var(--bg-primary);
  }
  .hook__cardimg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.3s;
  }

  .hook__text {
    position: relative;
    flex: 1;
    display: grid;
    z-index: 1;
    min-height: 12rem;
  }
  .hook__line {
    grid-area: 1 / 1;
    display: inline-block;
    justify-self: start;
    align-self: start;
    max-width: 20ch;
    font-family: var(--font-heading);
    font-size: clamp(2.2rem, 6vw, 4.2rem);
    line-height: 1.14;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    opacity: 0;
    background-color: color-mix(in srgb, var(--bg-secondary) 88%, transparent);
    backdrop-filter: blur(6px);
    padding: 0.05em 0.3em;
    border-radius: var(--radius-sm);
  }
  .hook__line.is-first { opacity: 1; }
  .hook__word { display: inline-block; }
  .hook__letter { display: inline-block; }

  /* Alternancia de lado por línea: por defecto (data-side="right") la card
     queda después del texto (derecha); "left" invierte el orden visual. */
  @media (min-width: 768px) {
    .hook__stage[data-side="right"] .hook__card { order: 2; margin-left: clamp(-110px, -10vw, -60px); }
    .hook__stage[data-side="right"] .hook__text { order: 1; padding-right: var(--space-lg); }

    .hook__stage[data-side="left"] .hook__card { order: 1; margin-right: clamp(-110px, -10vw, -60px); }
    .hook__stage[data-side="left"] .hook__text { order: 2; padding-left: var(--space-lg); }
  }

  @media (max-width: 767px) {
    .hook__pin { min-height: auto; padding-block: var(--space-2xl); }
    .hook__stage { flex-direction: column; align-items: flex-start; gap: var(--space-lg); }
    .hook__card { order: -1; width: 200px; }
    .hook__text {
      flex: none;
      padding: 0;
      display: grid;
      gap: var(--space-lg);
      min-height: 0;
    }
    .hook__line { grid-area: auto; opacity: 1; max-width: none; }

    /* Pin con scroll (clase la pone el JS: sin JS queda la lista apilada) */
    /* Padding = alto del header (53px) arriba y zona del StickyCTA (2rem + 54px)
       abajo: el flex centra card + texto en el espacio realmente libre. */
    .hook.is-mobile-pin .hook__pin { min-height: 100vh; padding-block: 3.3rem 5.4rem; }
    .hook.is-mobile-pin .hook__stage { gap: var(--space-md); }
    .hook.is-mobile-pin .hook__card { width: min(78vw, 340px, 38vh); }
    .hook.is-mobile-pin .hook__cardimg { transition: none; }
    .hook.is-mobile-pin .hook__text { gap: 0; width: 100%; }
    .hook.is-mobile-pin .hook__line { grid-area: 1 / 1; opacity: 0; }
  }
  /* Pantallas bajas (iPhone SE): card y texto más compactos para que el
     bloque respire dentro del espacio libre. */
  @media (max-width: 767px) and (max-height: 700px) {
    .hook.is-mobile-pin .hook__card { width: min(78vw, 30vh); }
    .hook.is-mobile-pin .hook__stage { gap: var(--space-sm); }
    .hook.is-mobile-pin .hook__line { font-size: 1.9rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hook__line { opacity: 1; }
    .hook__letter { opacity: 1; }
  }
</style>
