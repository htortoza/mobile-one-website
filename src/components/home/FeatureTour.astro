---
// src/components/home/FeatureTour.astro
// Home — Tour de producto numerado (patrón Linear/§16.3), adaptado a "sala de
// control" (§20.2): un device fijo cuya pantalla cambia de módulo con el scroll,
// rail lateral con índice activo + barra de progreso. Cada módulo resuelve una
// fricción de venta real (filas, stock invisible, recepción manual).
const { eyebrow, title, features } = Astro.props;
const list = features ?? [];
---

<section class="tour" data-gsap-section="tour">
  <div class="container tour__head">
    {eyebrow && <p class="tour__eyebrow" data-gsap-animate="fade-up">{eyebrow}</p>}
    <h2 class="tour__title" data-gsap-animate="fade-up">{title}</h2>
  </div>

  <div class="tour__pin tour__desktop-only" data-tour-pin>
    <div class="container tour__stage">
      <div class="tour__rail">
        <div class="tour__dots" role="list">
          {list.map((_, i) => (
            <span class={`tour__dot ${i === 0 ? 'is-active' : ''}`} data-tour-dot={i} role="listitem" aria-hidden="true"></span>
          ))}
        </div>

        {list.map((f, i) => (
          <div class="tour__rail-text" data-rail-text={i} style={i > 0 ? 'opacity:0' : ''}>
            <span class="tour__num" aria-hidden="true">{f.num}</span>
            <h3 class="tour__heading">{f.heading}</h3>
            <p class="tour__desc">{f.text}</p>
          </div>
        ))}

        <div class="tour__progress"><span class="tour__progress-fill" data-tour-progress></span></div>
      </div>

      <div class="tour__device">
        <div class="tour__device-notch"></div>
        <div class="tour__device-screen">
          {list.map((f, i) => (
            <div class={`scr scr--${f.kind}`} data-tour-screen={i} style={i > 0 ? 'opacity:0' : ''}>
              {f.kind === 'queue' && (
                <>
                  <p class="scr__label">En fila</p>
                  <div class="scr__counter-wrap">
                    <span class="scr__counter scr__counter--before" data-anim>12</span>
                    <span class="scr__counter scr__counter--after" data-anim>0</span>
                  </div>
                  <div class="scr__chips">
                    <span class="scr__chip" data-anim></span>
                    <span class="scr__chip" data-anim></span>
                    <span class="scr__chip" data-anim></span>
                  </div>
                  <p class="scr__done" data-anim>Venta cerrada</p>
                </>
              )}
              {f.kind === 'stock' && (
                <>
                  <p class="scr__label">Stock en la red</p>
                  <ul class="scr__list">
                    <li class="scr__row" data-anim><span>Tienda Providencia</span><strong>0</strong></li>
                    <li class="scr__row" data-anim><span>Bodega Norte</span><strong class="scr__count--ok">14</strong></li>
                    <li class="scr__row" data-anim><span>Tienda Centro</span><strong class="scr__count--ok">6</strong></li>
                  </ul>
                  <p class="scr__tag" data-anim>Disponible para reserva</p>
                </>
              )}
              {f.kind === 'bulk' && (
                <>
                  <p class="scr__label">Bulto #482</p>
                  <ul class="scr__list">
                    <li class="scr__row" data-anim><span>SKU 10234</span><span class="scr__check">✓</span></li>
                    <li class="scr__row" data-anim><span>SKU 10891</span><span class="scr__check">✓</span></li>
                    <li class="scr__row" data-anim><span>SKU 11007</span><span class="scr__check">✓</span></li>
                    <li class="scr__row" data-anim><span>SKU 11240</span><span class="scr__check">✓</span></li>
                  </ul>
                  <p class="scr__done" data-anim>Recepción completa</p>
                </>
              )}
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>

  <div class="container tour__mobile-only">
    {list.map((f) => (
      <div class="tour__card" data-tour-card>
        <div class="tour__device tour__device--sm">
          <div class="tour__device-screen">
            <div class={`scr scr--${f.kind}`}>
              {f.kind === 'queue' && (
                <>
                  <p class="scr__label">En fila</p>
                  <div class="scr__counter-wrap">
                    <span class="scr__counter scr__counter--after" data-anim>0</span>
                  </div>
                  <p class="scr__done" data-anim>Venta cerrada</p>
                </>
              )}
              {f.kind === 'stock' && (
                <>
                  <p class="scr__label">Stock en la red</p>
                  <ul class="scr__list">
                    <li class="scr__row" data-anim><span>Bodega Norte</span><strong class="scr__count--ok">14</strong></li>
                    <li class="scr__row" data-anim><span>Tienda Centro</span><strong class="scr__count--ok">6</strong></li>
                  </ul>
                </>
              )}
              {f.kind === 'bulk' && (
                <>
                  <p class="scr__label">Bulto #482</p>
                  <ul class="scr__list">
                    <li class="scr__row" data-anim><span>SKU 10234</span><span class="scr__check">✓</span></li>
                    <li class="scr__row" data-anim><span>SKU 10891</span><span class="scr__check">✓</span></li>
                  </ul>
                  <p class="scr__done" data-anim>Recepción completa</p>
                </>
              )}
            </div>
          </div>
        </div>
        <div class="tour__rail-text">
          <span class="tour__num" aria-hidden="true">{f.num}</span>
          <h3 class="tour__heading">{f.heading}</h3>
          <p class="tour__desc">{f.text}</p>
        </div>
      </div>
    ))}
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);
  ScrollTrigger.config({ ignoreMobileResize: true });

  function revealScreenContent(screen, tl, pos) {
    if (!screen) return;
    const items = screen.querySelectorAll('[data-anim]');
    if (items.length) tl.fromTo(items, { opacity: 0, y: 10 }, { opacity: 1, y: 0, duration: 0.4, stagger: 0.08, ease: 'power2.out' }, pos);
    const before = screen.querySelector('.scr__counter--before');
    const after = screen.querySelector('.scr__counter--after');
    if (before && after) {
      tl.to(before, { opacity: 0, duration: 0.3 }, pos);
      tl.to(after, { opacity: 1, duration: 0.3 }, pos + 0.15);
    }
  }

  function initTour() {
    const section = document.querySelector('[data-gsap-section="tour"]');
    if (!section) return;

    const pinEl = section.querySelector('[data-tour-pin]');
    const stage = section.querySelector('.tour__stage');
    const railTexts = section.querySelectorAll('[data-rail-text]');
    const screens = section.querySelectorAll('[data-tour-screen]');
    const dots = section.querySelectorAll('[data-tour-dot]');
    const progressFill = section.querySelector('[data-tour-progress]');
    if (!pinEl || !stage || !railTexts.length) return;

    const mm = gsap.matchMedia();

    mm.add('(min-width: 1024px) and (prefers-reduced-motion: no-preference)', () => {
      gsap.from(stage, {
        opacity: 0,
        y: 24,
        scale: 0.97,
        duration: 1,
        ease: 'power2.out',
        scrollTrigger: { trigger: pinEl, start: 'top 80%' },
      });

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: pinEl,
          start: 'top top',
          end: '+=220%',
          scrub: 1,
          pin: pinEl,
          anticipatePin: 1,
          invalidateOnRefresh: true,
          onUpdate: (self) => {
            if (progressFill) progressFill.style.transform = `scaleX(${self.progress})`;
          },
        },
      });

      revealScreenContent(screens[0], tl, 0);

      function transition(toIndex) {
        const seg = gsap.timeline();
        seg.to(railTexts[toIndex - 1], { opacity: 0, y: -10, duration: 0.18, ease: 'power1.in' }, 0);
        seg.to(screens[toIndex - 1], { opacity: 0, duration: 0.25, ease: 'power1.inOut' }, 0.02);
        seg.add(() => {
          dots[toIndex - 1].classList.remove('is-active');
          dots[toIndex].classList.add('is-active');
        }, 0.1);
        seg.to(screens[toIndex], { opacity: 1, duration: 0.3, ease: 'power1.inOut' }, 0.2);
        seg.to(railTexts[toIndex], { opacity: 1, y: 0, duration: 0.28, ease: 'power2.out' }, 0.24);
        revealScreenContent(screens[toIndex], seg, 0.3);
        return seg;
      }

      tl.to({}, { duration: 0.6 }); // hold módulo 1
      tl.add(transition(1), '+=0');
      tl.to({}, { duration: 0.6 }); // hold módulo 2
      tl.add(transition(2), '+=0');
      tl.to({}, { duration: 0.6 }); // hold módulo 3
    });

    mm.add('(max-width: 1023px), (prefers-reduced-motion: reduce)', () => {
      const cards = section.querySelectorAll('[data-tour-card]');
      cards.forEach((card) => {
        const tl = gsap.timeline({ scrollTrigger: { trigger: card, start: 'top 78%' } });
        tl.from(card, { opacity: 0, y: 20, duration: 0.6, ease: 'power2.out' });
        revealScreenContent(card.querySelector('.scr'), tl, 0.1);
      });
    });
  }

  document.addEventListener('astro:page-load', initTour);
</script>

<style>
  .tour { padding-block: var(--space-2xl); background-color: var(--bg-primary); overflow: hidden; }
  .tour__head { display: grid; gap: var(--space-sm); margin-bottom: var(--space-lg); }
  .tour__eyebrow {
    font-size: var(--text-sm);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-secondary);
  }
  .tour__title {
    font-family: var(--font-heading);
    font-size: clamp(1.8rem, 4.5vw, 2.8rem);
    letter-spacing: -0.02em;
    max-width: 32ch;
  }

  .tour__pin { min-height: 100vh; display: flex; align-items: center; }
  .tour__stage {
    width: 100%;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
    align-items: center;
  }

  .tour__rail { display: grid; gap: var(--space-md); max-width: 46ch; }
  .tour__dots { display: flex; gap: var(--space-xs); }
  .tour__dot {
    width: 8px;
    height: 8px;
    border-radius: var(--radius-full);
    background-color: var(--border);
    transition: background-color var(--transition-fast), transform var(--transition-fast);
  }
  .tour__dot.is-active { background-color: var(--accent); transform: scale(1.3); }

  .tour__rail-text { position: relative; display: grid; gap: var(--space-sm); grid-row: 2; grid-column: 1; }
  .tour__num {
    font-family: var(--font-heading);
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    font-weight: 500;
    color: color-mix(in srgb, var(--accent) 16%, transparent);
    line-height: 1;
  }
  .tour__heading {
    font-family: var(--font-heading);
    font-size: clamp(1.4rem, 2.6vw, 1.9rem);
    letter-spacing: -0.01em;
    color: var(--text-primary);
    max-width: 22ch;
  }
  .tour__desc { color: var(--text-secondary); line-height: 1.6; max-width: 38ch; }

  .tour__progress { height: 3px; background-color: var(--border); border-radius: var(--radius-full); overflow: hidden; }
  .tour__progress-fill {
    display: block;
    height: 100%;
    width: 100%;
    background-color: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
  }

  .tour__device {
    position: relative;
    width: 100%;
    max-width: 340px;
    margin-inline: auto;
    aspect-ratio: 3 / 4;
    background-color: var(--navy);
    border-radius: 28px;
    padding: 10px;
    box-shadow: var(--shadow-lg);
  }
  .tour__device-notch {
    width: 60px;
    height: 6px;
    border-radius: var(--radius-full);
    background-color: color-mix(in srgb, var(--on-accent) 25%, transparent);
    margin-inline: auto;
    margin-block-end: 8px;
  }
  .tour__device-screen {
    position: relative;
    width: 100%;
    height: calc(100% - 22px);
    background-color: var(--bg-primary);
    border-radius: 20px;
    overflow: hidden;
  }

  .scr {
    position: absolute;
    inset: 0;
    padding: var(--space-md);
    display: grid;
    align-content: start;
    gap: var(--space-sm);
  }
  .scr__label { font-size: var(--text-xs); letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-secondary); }

  .scr__counter-wrap { position: relative; height: 3.4rem; }
  .scr__counter {
    position: absolute;
    inset: 0;
    font-family: var(--font-heading);
    font-size: 2.6rem;
    font-weight: 500;
    color: var(--navy);
  }
  .scr__counter--after { opacity: 0; color: var(--accent); }

  .scr__chips { display: flex; gap: 6px; }
  .scr__chip { width: 28px; height: 20px; border-radius: var(--radius-sm); background-color: var(--bg-secondary); border: 1px solid var(--border); }

  .scr__done, .scr__tag {
    width: fit-content;
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--accent-hover);
    background-color: color-mix(in srgb, var(--accent) 10%, transparent);
    padding: 4px 10px;
    border-radius: var(--radius-full);
  }

  .scr__list { display: grid; gap: 6px; list-style: none; }
  .scr__row {
    display: flex;
    justify-content: space-between;
    gap: var(--space-sm);
    font-size: var(--text-sm);
    padding: 6px 10px;
    border-radius: var(--radius-sm);
    background-color: var(--bg-secondary);
    color: var(--text-secondary);
  }
  .scr__count--ok { color: var(--accent-hover); font-weight: 500; }
  .scr__check { color: var(--accent-hover); font-weight: 500; }

  /* ── Mobile / reduced-motion: tarjetas apiladas, device chico + rail-text ── */
  .tour__mobile-only { display: none; }

  @media (max-width: 1023px), (prefers-reduced-motion: reduce) {
    .tour__desktop-only { display: none; }
    .tour__mobile-only { display: grid; gap: var(--space-xl); }

    .tour__card { display: grid; gap: var(--space-md); justify-items: center; text-align: center; }
    .tour__device--sm { max-width: 240px; aspect-ratio: 3 / 4; }
    .tour__card .tour__rail-text { justify-items: center; }
    .tour__card .tour__desc { max-width: 32ch; }
  }

  @media (min-width: 1024px) {
    .tour__stage { grid-template-columns: 0.9fr 1.1fr; }
    .tour__rail-text { grid-row: 2; }
    .tour__rail { grid-template-rows: auto 1fr auto; }
  }
</style>
