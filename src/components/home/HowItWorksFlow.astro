---
// src/components/home/HowItWorksFlow.astro
// Home §4.6 — Cómo funciona. Escena "sala de control" (§20.2, patrón ya
// probado en BrandCompat/ProblemHook): UN stage fijo pinneado cuyo ícono
// vectorial cambia de estado con el scroll (QR+login → escaneo de código de
// barra → % / descuento → boleta emitida), con rail lateral (número +
// encabezado + texto) que avanza en sincronía + barra de progreso. Cuenta
// una historia en vez de mostrar 4 puntos fijos en fila. Los íconos flotan
// sobre un blob orgánico (sin panel/caja cuadrada) y usan un duotono
// accent/accent-hover con formas redondeadas, no líneas planas de un solo tono.
const { title, steps } = Astro.props;
const list = steps ?? [];
const ICONS = ['qr', 'scan', 'promo', 'receipt'];
---

<section class="flow" data-gsap-section="flow">
  <div class="container flow__head">
    <h2 class="flow__title" data-gsap-animate="fade-up">{title}</h2>
  </div>

  <div class="flow__pin flow__desktop-only" data-flow-pin>
    <div class="container flow__stage">
      <div class="flow__rail">
        <div class="flow__dots" role="list">
          {list.map((_, i) => (
            <span class={`flow__dot ${i === 0 ? 'is-active' : ''}`} data-flow-dot={i} role="listitem" aria-hidden="true"></span>
          ))}
        </div>

        {list.map((step, i) => (
          <div class="flow__rail-text" data-rail-text={i} style={i > 0 ? 'opacity:0' : ''}>
            <span class="flow__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <p class="flow__step-text">{step}</p>
          </div>
        ))}

        <div class="flow__progress"><span class="flow__progress-fill" data-flow-progress></span></div>
      </div>

      <div class="flow__device">
        <div class="flow__blob" aria-hidden="true"></div>
        <div class="flow__screen">
          {list.map((_, i) => (
            <div class="flow__icon" data-flow-icon={i} style={i > 0 ? 'opacity:0' : ''} aria-hidden="true">
              {ICONS[i % ICONS.length] === 'qr' && (
                <svg viewBox="0 0 120 120">
                  <rect x="27" y="27" width="23" height="23" rx="6" class="flow__icon-line" />
                  <rect x="35" y="35" width="7" height="7" rx="2" class="flow__icon-fill-strong" />
                  <rect x="70" y="27" width="23" height="23" rx="6" class="flow__icon-line" />
                  <rect x="78" y="35" width="7" height="7" rx="2" class="flow__icon-fill-strong" />
                  <rect x="27" y="70" width="23" height="23" rx="6" class="flow__icon-line" />
                  <rect x="35" y="78" width="7" height="7" rx="2" class="flow__icon-fill-strong" />
                  <circle cx="73" cy="55" r="3" class="flow__icon-fill" />
                  <circle cx="83" cy="55" r="3" class="flow__icon-fill" />
                  <circle cx="73" cy="65" r="3" class="flow__icon-fill" />
                  <circle cx="57" cy="73" r="3" class="flow__icon-fill" />
                  <circle cx="65" cy="81" r="3" class="flow__icon-fill" />
                  <circle cx="81" cy="83" r="3" class="flow__icon-fill" />
                  <circle cx="49" cy="57" r="3" class="flow__icon-fill" />
                  <circle cx="83" cy="70" r="3" class="flow__icon-fill" />
                  <circle cx="92" cy="92" r="15" class="flow__icon-badge" />
                  <path d="M85 92 L90 97 L99 87" class="flow__icon-check" />
                </svg>
              )}
              {ICONS[i % ICONS.length] === 'scan' && (
                <svg viewBox="0 0 120 120">
                  <rect x="26" y="26" width="68" height="68" rx="18" class="flow__icon-line" />
                  <rect x="37" y="66" width="4" height="16" rx="2" class="flow__icon-fill" />
                  <rect x="44" y="66" width="3" height="16" rx="1.5" class="flow__icon-fill-strong" />
                  <rect x="50" y="66" width="5" height="16" rx="2" class="flow__icon-fill" />
                  <rect x="58" y="66" width="3" height="16" rx="1.5" class="flow__icon-fill-strong" />
                  <rect x="64" y="66" width="4" height="16" rx="2" class="flow__icon-fill" />
                  <rect x="71" y="66" width="3" height="16" rx="1.5" class="flow__icon-fill-strong" />
                  <rect x="77" y="66" width="5" height="16" rx="2" class="flow__icon-fill" />
                  <path d="M14 32 V20 Q14 16 18 16 H30" class="flow__icon-bracket" />
                  <path d="M106 32 V20 Q106 16 102 16 H90" class="flow__icon-bracket" />
                  <path d="M14 88 V100 Q14 104 18 104 H30" class="flow__icon-bracket" />
                  <path d="M106 88 V100 Q106 104 102 104 H90" class="flow__icon-bracket" />
                  <rect x="26" y="30" width="68" height="10" rx="5" class="flow__icon-glow" />
                  <rect x="26" y="34" width="68" height="2.5" rx="1.25" class="flow__icon-scan" data-scan-line />
                </svg>
              )}
              {ICONS[i % ICONS.length] === 'promo' && (
                <svg viewBox="0 0 120 120">
                  <path d="M18 52 L36 28 Q38 25 42 25 L84 25 Q92 25 92 33 L92 64 Q92 72 84 72 L42 72 Q38 72 36 69 Z" class="flow__icon-line" />
                  <circle cx="38" cy="48.5" r="5" class="flow__icon-fill-strong" />
                  <circle cx="55" cy="40" r="6" class="flow__icon-line" />
                  <circle cx="72" cy="58" r="6" class="flow__icon-line" />
                  <path d="M73 40 L54 58" class="flow__icon-bracket" />
                  <circle cx="96" cy="24" r="13" class="flow__icon-badge-soft" />
                  <circle cx="93" cy="21" r="2.2" class="flow__icon-fill-strong" />
                  <circle cx="99" cy="27" r="2.2" class="flow__icon-fill-strong" />
                  <path d="M99.5 20.5 L92.5 27.5" class="flow__icon-bracket-sm" />
                  <circle cx="20" cy="90" r="11" class="flow__icon-badge-soft" />
                  <circle cx="17" cy="87" r="1.8" class="flow__icon-fill-strong" />
                  <circle cx="23" cy="93" r="1.8" class="flow__icon-fill-strong" />
                  <path d="M23.5 86.5 L16.5 93.5" class="flow__icon-bracket-sm" />
                </svg>
              )}
              {ICONS[i % ICONS.length] === 'receipt' && (
                <svg viewBox="0 0 120 120">
                  <path d="M30 22 Q30 18 34 18 L86 18 Q90 18 90 22 L90 80 L83 87 L76 80 L69 87 L62 80 L55 87 L48 80 L41 87 L34 80 L30 84 Z" class="flow__icon-line" />
                  <rect x="42" y="32" width="38" height="3.5" rx="1.75" class="flow__icon-fill-soft" />
                  <rect x="42" y="42" width="26" height="3.5" rx="1.75" class="flow__icon-fill-soft" />
                  <rect x="42" y="52" width="34" height="3.5" rx="1.75" class="flow__icon-fill-soft" />
                  <rect x="42" y="66" width="30" height="6" rx="3" class="flow__icon-fill-strong" />
                  <circle cx="90" cy="28" r="15" class="flow__icon-badge" />
                  <path d="M83 28 L87.5 32.5 L97 22" class="flow__icon-check" />
                </svg>
              )}
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>

  <div class="container flow__mobile-only">
    {list.map((step, i) => (
      <div class="flow__mcard" data-flow-mcard>
        <div class="flow__device flow__device--sm">
          <div class="flow__blob" aria-hidden="true"></div>
          <div class="flow__screen flow__screen--sm">
            <div class="flow__icon" aria-hidden="true">
              {ICONS[i % ICONS.length] === 'qr' && (
                <svg viewBox="0 0 120 120">
                  <rect x="27" y="27" width="23" height="23" rx="6" class="flow__icon-line" />
                  <rect x="35" y="35" width="7" height="7" rx="2" class="flow__icon-fill-strong" />
                  <rect x="70" y="27" width="23" height="23" rx="6" class="flow__icon-line" />
                  <rect x="78" y="35" width="7" height="7" rx="2" class="flow__icon-fill-strong" />
                  <rect x="27" y="70" width="23" height="23" rx="6" class="flow__icon-line" />
                  <rect x="35" y="78" width="7" height="7" rx="2" class="flow__icon-fill-strong" />
                  <circle cx="73" cy="55" r="3" class="flow__icon-fill" />
                  <circle cx="83" cy="55" r="3" class="flow__icon-fill" />
                  <circle cx="73" cy="65" r="3" class="flow__icon-fill" />
                  <circle cx="57" cy="73" r="3" class="flow__icon-fill" />
                  <circle cx="65" cy="81" r="3" class="flow__icon-fill" />
                  <circle cx="81" cy="83" r="3" class="flow__icon-fill" />
                  <circle cx="49" cy="57" r="3" class="flow__icon-fill" />
                  <circle cx="83" cy="70" r="3" class="flow__icon-fill" />
                  <circle cx="92" cy="92" r="15" class="flow__icon-badge" />
                  <path d="M85 92 L90 97 L99 87" class="flow__icon-check" />
                </svg>
              )}
              {ICONS[i % ICONS.length] === 'scan' && (
                <svg viewBox="0 0 120 120">
                  <rect x="26" y="26" width="68" height="68" rx="18" class="flow__icon-line" />
                  <rect x="37" y="66" width="4" height="16" rx="2" class="flow__icon-fill" />
                  <rect x="44" y="66" width="3" height="16" rx="1.5" class="flow__icon-fill-strong" />
                  <rect x="50" y="66" width="5" height="16" rx="2" class="flow__icon-fill" />
                  <rect x="58" y="66" width="3" height="16" rx="1.5" class="flow__icon-fill-strong" />
                  <rect x="64" y="66" width="4" height="16" rx="2" class="flow__icon-fill" />
                  <rect x="71" y="66" width="3" height="16" rx="1.5" class="flow__icon-fill-strong" />
                  <rect x="77" y="66" width="5" height="16" rx="2" class="flow__icon-fill" />
                  <path d="M14 32 V20 Q14 16 18 16 H30" class="flow__icon-bracket" />
                  <path d="M106 32 V20 Q106 16 102 16 H90" class="flow__icon-bracket" />
                  <path d="M14 88 V100 Q14 104 18 104 H30" class="flow__icon-bracket" />
                  <path d="M106 88 V100 Q106 104 102 104 H90" class="flow__icon-bracket" />
                </svg>
              )}
              {ICONS[i % ICONS.length] === 'promo' && (
                <svg viewBox="0 0 120 120">
                  <path d="M18 52 L36 28 Q38 25 42 25 L84 25 Q92 25 92 33 L92 64 Q92 72 84 72 L42 72 Q38 72 36 69 Z" class="flow__icon-line" />
                  <circle cx="38" cy="48.5" r="5" class="flow__icon-fill-strong" />
                  <circle cx="55" cy="40" r="6" class="flow__icon-line" />
                  <circle cx="72" cy="58" r="6" class="flow__icon-line" />
                  <path d="M73 40 L54 58" class="flow__icon-bracket" />
                </svg>
              )}
              {ICONS[i % ICONS.length] === 'receipt' && (
                <svg viewBox="0 0 120 120">
                  <path d="M30 22 Q30 18 34 18 L86 18 Q90 18 90 22 L90 80 L83 87 L76 80 L69 87 L62 80 L55 87 L48 80 L41 87 L34 80 L30 84 Z" class="flow__icon-line" />
                  <rect x="42" y="32" width="38" height="3.5" rx="1.75" class="flow__icon-fill-soft" />
                  <rect x="42" y="42" width="26" height="3.5" rx="1.75" class="flow__icon-fill-soft" />
                  <rect x="42" y="52" width="34" height="3.5" rx="1.75" class="flow__icon-fill-soft" />
                  <rect x="42" y="66" width="30" height="6" rx="3" class="flow__icon-fill-strong" />
                  <circle cx="90" cy="28" r="15" class="flow__icon-badge" />
                  <path d="M83 28 L87.5 32.5 L97 22" class="flow__icon-check" />
                </svg>
              )}
            </div>
          </div>
        </div>
        <div class="flow__rail-text">
          <span class="flow__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <p class="flow__step-text">{step}</p>
        </div>
      </div>
    ))}
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);
  ScrollTrigger.config({ ignoreMobileResize: true });

  function initFlow() {
    const section = document.querySelector('[data-gsap-section="flow"]');
    if (!section) return;

    const pinEl = section.querySelector('[data-flow-pin]');
    const stage = section.querySelector('.flow__stage');
    const railTexts = section.querySelectorAll('[data-rail-text]');
    const icons = section.querySelectorAll('[data-flow-icon]');
    const dots = section.querySelectorAll('[data-flow-dot]');
    const progressFill = section.querySelector('[data-flow-progress]');
    if (!pinEl || !stage || !railTexts.length) return;

    const mm = gsap.matchMedia();

    mm.add('(min-width: 1024px) and (prefers-reduced-motion: no-preference)', () => {
      gsap.from(stage, {
        opacity: 0, y: 24, scale: 0.97, duration: 1, ease: 'power2.out',
        scrollTrigger: { trigger: pinEl, start: 'top 80%' },
      });

      const n = railTexts.length;
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: pinEl,
          start: 'top top',
          end: '+=' + (n * 100) + '%',
          scrub: 1,
          pin: pinEl,
          anticipatePin: 1,
          invalidateOnRefresh: true,
          onUpdate: (self) => { if (progressFill) progressFill.style.transform = `scaleX(${self.progress})`; },
        },
      });

      function transition(toIndex) {
        const seg = gsap.timeline();
        seg.to(railTexts[toIndex - 1], { opacity: 0, y: -10, duration: 0.18, ease: 'power1.in' }, 0);
        seg.to(icons[toIndex - 1], { opacity: 0, y: -14, scale: 0.92, duration: 0.3, ease: 'power1.inOut' }, 0.02);
        seg.add(() => { dots[toIndex - 1].classList.remove('is-active'); dots[toIndex].classList.add('is-active'); }, 0.16);
        seg.fromTo(icons[toIndex], { opacity: 0, y: 16, scale: 0.88, rotate: -4 }, { opacity: 1, y: 0, scale: 1, rotate: 0, duration: 0.55, ease: 'back.out(1.5)' }, 0.2);
        seg.to(railTexts[toIndex], { opacity: 1, y: 0, duration: 0.32, ease: 'power2.out' }, 0.34);
        return seg;
      }

      for (let i = 1; i < n; i++) {
        tl.to({}, { duration: 0.5 });
        tl.add(transition(i), '+=0');
      }
      tl.to({}, { duration: 0.6 });

      const scanLine = section.querySelector('[data-scan-line]');
      if (scanLine) {
        gsap.to(scanLine, {
          attr: { y: 78 }, duration: 1.2, ease: 'sine.inOut', yoyo: true, repeat: -1,
          scrollTrigger: { trigger: pinEl, start: 'top bottom', end: 'bottom top' },
        });
      }
    });

    mm.add('(max-width: 1023px), (prefers-reduced-motion: reduce)', () => {
      section.querySelectorAll('[data-flow-mcard]').forEach((card) => {
        gsap.from(card, {
          opacity: 0, y: 24, duration: 0.7, ease: 'power2.out',
          scrollTrigger: { trigger: card, start: 'top 82%' },
        });
      });
    });
  }

  document.addEventListener('astro:page-load', initFlow);
</script>

<style>
  .flow { padding-block: var(--space-2xl); background-color: var(--bg-primary); overflow: hidden; }
  .flow__head { margin-bottom: var(--space-lg); }
  .flow__title {
    font-family: var(--font-heading);
    font-size: clamp(2.2rem, 5.4vw, 3.6rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    max-width: 24ch;
  }

  .flow__pin { min-height: 100vh; display: flex; align-items: center; }
  .flow__stage { width: 100%; display: grid; grid-template-columns: 1fr; gap: var(--space-xl); align-items: center; }

  .flow__rail { display: grid; gap: var(--space-md); max-width: 46ch; }
  .flow__dots { display: flex; gap: var(--space-xs); }
  .flow__dot { width: 8px; height: 8px; border-radius: var(--radius-full); background-color: var(--border); transition: background-color var(--transition-fast), transform var(--transition-fast); }
  .flow__dot.is-active { background-color: var(--accent); transform: scale(1.3); }

  .flow__rail-text { position: relative; display: grid; gap: var(--space-sm); grid-row: 2; grid-column: 1; }
  .flow__num {
    font-family: var(--font-heading);
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    font-weight: 500;
    color: color-mix(in srgb, var(--accent) 20%, transparent);
    line-height: 1;
  }
  .flow__step-text { font-size: var(--text-xl); color: var(--text-primary); line-height: 1.4; max-width: 24ch; }

  .flow__progress { height: 3px; background-color: var(--border); border-radius: var(--radius-full); overflow: hidden; }
  .flow__progress-fill { display: block; height: 100%; width: 100%; background-color: var(--accent); transform: scaleX(0); transform-origin: left; }

  /* Sin panel/caja: el ícono flota sobre un blob orgánico borroso, no una
     tarjeta cuadrada — el marco lo da la composición, no un contenedor. */
  .flow__device { position: relative; justify-self: center; }
  .flow__blob {
    position: absolute;
    inset: 6% 10%;
    background:
      radial-gradient(circle at 32% 30%, color-mix(in srgb, var(--accent) 22%, transparent), transparent 62%),
      radial-gradient(circle at 68% 72%, color-mix(in srgb, var(--accent-hover) 16%, transparent), transparent 60%);
    border-radius: 44% 56% 62% 38% / 48% 42% 58% 52%;
    filter: blur(18px);
    z-index: -1;
  }
  .flow__screen {
    position: relative;
    width: min(66vw, 360px);
    aspect-ratio: 1;
  }
  .flow__device--sm { width: 100%; }
  .flow__screen--sm { width: 100%; max-width: 200px; margin-inline: auto; }

  .flow__icon { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; padding: 18%; filter: drop-shadow(0 10px 20px color-mix(in srgb, var(--accent) 14%, transparent)); }
  .flow__screen--sm .flow__icon { position: relative; padding: 6%; }
  .flow__icon svg { width: 100%; height: 100%; overflow: visible; color: var(--accent); }
  .flow__icon-line { fill: none; stroke: currentColor; stroke-width: 3.5; stroke-linejoin: round; stroke-linecap: round; }
  .flow__icon-bracket { fill: none; stroke: currentColor; stroke-width: 3.5; stroke-linecap: round; stroke-linejoin: round; opacity: 0.55; }
  .flow__icon-bracket-sm { fill: none; stroke: var(--accent-hover); stroke-width: 2.4; stroke-linecap: round; }
  .flow__icon-fill { fill: currentColor; opacity: 0.75; }
  .flow__icon-fill-strong { fill: var(--accent-hover); }
  .flow__icon-fill-soft { fill: currentColor; opacity: 0.4; }
  .flow__icon-glow { fill: var(--accent-hover); opacity: 0.16; }
  .flow__icon-scan { fill: var(--accent-hover); }
  .flow__icon-badge { fill: var(--accent-hover); }
  .flow__icon-badge-soft { fill: color-mix(in srgb, var(--accent) 14%, transparent); stroke: none; }
  .flow__icon-check { fill: none; stroke: var(--on-accent); stroke-width: 3.5; stroke-linecap: round; stroke-linejoin: round; }

  .flow__mobile-only { display: none; }
  @media (max-width: 1023px), (prefers-reduced-motion: reduce) {
    .flow__desktop-only { display: none; }
    .flow__mobile-only { display: grid; gap: var(--space-2xl); }
    .flow__mcard { display: grid; gap: var(--space-lg); justify-items: center; text-align: center; }
    .flow__mcard .flow__rail-text { justify-items: center; }
    .flow__mcard .flow__step-text { max-width: 30ch; }
  }

  @media (min-width: 1024px) {
    .flow__stage { grid-template-columns: 0.9fr 1.1fr; }
  }
</style>
