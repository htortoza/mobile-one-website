---
// src/components/home/HowItWorksFlow.astro
// Home §4.6 — Cómo funciona. Mismo lenguaje visual que el resto del sitio:
// mockup de pantalla real de terminal (como el screenshot del Hero y el
// device de ProductoHero/ProductoTour), NO íconos vectoriales sueltos sobre
// un blob — eso desentonaba con el resto de secciones basadas en fotos/UI
// real. Un solo device pinneado cuya pantalla cambia de contenido con el
// scroll, contando una sola venta de punta a punta: QR+credencial → escaneo
// de producto → promoción aplicada → boleta emitida. Rail lateral (número +
// texto) + dots + barra de progreso, mismo mecanismo que BrandCompat/
// ProductoGallery.
const { title, steps } = Astro.props;
const list = steps ?? [];
---

<section class="flow" data-gsap-section="flow">
  <div class="container flow__head">
    <h2 class="flow__title" data-gsap-animate="fade-up">{title}</h2>
  </div>

  <div class="flow__pin flow__desktop-only" data-flow-pin>
    <div class="container flow__stage">
      <div class="flow__rail">
        <div class="flow__dots" role="list">
          {list.map((_, i) => (
            <span class={`flow__dot ${i === 0 ? 'is-active' : ''}`} data-flow-dot={i} role="listitem" aria-hidden="true"></span>
          ))}
        </div>

        {list.map((step, i) => (
          <div class="flow__rail-text" data-rail-text={i} style={i > 0 ? 'opacity:0' : ''}>
            <span class="flow__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <p class="flow__step-text">{step}</p>
          </div>
        ))}

        <div class="flow__progress"><span class="flow__progress-fill" data-flow-progress></span></div>
      </div>

      <div class="flow__device-wrap">
        <div class="flow__glow" aria-hidden="true"></div>
        <div class="flow__device">
          <div class="flow__notch"></div>
          <div class="flow__screen">
            <div class="flow__scr" data-flow-icon="0" aria-hidden="true">
              <div class="flow__scr-head"><span class="flow__live"><span class="flow__live-dot"></span>En vivo</span><span class="flow__scr-id">Terminal 04</span></div>
              <div class="flow__qr" aria-hidden="true">
                <span></span><span></span><span></span>
                <span></span><span class="is-off"></span><span></span>
                <span></span><span></span><span></span>
              </div>
              <p class="flow__scr-row"><span>Vendedor</span><strong>María P.</strong></p>
              <span class="flow__scr-badge">Credencial validada</span>
            </div>

            <div class="flow__scr" data-flow-icon="1" style="opacity:0" aria-hidden="true">
              <p class="flow__scr-label">Escaneando producto</p>
              <p class="flow__scr-row flow__scr-row--lg"><span>Zapatilla Urbana 42</span><strong>$42.990</strong></p>
              <p class="flow__scr-row"><span>SKU</span><strong>048-221-B</strong></p>
              <p class="flow__scr-row"><span>Stock en red</span><strong class="flow__ok">14 disponibles</strong></p>
            </div>

            <div class="flow__scr" data-flow-icon="2" style="opacity:0" aria-hidden="true">
              <p class="flow__scr-label">Carrito</p>
              <p class="flow__scr-row"><span>Zapatilla Urbana 42</span><strong>$42.990</strong></p>
              <p class="flow__scr-row"><span>Descuento CloudPromo</span><strong class="flow__ok">-15%</strong></p>
              <div class="flow__scr-total"><span>Total</span><strong>$36.541</strong></div>
            </div>

            <div class="flow__scr" data-flow-icon="3" style="opacity:0" aria-hidden="true">
              <p class="flow__scr-label">Boleta electrónica</p>
              <p class="flow__scr-row"><span>Zapatilla Urbana 42</span><strong>$36.541</strong></p>
              <p class="flow__scr-row"><span>Método de pago</span><strong>Débito</strong></p>
              <span class="flow__scr-badge flow__scr-badge--check">✓ Emitida y sincronizada con SAP B1</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="container flow__mobile-only">
    {list.map((step, i) => (
      <div class="flow__mcard" data-flow-mcard>
        <div class="flow__device-wrap flow__device-wrap--sm">
          <div class="flow__glow" aria-hidden="true"></div>
          <div class="flow__device flow__device--sm">
            <div class="flow__notch"></div>
            <div class="flow__screen">
              {i === 0 && (
                <div class="flow__scr">
                  <div class="flow__scr-head"><span class="flow__live"><span class="flow__live-dot"></span>En vivo</span><span class="flow__scr-id">Terminal 04</span></div>
                  <div class="flow__qr" aria-hidden="true">
                    <span></span><span></span><span></span>
                    <span></span><span class="is-off"></span><span></span>
                    <span></span><span></span><span></span>
                  </div>
                  <span class="flow__scr-badge">Credencial validada</span>
                </div>
              )}
              {i === 1 && (
                <div class="flow__scr">
                  <p class="flow__scr-label">Escaneando producto</p>
                  <p class="flow__scr-row flow__scr-row--lg"><span>Zapatilla Urbana 42</span><strong>$42.990</strong></p>
                  <p class="flow__scr-row"><span>Stock en red</span><strong class="flow__ok">14 disponibles</strong></p>
                </div>
              )}
              {i === 2 && (
                <div class="flow__scr">
                  <p class="flow__scr-label">Carrito</p>
                  <p class="flow__scr-row"><span>Descuento CloudPromo</span><strong class="flow__ok">-15%</strong></p>
                  <div class="flow__scr-total"><span>Total</span><strong>$36.541</strong></div>
                </div>
              )}
              {i === 3 && (
                <div class="flow__scr">
                  <p class="flow__scr-label">Boleta electrónica</p>
                  <p class="flow__scr-row"><span>Método de pago</span><strong>Débito</strong></p>
                  <span class="flow__scr-badge flow__scr-badge--check">✓ Emitida y sincronizada</span>
                </div>
              )}
            </div>
          </div>
        </div>
        <div class="flow__rail-text">
          <span class="flow__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <p class="flow__step-text">{step}</p>
        </div>
      </div>
    ))}
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);
  ScrollTrigger.config({ ignoreMobileResize: true });

  function initFlow() {
    const section = document.querySelector('[data-gsap-section="flow"]');
    if (!section) return;

    const pinEl = section.querySelector('[data-flow-pin]');
    const stage = section.querySelector('.flow__stage');
    const railTexts = section.querySelectorAll('[data-rail-text]');
    const screens = section.querySelectorAll('.flow__device [data-flow-icon]');
    const dots = section.querySelectorAll('[data-flow-dot]');
    const progressFill = section.querySelector('[data-flow-progress]');
    if (!pinEl || !stage || !railTexts.length) return;

    const mm = gsap.matchMedia();

    mm.add('(min-width: 1024px) and (prefers-reduced-motion: no-preference)', () => {
      gsap.from(stage, {
        opacity: 0, y: 24, scale: 0.97, duration: 1, ease: 'power2.out',
        scrollTrigger: { trigger: pinEl, start: 'top 80%' },
      });

      const n = railTexts.length;
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: pinEl,
          start: 'top top',
          end: '+=' + (n * 100) + '%',
          scrub: 1,
          pin: pinEl,
          anticipatePin: 1,
          invalidateOnRefresh: true,
          onUpdate: (self) => { if (progressFill) progressFill.style.transform = `scaleX(${self.progress})`; },
        },
      });

      function transition(toIndex) {
        const seg = gsap.timeline();
        seg.to(railTexts[toIndex - 1], { opacity: 0, y: -10, duration: 0.18, ease: 'power1.in' }, 0);
        seg.to(screens[toIndex - 1], { opacity: 0, y: -8, duration: 0.25, ease: 'power1.inOut' }, 0.02);
        seg.add(() => { dots[toIndex - 1].classList.remove('is-active'); dots[toIndex].classList.add('is-active'); }, 0.16);
        seg.fromTo(screens[toIndex], { opacity: 0, y: 10 }, { opacity: 1, y: 0, duration: 0.4, ease: 'power2.out' }, 0.2);
        seg.to(railTexts[toIndex], { opacity: 1, y: 0, duration: 0.32, ease: 'power2.out' }, 0.34);
        return seg;
      }

      for (let i = 1; i < n; i++) {
        tl.to({}, { duration: 0.5 });
        tl.add(transition(i), '+=0');
      }
      tl.to({}, { duration: 0.6 });
    });

    mm.add('(max-width: 1023px), (prefers-reduced-motion: reduce)', () => {
      section.querySelectorAll('[data-flow-mcard]').forEach((card) => {
        gsap.from(card, {
          opacity: 0, y: 24, duration: 0.7, ease: 'power2.out',
          scrollTrigger: { trigger: card, start: 'top 82%' },
        });
      });
    });
  }

  document.addEventListener('astro:page-load', initFlow);
</script>

<style>
  .flow { padding-block: var(--space-2xl); background-color: var(--bg-primary); overflow: hidden; }
  .flow__head { margin-bottom: var(--space-lg); }
  .flow__title {
    font-family: var(--font-heading);
    font-size: clamp(2.2rem, 5.4vw, 3.6rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    max-width: 24ch;
  }

  .flow__pin { min-height: 100vh; display: flex; align-items: center; }
  .flow__stage { width: 100%; display: grid; grid-template-columns: 1fr; gap: var(--space-xl); align-items: center; }

  .flow__rail { display: grid; gap: var(--space-md); max-width: 46ch; }
  .flow__dots { display: flex; gap: var(--space-xs); }
  .flow__dot { width: 8px; height: 8px; border-radius: var(--radius-full); background-color: var(--border); transition: background-color var(--transition-fast), transform var(--transition-fast); }
  .flow__dot.is-active { background-color: var(--accent); transform: scale(1.3); }

  .flow__rail-text { position: relative; display: grid; gap: var(--space-sm); grid-row: 2; grid-column: 1; }
  .flow__num {
    font-family: var(--font-heading);
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    font-weight: 500;
    color: color-mix(in srgb, var(--accent) 20%, transparent);
    line-height: 1;
  }
  .flow__step-text { font-size: var(--text-xl); color: var(--text-primary); line-height: 1.4; max-width: 24ch; }

  .flow__progress { height: 3px; background-color: var(--border); border-radius: var(--radius-full); overflow: hidden; }
  .flow__progress-fill { display: block; height: 100%; width: 100%; background-color: var(--accent); transform: scaleX(0); transform-origin: left; }

  .flow__device-wrap { position: relative; justify-self: center; }
  .flow__glow {
    position: absolute; inset: 8% 14%;
    background: radial-gradient(circle, color-mix(in srgb, var(--accent) 30%, transparent), transparent 70%);
    filter: blur(36px); z-index: -1;
  }
  .flow__device {
    position: relative;
    width: min(60vw, 320px);
    aspect-ratio: 3 / 4;
    background-color: var(--navy);
    border-radius: 28px;
    padding: 12px;
    box-shadow: var(--shadow-lg);
  }
  .flow__device--sm { width: 100%; max-width: 220px; margin-inline: auto; }
  .flow__notch { width: 60px; height: 6px; border-radius: var(--radius-full); background-color: color-mix(in srgb, var(--on-accent) 22%, transparent); margin-inline: auto; margin-block-end: 10px; }
  .flow__screen { position: relative; height: calc(100% - 22px); background-color: var(--bg-primary); border-radius: 20px; overflow: hidden; }

  .flow__scr { position: absolute; inset: 0; padding: var(--space-md); display: grid; align-content: start; gap: var(--space-sm); }
  .flow__scr-head { display: flex; align-items: center; justify-content: space-between; }
  .flow__live { display: inline-flex; align-items: center; gap: 6px; font-size: var(--text-xs); text-transform: uppercase; letter-spacing: 0.06em; color: var(--accent-hover); }
  .flow__live-dot { width: 6px; height: 6px; border-radius: var(--radius-full); background-color: var(--accent-hover); }
  .flow__scr-id { font-size: var(--text-xs); color: var(--text-secondary); }

  .flow__qr { display: grid; grid-template-columns: repeat(3, 1fr); gap: 5px; width: 84px; margin-block: var(--space-xs); }
  .flow__qr span { aspect-ratio: 1; border-radius: 3px; background-color: var(--navy); }
  .flow__qr span.is-off { background-color: transparent; }

  .flow__scr-label { font-size: var(--text-xs); letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-secondary); }
  .flow__scr-row { display: flex; justify-content: space-between; gap: var(--space-sm); font-size: var(--text-sm); color: var(--text-secondary); padding-block: 6px; border-bottom: 1px solid var(--border); }
  .flow__scr-row strong { color: var(--text-primary); font-weight: 500; }
  .flow__scr-row--lg { font-size: var(--text-base); }
  .flow__ok { color: var(--accent-hover) !important; }
  .flow__scr-total { display: flex; justify-content: space-between; margin-block-start: var(--space-xs); font-family: var(--font-heading); font-size: var(--text-lg); color: var(--text-primary); }

  .flow__scr-badge {
    justify-self: start;
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--accent-hover);
    background-color: color-mix(in srgb, var(--accent) 12%, transparent);
    padding: 6px 12px;
    border-radius: var(--radius-full);
  }
  .flow__scr-badge--check { color: var(--accent-hover); }

  .flow__mobile-only { display: none; }
  @media (max-width: 1023px), (prefers-reduced-motion: reduce) {
    .flow__desktop-only { display: none; }
    .flow__mobile-only { display: grid; gap: var(--space-2xl); }
    .flow__mcard { display: grid; gap: var(--space-lg); justify-items: center; text-align: center; }
    .flow__mcard .flow__rail-text { justify-items: center; }
    .flow__mcard .flow__step-text { max-width: 30ch; }
    .flow__device-wrap--sm .flow__device { aspect-ratio: 3 / 4; }
  }

  @media (min-width: 1024px) {
    .flow__stage { grid-template-columns: 0.9fr 1.1fr; }
  }
</style>
