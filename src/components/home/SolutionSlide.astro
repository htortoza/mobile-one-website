---
// src/components/home/SolutionSlide.astro
// Home — Responde a las 3 preguntas de ProblemHook. Slide horizontal
// pinneado, limpio y ordenado: logo de marca en el header, foto real grande
// por panel (mismo estilo cálido que BrandCompat/ProblemHook), sin mockups
// abstractos. Mecánica de galería horizontal (§16.3), distinta al
// rail+device que ya no usamos.
import { withBase } from '../../utils/base.js';
const { eyebrow, title, panels } = Astro.props;
const list = panels ?? [];
---

<section class="sslide" data-gsap-section="sslide">
  <div class="container sslide__head">
    <img class="sslide__logo" src={withBase('/brand/Imagotipo-logo.svg')} alt="Mobile One" data-gsap-animate="fade-up" />
    {eyebrow && <p class="sslide__eyebrow" data-gsap-animate="fade-up">{eyebrow}</p>}
    <h2 class="sslide__title" data-gsap-animate="fade-up">{title}</h2>
  </div>

  <div class="sslide__pin" data-sslide-pin>
    <div class="sslide__track" data-sslide-track>
      {list.map((p) => (
        <article class="sslide__panel" data-sslide-panel>
          <div class="sslide__frame">
            <img class="sslide__img" src={withBase(p.image)} alt={p.alt} />
          </div>
          <div class="sslide__copy">
            <span class="sslide__num">{p.num}</span>
            <h3 class="sslide__heading">{p.heading}</h3>
            <p class="sslide__text">{p.text}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);
  ScrollTrigger.config({ ignoreMobileResize: true });

  function initSlide() {
    const section = document.querySelector('[data-gsap-section="sslide"]');
    if (!section) return;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!reduced) {
      gsap.from(section.querySelectorAll('[data-gsap-animate="fade-up"]'), {
        opacity: 0,
        y: 16,
        duration: 0.6,
        stagger: 0.08,
        ease: 'power2.out',
        scrollTrigger: { trigger: section, start: 'top 82%' },
      });
    }

    const pinEl = section.querySelector('[data-sslide-pin]');
    const track = section.querySelector('[data-sslide-track]');
    if (!pinEl || !track) return;

    const mm = gsap.matchMedia();

    // Mismo mecanismo en TODOS los tamaños (§15.6.1: la galería horizontal
    // que avanza con el scroll se mantiene en mobile, no se apaga por
    // viewport — solo se desactiva por prefers-reduced-motion). Lenis emite
    // eventos de scroll también con gestos táctiles, así que el scrub
    // reacciona igual al deslizar hacia abajo con el dedo.
    mm.add('(prefers-reduced-motion: no-preference)', () => {
      const getDistance = () => track.scrollWidth - window.innerWidth;

      gsap.to(track, {
        x: () => -getDistance(),
        ease: 'none',
        scrollTrigger: {
          trigger: pinEl,
          start: 'top top',
          end: () => '+=' + getDistance(),
          scrub: 1,
          pin: pinEl,
          anticipatePin: 1,
          invalidateOnRefresh: true,
          // El CTA sticky flotante tapa el copy del panel activo en mobile
          // (pantalla completa, poco alto) — se oculta mientras dura el pin.
          onEnter: () => document.body.classList.add('hide-sticky-cta'),
          onLeave: () => document.body.classList.remove('hide-sticky-cta'),
          onEnterBack: () => document.body.classList.add('hide-sticky-cta'),
          onLeaveBack: () => document.body.classList.remove('hide-sticky-cta'),
        },
      });

      gsap.from(track.querySelectorAll('[data-sslide-panel]'), {
        opacity: 0,
        y: 20,
        duration: 0.6,
        stagger: 0.08,
        scrollTrigger: { trigger: pinEl, start: 'top 90%' },
      });
    });

    // prefers-reduced-motion: sin pin ni desplazamiento lateral — panels en
    // columna, cada uno con un fade-up simple al entrar en viewport.
    mm.add('(prefers-reduced-motion: reduce)', () => {
      track.querySelectorAll('[data-sslide-panel]').forEach((panel) => {
        gsap.from(panel, {
          opacity: 0, y: 24, duration: 0.7, ease: 'power2.out',
          scrollTrigger: { trigger: panel, start: 'top 82%' },
        });
      });
    });
  }

  document.addEventListener('astro:page-load', initSlide);
</script>

<style>
  .sslide { padding-block: var(--space-2xl); background-color: var(--bg-primary); overflow: hidden; }

  .sslide__head { display: grid; gap: var(--space-sm); margin-bottom: var(--space-lg); }
  .sslide__logo { height: 28px; width: auto; margin-bottom: var(--space-xs); }
  .sslide__eyebrow { font-size: var(--text-sm); letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-secondary); }
  .sslide__title { font-family: var(--font-heading); font-size: clamp(2.2rem, 5.2vw, 3.4rem); letter-spacing: -0.02em; max-width: 34ch; }

  .sslide__pin { height: 100vh; display: flex; align-items: center; }
  .sslide__track {
    display: flex;
    will-change: transform;
    padding-inline-start: max(var(--container-pad), calc((100vw - var(--content-max-xl)) / 2));
    padding-inline-end: var(--space-xl);
  }

  .sslide__panel {
    flex: 0 0 auto;
    width: min(56vw, 620px);
    margin-right: var(--space-xl);
    display: grid;
    gap: var(--space-md);
  }
  .sslide__frame {
    width: 100%;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
  }
  .sslide__img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .sslide__copy { display: grid; gap: var(--space-sm); }
  .sslide__num {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    color: var(--accent);
  }
  .sslide__heading {
    font-family: var(--font-heading);
    font-size: clamp(1.6rem, 2.8vw, 2.2rem);
    letter-spacing: -0.01em;
    color: var(--text-primary);
  }
  .sslide__text { font-size: var(--text-lg); color: var(--text-secondary); line-height: 1.6; max-width: 40ch; }

  /* El pin fija la sección a 100vh — si el panel (imagen + copy) mide más
     que eso, el centrado vertical corta imagen arriba y texto abajo. Se
     achica todo (panel más angosto, imagen menos alta, tipografía y
     espaciados menores) para que el conjunto quepa cómodo. */
  @media (max-width: 767px) {
    .sslide__panel { width: 78vw; gap: var(--space-xs); }
    .sslide__frame { aspect-ratio: 3 / 2; }
    .sslide__copy { gap: 6px; }
    .sslide__num { font-size: var(--text-lg); }
    .sslide__heading { font-size: clamp(1.3rem, 5.5vw, 1.6rem); line-height: 1.15; }
    .sslide__text { font-size: var(--text-sm); line-height: 1.45; }
  }

  /* Sin motion: sin pin ni desplazamiento lateral — panels en columna. */
  @media (prefers-reduced-motion: reduce) {
    .sslide__pin { height: auto; display: block; }
    .sslide__track { flex-direction: column; padding-inline: var(--container-pad); }
    .sslide__panel { width: 100%; margin-right: 0; margin-bottom: var(--space-xl); }
    .sslide__panel:last-child { margin-bottom: 0; }
  }
</style>
