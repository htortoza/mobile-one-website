---
// src/components/home/SocialProofStat.astro
// Home §4.8 — Prueba social honesta. Sin testimonios/cifras inventadas (doc §9 / §12.4):
// el único dato real disponible hoy es cualitativo ("horas, no semanas"), no una cifra —
// se muestra tipográficamente grande en vez de forzar un count-up de un número inventado.
const { title, statLabel, statText, note } = Astro.props;
---

<section class="proof" data-gsap-section="proof">
  <div class="container proof__inner">
    <h2 class="proof__title" data-gsap-animate="fade-up">{title}</h2>

    <p class="proof__label">{statLabel}</p>
    <p class="proof__stat" data-gsap-split="words">{statText}</p>

    <div class="proof__placeholders">
      <span class="proof__placeholder">Próximamente: casos de moda y calzado</span>
      <span class="proof__placeholder">Próximamente: casos de retail multitienda</span>
    </div>

    <p class="proof__note">{note}</p>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Typing orgánico: título, label y stat se escriben letra a letra con un cursor
  // que lo sigue. Ritmo humanizado (jitter por letra + pausas en espacios y
  // puntuación), cada letra entra con un leve lift y "tinta fresca" (nace en
  // el acento y decanta a su color final). El texto ya ocupa su espacio desde
  // el inicio (letras en opacity 0), así que nada se reacomoda al escribir.

  // Parte cada nodo de texto en palabras (nowrap, para no cortar palabras) y
  // letras. Deja una copia accesible del texto completo.
  function splitChars(el) {
    const text = el.textContent.trim();
    const chars = [];
    const walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT);
    const nodes = [];
    while (walker.nextNode()) if (walker.currentNode.textContent.trim()) nodes.push(walker.currentNode);
    nodes.forEach((node) => {
      const frag = document.createDocumentFragment();
      node.textContent.split(/(\s+)/).forEach((part) => {
        if (!part) return;
        if (/^\s+$/.test(part)) { frag.append(' '); return; }
        const word = document.createElement('span');
        word.className = 'proof__w';
        word.setAttribute('aria-hidden', 'true');
        [...part].forEach((ch) => {
          const c = document.createElement('span');
          c.className = 'proof__ch';
          c.textContent = ch;
          word.append(c);
          chars.push(c);
        });
        frag.append(word);
      });
      node.replaceWith(frag);
    });
    const sr = document.createElement('span');
    sr.className = 'proof__sr';
    sr.textContent = text;
    el.append(sr);
    return chars;
  }

  function initProof() {
    const section = document.querySelector('[data-gsap-section="proof"]');
    if (!section || section.dataset.typed || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    section.dataset.typed = '1';

    const accent = getComputedStyle(section).getPropertyValue('--accent').trim() || 'blue';
    const q = (s) => section.querySelector(s);
    // Orden de escritura y ritmo (ms por letra) de cada pieza.
    const steps = [
      { el: q('.proof__title'), ms: 15 },
      { el: q('.proof__label'), ms: 12, gap: 200 },
      { el: q('.proof__stat'), ms: 52, gap: 160, comma: 300, ink: false },
    ].filter((st) => st.el);
    // El resto (etiquetas "Próximamente" + nota) no se tipea: reveal simple
    // apenas termina "Horas, no semanas."
    const rest = [...section.querySelectorAll('.proof__placeholder'), q('.proof__note')].filter(Boolean);
    gsap.set(rest, { opacity: 0, y: 16 });

    const caret = document.createElement('span');
    caret.className = 'proof__caret';
    caret.setAttribute('aria-hidden', 'true');

    const tl = gsap.timeline({ paused: true });
    let t = 0;
    const jitter = () => gsap.utils.random(0.55, 1.45);

    steps.forEach((st) => {
      const chars = splitChars(st.el);
      gsap.set(chars, { opacity: 0, yPercent: 35 });
      t += (st.gap ?? 0) / 1000;
      // el cursor salta a la pieza y toma su tamaño/color
      tl.call(() => { st.el.prepend(caret); caret.classList.add('is-typing'); }, null, t);
      chars.forEach((c) => {
        const final = getComputedStyle(c).color;
        tl.call(() => c.after(caret), null, t);
        tl.to(c, { opacity: 1, yPercent: 0, duration: 0.32, ease: 'power3.out' }, t);
        if (st.ink !== false) tl.fromTo(c, { color: accent }, { color: final, duration: 0.6, ease: 'power1.out' }, t);
        const ch = c.textContent;
        let d = (st.ms / 1000) * jitter();
        if (ch === ',' ) d += (st.comma ?? 140) / 1000;
        else if (/[.:;?!]/.test(ch)) d += st.ms > 40 ? 0.2 : 0.1;
        if (c === c.parentElement.lastElementChild) d += (st.ms / 1000) * 1.2; // respiro entre palabras
        t += d;
      });
    });
    const revealAt = t + 0.35;
    tl.to(rest, { opacity: 1, y: 0, duration: 0.9, stagger: 0.12, ease: 'power3.out' }, revealAt);
    // Todo revelado → se libera el scroll (no espera al fade del cursor).
    tl.call(() => { revealed = true; unlockScroll(); }, null, revealAt + 0.9 + 0.12 * Math.max(0, rest.length - 1));
    // cierre: el cursor parpadea y se apaga
    tl.call(() => caret.classList.remove('is-typing'), null, t);
    tl.to(caret, { opacity: 0, duration: 0.4, delay: 1.8 }, t);

    ScrollTrigger.create({ trigger: section, start: 'top 72%', once: true, onEnter: () => tl.play() });

    // Scroll congelado: al bajar, cuando el bloque llega al centro de la
    // pantalla y el texto aún no terminó de revelarse, la página se detiene
    // ahí (Lenis stop: bloquea rueda y touch; + teclas) y sigue sola al
    // terminar. Solo una vez y solo bajando; hacia arriba nunca bloquea.
    let revealed = false;
    let locked = false;
    const SCROLL_KEYS = [' ', 'PageDown', 'PageUp', 'ArrowDown', 'ArrowUp', 'Home', 'End'];
    const blockKeys = (e) => { if (SCROLL_KEYS.includes(e.key)) e.preventDefault(); };
    const blockNative = (e) => { if (e.cancelable) e.preventDefault(); };
    function lockScroll(y) {
      if (locked || revealed) return;
      locked = true;
      const lenis = window.__lenis;
      if (lenis) {
        lenis.scrollTo(y, { immediate: true, force: true });
        lenis.stop();
      } else {
        window.scrollTo(0, y);
      }
      window.addEventListener('keydown', blockKeys);
      window.addEventListener('wheel', blockNative, { passive: false });
      window.addEventListener('touchmove', blockNative, { passive: false });
    }
    function unlockScroll() {
      if (!locked) return;
      locked = false;
      window.__lenis?.start();
      window.removeEventListener('keydown', blockKeys);
      window.removeEventListener('wheel', blockNative);
      window.removeEventListener('touchmove', blockNative);
    }
    ScrollTrigger.create({
      trigger: section.querySelector('.proof__inner'),
      start: 'center center',
      once: true,
      onEnter: (self) => {
        if (revealed) return;
        if (!tl.isActive() && tl.progress() === 0) tl.play(); // llegó muy rápido
        lockScroll(self.start);
      },
    });
    document.addEventListener('astro:before-swap', unlockScroll, { once: true });
  }

  document.addEventListener('astro:page-load', initProof);
</script>

<style>
  .proof { padding-block: var(--space-2xl); background-color: var(--bg-primary); text-align: center; }
  .proof__inner { display: grid; gap: var(--space-sm); justify-items: center; }
  .proof__title {
    font-family: var(--font-heading);
    font-size: clamp(1.9rem, 4.6vw, 2.8rem);
    letter-spacing: -0.02em;
  }
  .proof__label {
    font-size: var(--text-sm);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-secondary);
    margin-top: var(--space-md);
  }
  .proof__stat {
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 9vw, 5.5rem);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--accent);
  }
  /* Typing — spans creados por JS (sin scope de Astro → :global) */
  .proof :global(.proof__w) { display: inline-block; white-space: nowrap; }
  .proof :global(.proof__ch) { display: inline-block; white-space: pre; will-change: transform, opacity; }
  .proof :global(.proof__sr) {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  /* Cursor de ancho neto 0 (margin negativo): no empuja el texto al moverse */
  .proof :global(.proof__caret) {
    display: inline-block;
    width: 0.07em;
    min-width: 2px;
    height: 0.95em;
    margin-right: -0.07em;
    vertical-align: -0.12em;
    border-radius: 1px;
    background-color: var(--accent);
    animation: proof-blink 1s steps(1) infinite;
  }
  .proof :global(.proof__caret.is-typing) { animation: none; }
  @keyframes proof-blink { 50% { opacity: 0; } }

  .proof__placeholders {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-sm);
    margin-top: var(--space-lg);
  }
  .proof__placeholder {
    font-size: var(--text-xs);
    color: var(--text-secondary);
    border: 1px dashed var(--border);
    padding: var(--space-xs) var(--space-md);
    border-radius: var(--radius-full);
  }

  .proof__note { font-size: var(--text-sm); color: var(--text-secondary); max-width: 46ch; margin-top: var(--space-md); }
</style>
