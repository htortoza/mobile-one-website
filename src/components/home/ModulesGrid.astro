---
// src/components/home/ModulesGrid.astro
// Home — Los 5 módulos de Mobile One + la caja de escritorio (nuevo).
// Copy tomado del "Plan sitio Mobile One" (nov 2026). Sin cifras ni integraciones inventadas.
import { withBase } from '../../utils/base.js';
const { eyebrow, title, intro, modules, desk } = Astro.props;
const list = modules ?? [];
---

<section class="mods" data-gsap-section="mods">
  <div class="container mods__head">
    {eyebrow && <p class="mods__eyebrow" data-gsap-animate="fade-up">{eyebrow}</p>}
    <h2 class="mods__title" data-gsap-animate="fade-up">{title}</h2>
    {intro && <p class="mods__intro" data-gsap-animate="fade-up">{intro}</p>}
  </div>

  <div class="container mods__grid">
    {list.map((m, i) => (
      <article class="mods__card" data-mods-card>
        <span class="mods__num">{String(i + 1).padStart(2, '0')}</span>
        <h3 class="mods__name">{m.name}</h3>
        <p class="mods__text">{m.text}</p>
      </article>
    ))}

    {desk && (
      <article class="mods__card mods__card--desk" data-mods-card>
        <div class="mods__desk-copy">
          <span class="mods__badge">{desk.badge}</span>
          <h3 class="mods__name">{desk.name}</h3>
          <p class="mods__text">{desk.text}</p>
          {desk.points && (
            <ul class="mods__points" role="list">
              {desk.points.map((p) => <li>{p}</li>)}
            </ul>
          )}
        </div>
        {desk.image && (
          <div class="mods__desk-frame">
            <img src={withBase(desk.image)} alt={desk.alt ?? ''} loading="lazy" />
          </div>
        )}
      </article>
    )}
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initMods() {
    const section = document.querySelector('[data-gsap-section="mods"]');
    if (!section || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    gsap.from(section.querySelectorAll('[data-gsap-animate="fade-up"]'), {
      opacity: 0, y: 16, duration: 0.6, stagger: 0.08, ease: 'power2.out',
      scrollTrigger: { trigger: section, start: 'top 82%' },
    });
    gsap.from(section.querySelectorAll('[data-mods-card]'), {
      opacity: 0, y: 24, duration: 0.7, stagger: 0.08, ease: 'expo.out',
      scrollTrigger: { trigger: section, start: 'top 70%' },
    });
  }

  document.addEventListener('astro:page-load', initMods);
</script>

<style>
  .mods { padding-block: var(--space-xl); background-color: var(--bg-primary); }
  .mods__head { display: grid; gap: var(--space-sm); margin-bottom: var(--space-lg); }
  .mods__eyebrow { font-size: var(--text-sm); letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-secondary); }
  .mods__title { font-family: var(--font-heading); font-size: clamp(2.2rem, 5.2vw, 3.4rem); letter-spacing: -0.02em; max-width: 24ch; }
  .mods__intro { font-size: var(--text-lg); color: var(--text-secondary); line-height: 1.6; max-width: 56ch; }

  .mods__grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-sm); }
  .mods__card {
    display: grid; gap: var(--space-xs); align-content: start; min-width: 0;
    padding: var(--space-md); border-radius: var(--radius-lg);
    background-color: var(--bg-secondary); border: 1px solid var(--border);
  }
  .mods__num { font-size: var(--text-sm); letter-spacing: 0.12em; color: var(--accent); font-weight: 500; }
  .mods__name { font-family: var(--font-heading); font-size: var(--text-xl); letter-spacing: -0.01em; color: var(--navy); }
  .mods__text { font-size: var(--text-base); color: var(--text-secondary); line-height: 1.6; }

  /* Caja de escritorio: tarjeta destacada con la paleta de marca */
  .mods__card--desk {
    background: var(--accent-gradient); border-color: transparent; color: var(--on-accent);
    gap: var(--space-md);
  }
  .mods__card--desk .mods__name { color: var(--on-accent); font-size: clamp(1.8rem, 3.4vw, 2.4rem); }
  .mods__card--desk .mods__text { color: color-mix(in srgb, var(--on-accent) 88%, transparent); font-size: var(--text-lg); max-width: 46ch; }
  .mods__desk-copy { display: grid; gap: var(--space-xs); align-content: center; min-width: 0; }
  .mods__badge {
    justify-self: start; padding: 2px 10px; border-radius: var(--radius-full);
    font-size: var(--text-xs); letter-spacing: 0.1em; text-transform: uppercase;
    background: color-mix(in srgb, var(--on-accent) 20%, transparent);
  }
  .mods__points { list-style: none; display: grid; gap: 6px; margin-top: var(--space-xs); font-size: var(--text-base); }
  .mods__points li::before { content: '✓'; margin-right: 8px; }
  /* Imagen recortada (fondo transparente): sin marco, solo sombra proyectada */
  .mods__desk-frame { min-width: 0; display: grid; justify-items: center; }
  .mods__desk-frame img { width: min(100%, 560px); height: auto; display: block; filter: drop-shadow(0 18px 28px rgba(0,0,0,0.28)); }

  @media (min-width: 700px) {
    .mods__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .mods__card--desk { grid-column: 1 / -1; }
  }
  @media (min-width: 1024px) {
    .mods__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-md); }
    .mods__card--desk { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); align-items: center; padding: var(--space-lg); }
  }
</style>
