---
// src/components/home/ArchitectureTeaser.astro
// Home §4.7 — Arquitectura (teaser). Esquema real de integración: entradas
// (lo que el cliente ya tiene) a la izquierda, Mobile One Core como hub al
// centro, salidas a la derecha — conectados con cables SVG + paquetes que
// viajan (§16.3/§21.3). Logos reales donde existen (Transbank/Getnet/
// Mercado Pago, ya usados en BrandCompat); el resto son wordmarks de texto,
// no logos fabricados.
import { withBase } from '../../utils/base.js';
const { title, text, badges, inputs, hub, outputs } = Astro.props;
const badgeList = badges ?? [];
const inputList = inputs ?? [];
const outputList = outputs ?? [];
const hubNode = hub ?? { label: 'Mobile One Core' };
---

<section class="arch" data-gsap-section="arch">
  <div class="container arch__head">
    <h2 class="arch__title" data-gsap-animate="fade-up">{title}</h2>
    <p class="arch__text">{text}</p>
    <a href={withBase('/integraciones')} class="arch__link">Ver arquitectura completa →</a>

    {badgeList.length > 0 && (
      <div class="arch__badges">
        {badgeList.map((b) => (
          <span class="arch__badge" data-count-badge>{b}</span>
        ))}
      </div>
    )}
  </div>

  <div class="container arch__diagram" data-arch-diagram>
    <svg class="arch__cables" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
      {inputList.map((_, i) => (
        <>
          <path class="arch__cable" data-arch-cable data-side="in" data-index={i} />
          <path class="arch__beam" data-arch-beam data-side="in" data-index={i} pathLength="100" />
        </>
      ))}
      {outputList.map((_, i) => (
        <>
          <path class="arch__cable" data-arch-cable data-side="out" data-index={i} />
          <path class="arch__beam" data-arch-beam data-side="out" data-index={i} pathLength="100" />
        </>
      ))}
    </svg>

    <div class="arch__col arch__col--in">
      {inputList.map((node, i) => (
        <div class="arch__card" data-arch-card="in" data-arch-index={i}>
          {node.logos && (
            <div class="arch__logos">
              {node.logos.map((logo) => (
                <span class={`arch__logo-chip ${logo.tone ? `arch__logo-chip--${logo.tone}` : ''}`}>
                  <img src={withBase(logo.src)} alt="" />
                </span>
              ))}
            </div>
          )}
          <p class="arch__card-label">{node.label}</p>
          {node.sub && <p class="arch__card-sub">{node.sub}</p>}
        </div>
      ))}
    </div>

    <div class="arch__hub" data-arch-hub>
      <img class="arch__hub-logo" src={withBase('/brand/Imagotipo-logo.svg')} alt="" aria-hidden="true" />
      <p class="arch__hub-label">{hubNode.label}</p>
      {hubNode.sub && <p class="arch__hub-sub">{hubNode.sub}</p>}
    </div>

    <div class="arch__col arch__col--out">
      {outputList.map((node, i) => (
        <div class="arch__card" data-arch-card="out" data-arch-index={i}>
          {node.logos && (
            <div class="arch__logos">
              {node.logos.map((logo) => (
                <span class={`arch__logo-chip ${logo.tone ? `arch__logo-chip--${logo.tone}` : ''}`}>
                  <img src={withBase(logo.src)} alt="" />
                </span>
              ))}
            </div>
          )}
          <p class="arch__card-label">{node.label}</p>
          {node.sub && <p class="arch__card-sub">{node.sub}</p>}
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Calcula el trazo real de cada cable a partir de la posición en pantalla
  // de cada card y del hub (no coordenadas % adivinadas): así el cable
  // siempre nace y termina exactamente en el borde de la card/hub, sin
  // importar cuánto midan las columnas del grid en cada viewport.
  function layoutCables(diagram) {
    const svg = diagram.querySelector('.arch__cables');
    const hub = diagram.querySelector('[data-arch-hub]');
    if (!svg || !hub) return;

    // Posiciones de layout (offset*), no getBoundingClientRect: las cards
    // entran con transform (x/scale de GSAP) y el cable debe apuntar a su
    // posición final, no a la del frame en que se mide.
    const rectOf = (el) => {
      let x = 0, y = 0, e = el;
      while (e && e !== diagram) { x += e.offsetLeft; y += e.offsetTop; e = e.offsetParent; }
      return { left: x, top: y, right: x + el.offsetWidth, bottom: y + el.offsetHeight, width: el.offsetWidth, height: el.offsetHeight };
    };
    const box = { left: 0, top: 0, width: diagram.offsetWidth, height: diagram.offsetHeight };
    if (!box.width || !box.height) return;
    const px = (x) => ((x - box.left) / box.width) * 100;
    const py = (y) => ((y - box.top) / box.height) * 100;
    const pt = (x, y) => `${px(x)} ${py(y)}`;
    const setPath = (side, i, d) =>
      svg.querySelectorAll(`[data-side="${side}"][data-index="${i}"]`).forEach((p) => p.setAttribute('d', d));

    const hubBox = rectOf(hub);

    // Desktop: entradas a la izquierda → hub → salidas a la derecha.
    if (window.innerWidth >= 1024) {
      const hubL = { x: hubBox.left, y: hubBox.top + hubBox.height / 2 };
      const hubR = { x: hubBox.right, y: hubL.y };
      diagram.querySelectorAll('[data-arch-card="in"]').forEach((card) => {
        const c = rectOf(card);
        const s0 = { x: c.right, y: c.top + c.height / 2 };
        const mx = (s0.x + hubL.x) / 2;
        setPath('in', card.dataset.archIndex, `M ${pt(s0.x, s0.y)} C ${pt(mx, s0.y)}, ${pt(mx, hubL.y)}, ${pt(hubL.x, hubL.y)}`);
      });
      diagram.querySelectorAll('[data-arch-card="out"]').forEach((card) => {
        const c = rectOf(card);
        const e = { x: c.left, y: c.top + c.height / 2 };
        const mx = (hubR.x + e.x) / 2;
        setPath('out', card.dataset.archIndex, `M ${pt(hubR.x, hubR.y)} C ${pt(mx, hubR.y)}, ${pt(mx, e.y)}, ${pt(e.x, e.y)}`);
      });
      return;
    }

    // Mobile/tablet — "línea de metro": un riel vertical a la izquierda. Cada
    // entrada se engancha al riel, el riel baja y entra al hub por arriba
    // (todas se unen); del hub sale por abajo, vuelve al riel y reparte a
    // cada salida. Los trazos siguen el sentido del flujo para los rayos.
    const firstCard = diagram.querySelector('[data-arch-card]');
    const railX = rectOf(firstCard).left - 22;
    const r = 12; // radio de las curvas de enganche
    const hubCx = hubBox.left + hubBox.width / 2;
    const hubTop = hubBox.top;
    const hubBottom = hubBox.bottom;
    const bend = Math.min(56, (hubTop - box.top) / 4);

    diagram.querySelectorAll('[data-arch-card="in"]').forEach((card) => {
      const c = rectOf(card);
      const y = c.top + c.height / 2;
      setPath('in', card.dataset.archIndex, [
        `M ${pt(c.left, y)}`,
        `L ${pt(railX + r, y)}`,
        `Q ${pt(railX, y)} ${pt(railX, y + r)}`,
        `L ${pt(railX, hubTop - bend)}`,
        `C ${pt(railX, hubTop - bend / 3)}, ${pt(hubCx, hubTop - bend)}, ${pt(hubCx, hubTop)}`,
      ].join(' '));
    });
    diagram.querySelectorAll('[data-arch-card="out"]').forEach((card) => {
      const c = rectOf(card);
      const y = c.top + c.height / 2;
      setPath('out', card.dataset.archIndex, [
        `M ${pt(hubCx, hubBottom)}`,
        `C ${pt(hubCx, hubBottom + bend)}, ${pt(railX, hubBottom + bend / 3)}, ${pt(railX, hubBottom + bend)}`,
        `L ${pt(railX, y - r)}`,
        `Q ${pt(railX, y)} ${pt(railX + r, y)}`,
        `L ${pt(c.left, y)}`,
      ].join(' '));
    });
  }

  function initArch() {
    const section = document.querySelector('[data-gsap-section="arch"]');
    if (!section) return;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    gsap.from(section.querySelectorAll('[data-count-badge]'), {
      opacity: 0, y: 16, duration: 0.5, stagger: 0.08, ease: 'expo.out',
      scrollTrigger: { trigger: section, start: 'top 78%' },
    });

    const diagram = section.querySelector('[data-arch-diagram]');
    if (!diagram) return;

    layoutCables(diagram);
    const onResize = () => layoutCables(diagram);
    window.addEventListener('resize', onResize);
    // Los logos pueden terminar de cargar después del layout inicial y
    // cambiar la altura de las cards — se recalcula una vez más al asentarse.
    window.addEventListener('load', onResize, { once: true });
    document.addEventListener('astro:before-swap', () => window.removeEventListener('resize', onResize), { once: true });

    if (reduced) return;

    const mm = gsap.matchMedia();
    mm.add('(min-width: 1024px)', () => {
      gsap.from(section.querySelectorAll('[data-arch-card]'), {
        opacity: 0, y: 16, duration: 0.5, stagger: 0.07, ease: 'expo.out',
        scrollTrigger: { trigger: diagram, start: 'top 75%' },
      });
      gsap.from(section.querySelector('[data-arch-hub]'), {
        opacity: 0, scale: 0.85, duration: 0.6, ease: 'back.out(1.6)',
        scrollTrigger: { trigger: diagram, start: 'top 72%' },
      });
    });
    // Mobile: el flujo se arma en orden al bajar — cada entrada se engancha
    // desde el riel, el hub aparece, y luego cada salida.
    mm.add('(max-width: 1023px)', () => {
      section.querySelectorAll('[data-arch-card], [data-arch-hub]').forEach((el) => {
        const isHub = el.hasAttribute('data-arch-hub');
        gsap.from(el, {
          opacity: 0,
          x: isHub ? 0 : -18,
          scale: isHub ? 0.88 : 1,
          duration: isHub ? 0.8 : 0.7,
          ease: isHub ? 'back.out(1.5)' : 'power3.out',
          scrollTrigger: { trigger: el, start: 'top 85%' },
        });
      });
    });

    ScrollTrigger.addEventListener('refresh', () => layoutCables(diagram));

    section.querySelectorAll('[data-arch-cable]').forEach((cable) => {
      gsap.fromTo(cable, { opacity: 0 }, {
        opacity: 1, duration: 0.6,
        scrollTrigger: { trigger: diagram, start: 'top 70%' },
      });
    });

    // Rayo de luz: un segmento corto y brillante que recorre el cable en loop,
    // usando pathLength=100 para que el dasharray sea en % sin medir el path.
    section.querySelectorAll('[data-arch-beam]').forEach((beam) => {
      gsap.set(beam, { attr: { 'stroke-dasharray': '16 100', 'stroke-dashoffset': 0 } });
      gsap.to(beam, {
        attr: { 'stroke-dashoffset': -116 },
        duration: 1.6,
        repeat: -1,
        delay: gsap.utils.random(0, 1.2),
        ease: 'power1.inOut',
        scrollTrigger: { trigger: diagram, start: 'top 85%', end: 'bottom top' },
      });
    });
  }

  document.addEventListener('astro:page-load', initArch);
</script>

<style>
  .arch { padding-block: var(--space-2xl); background-color: var(--bg-secondary); }
  .arch__head { display: grid; gap: var(--space-sm); margin-bottom: var(--space-xl); max-width: 70ch; margin-inline: auto; justify-items: center; text-align: center; }
  .arch__title {
    font-family: var(--font-heading);
    font-size: clamp(2.2rem, 5.4vw, 3.6rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  .arch__text { font-size: var(--text-lg); color: var(--text-secondary); line-height: 1.6; }
  .arch__link { color: var(--accent); font-weight: 600; text-decoration: none; }

  .arch__badges { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-sm); margin-top: var(--space-sm); }
  .arch__badge {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--navy);
    background-color: var(--bg-primary);
    border: 1px solid var(--border);
    padding: var(--space-xs) var(--space-md);
    border-radius: var(--radius-full);
  }

  .arch__diagram {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
    padding-block: var(--space-lg);
  }
  .arch__cables { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0; overflow: visible; pointer-events: none; }
  .arch__cable { stroke: var(--border); stroke-width: 1.4; fill: none; opacity: 0; vector-effect: non-scaling-stroke; }
  .arch__beam {
    stroke: var(--accent-hover);
    stroke-width: 2.2;
    stroke-linecap: round;
    fill: none;
    vector-effect: non-scaling-stroke;
    filter: drop-shadow(0 0 4px color-mix(in srgb, var(--accent) 75%, transparent));
  }

  .arch__col { position: relative; z-index: 1; display: grid; gap: var(--space-md); min-width: 0; }

  .arch__card {
    background-color: var(--bg-primary);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-md);
    display: grid;
    gap: var(--space-xs);
  }
  .arch__card-label { font-family: var(--font-heading); font-size: var(--text-base); color: var(--text-primary); }
  .arch__card-sub { font-size: var(--text-sm); color: var(--text-secondary); }

  .arch__logos { display: flex; flex-wrap: wrap; gap: var(--space-xs); margin-bottom: var(--space-xs); }
  .arch__logo-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 28px;
    padding-inline: 8px;
    border-radius: var(--radius-sm);
    background-color: var(--bg-secondary);
  }
  .arch__logo-chip img { height: 14px; width: auto; display: block; }
  .arch__logo-chip--transbank { background-color: var(--tone-transbank); }
  .arch__logo-chip--getnet { background-color: var(--tone-getnet); }
  .arch__logo-chip--light { background-color: var(--bg-secondary); }
  .arch__logo-chip--light img { height: 18px; }

  .arch__hub {
    position: relative;
    z-index: 1;
    justify-self: center;
    align-self: center;
    width: 100%;
    max-width: 260px;
    min-height: 208px;
    border-radius: 36px;
    background: var(--accent-gradient);
    color: var(--on-accent);
    display: grid;
    align-content: center;
    justify-items: center;
    gap: var(--space-sm);
    padding: var(--space-lg) var(--space-md);
    text-align: center;
    box-shadow: var(--shadow-lg);
  }
  .arch__hub-logo { height: 24px; width: auto; filter: brightness(0) invert(1); margin-bottom: var(--space-xs); }
  .arch__hub-label { font-family: var(--font-heading); font-size: var(--text-lg); line-height: 1.3; max-width: 18ch; }
  .arch__hub-sub { font-size: var(--text-sm); color: color-mix(in srgb, var(--on-accent) 82%, transparent); }

  /* Mobile/tablet — "línea de metro": cards indentadas para dejar el riel a
     la izquierda, con un nodo donde cada card se engancha; el hub recibe el
     riel arriba y lo devuelve abajo (nodos en sus bordes). */
  @media (max-width: 1023px) {
    .arch__diagram { gap: var(--space-lg); }
    .arch__col { padding-left: 1.75rem; gap: var(--space-sm); }
    .arch__card { position: relative; z-index: 1; }
    .arch__card::before {
      content: '';
      position: absolute;
      left: -5px;
      top: 50%;
      width: 9px;
      height: 9px;
      margin-top: -4.5px;
      border-radius: var(--radius-full);
      background-color: var(--accent);
      box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 18%, transparent);
    }
    .arch__hub { min-height: 168px; }
    .arch__hub::before,
    .arch__hub::after {
      content: '';
      position: absolute;
      left: 50%;
      width: 11px;
      height: 11px;
      margin-left: -5.5px;
      border-radius: var(--radius-full);
      background-color: var(--bg-primary);
      border: 3px solid var(--accent);
    }
    .arch__hub::before { top: -5.5px; }
    .arch__hub::after { bottom: -5.5px; }
    .arch__cable { stroke: color-mix(in srgb, var(--accent) 28%, transparent); stroke-width: 1.6; }
  }

  @media (min-width: 1024px) {
    .arch__diagram { grid-template-columns: 1fr 260px 1fr; align-items: center; gap: var(--space-2xl); }
    .arch__col--out { justify-items: end; }
    .arch__col--out .arch__card { text-align: right; justify-items: end; }
  }
</style>
