---
// src/components/home/CtaClose.astro
// Home §4.9 — CTA de cierre. Bookend azul con Hero/4.3 (mismo bg-pattern-m).
// Opcional: franja de logos de clientes bajo los botones (marquee sutil, con
// fade en los bordes), eco del strip del hero.
import { withBase } from '../../utils/base.js';
const { title, body, ctaText, ctaHref, ctaSecondaryText, ctaSecondaryHref, logos, logosLabel } = Astro.props;
const logoList = logos ?? [];
---

<section class="cta-close bg-pattern-m" data-gsap-section="cta-close">
  <div class="container cta-close__inner" data-gsap-animate="cta-content">
    <h2 class="cta-close__title">{title}</h2>
    <p class="cta-close__body">{body}</p>
    <div class="cta-close__actions">
      <a href={withBase(ctaHref)} class="cta-close__btn cta-close__btn--primary">{ctaText}</a>
      {ctaSecondaryText && <a href={withBase(ctaSecondaryHref)} class="cta-close__btn cta-close__btn--ghost">{ctaSecondaryText}</a>}
    </div>

    {logoList.length > 0 && (
      <div class="cta-close__logos" data-cta-logos>
        {logosLabel && <p class="cta-close__logos-label">{logosLabel}</p>}
        <div class="cta-close__marquee" aria-hidden="true">
          <div class="cta-close__track">
            {logoList.map((l) => <img src={withBase(l.src)} alt="" class="cta-close__logo" loading="lazy" />)}
            {logoList.map((l) => <img src={withBase(l.src)} alt="" class="cta-close__logo" loading="lazy" data-logo-dupe />)}
          </div>
        </div>
        <p class="cta-close__sr">{logoList.map((l) => l.alt).join(' · ')}</p>
      </div>
    )}
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initCtaClose() {
    const section = document.querySelector('[data-gsap-section="cta-close"]');
    const content = section && section.querySelector('[data-gsap-animate="cta-content"]');
    if (!section || !content) return;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!reduced) {
      gsap.from(content, {
        y: 32,
        opacity: 0,
        duration: 1,
        ease: 'expo.out',
        scrollTrigger: { trigger: section, start: 'top 80%' },
      });

      const logos = section.querySelector('[data-cta-logos]');
      if (logos) {
        gsap.from(logos, {
          opacity: 0, y: 16, duration: 1, delay: 0.25, ease: 'power3.out',
          scrollTrigger: { trigger: section, start: 'top 70%' },
        });
      }

      const btn = section.querySelector('.cta-close__btn--primary');
      if (btn) {
        const pulse = () => {
          gsap.timeline()
            .to(btn, { scale: 1.06, duration: 0.18, ease: 'power2.out' })
            .to(btn, { scale: 1, duration: 0.55, ease: 'elastic.out(1, 0.3)' });
        };
        let timeout = setTimeout(() => {
          pulse();
          const interval = setInterval(pulse, 8000);
          document.addEventListener('astro:before-swap', () => clearInterval(interval), { once: true });
        }, 3000);
        document.addEventListener('astro:before-swap', () => clearTimeout(timeout), { once: true });
      }
    }
  }

  document.addEventListener('astro:page-load', initCtaClose);
</script>

<style>
  .cta-close { padding-block: var(--space-2xl); color: var(--on-accent); }
  .cta-close.bg-pattern-m { background-image: var(--accent-gradient); }
  .cta-close__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-lg);
  }
  .cta-close__title {
    font-family: var(--font-heading);
    font-size: clamp(2.4rem, 7vw, 4.5rem);
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .cta-close__body { font-size: var(--text-lg); color: color-mix(in srgb, var(--on-accent) 88%, transparent); max-width: 50ch; }
  .cta-close__actions { display: flex; flex-wrap: wrap; gap: var(--space-sm); }

  .cta-close__btn {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--text-base);
    padding: var(--space-sm) var(--space-lg);
    border-radius: var(--radius-full);
    text-decoration: none;
    transition: transform var(--transition-fast);
  }
  .cta-close__btn--primary { background-color: var(--on-accent); color: var(--accent-hover); }
  .cta-close__btn--primary:hover { transform: translateY(-2px); }
  .cta-close__btn--ghost {
    color: var(--on-accent);
    border: 1px solid color-mix(in srgb, var(--on-accent) 45%, transparent);
  }

  /* Franja de clientes: separada por una regla fina, marquee lento con fade
     en los bordes; logos blancos atenuados (se encienden al pasar el cursor). */
  .cta-close__logos {
    width: 100%;
    display: grid;
    gap: var(--space-md);
    margin-top: var(--space-md);
    padding-top: var(--space-lg);
    border-top: 1px solid color-mix(in srgb, var(--on-accent) 18%, transparent);
  }
  .cta-close__logos-label {
    font-size: var(--text-sm);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--on-accent) 72%, transparent);
  }
  .cta-close__marquee {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, black 10%, black 90%, transparent);
    mask-image: linear-gradient(90deg, transparent, black 10%, black 90%, transparent);
  }
  .cta-close__track {
    display: flex;
    align-items: center;
    gap: var(--space-xl);
    width: max-content;
    animation: cta-close-marquee 38s linear infinite;
  }
  .cta-close__marquee:hover .cta-close__track { animation-play-state: paused; }
  .cta-close__logo { height: 22px; width: auto; opacity: 0.6; transition: opacity var(--transition-fast); }
  .cta-close__logo:hover { opacity: 1; }
  @keyframes cta-close-marquee { to { transform: translateX(-50%); } }
  .cta-close__sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  @media (prefers-reduced-motion: reduce) {
    .cta-close__track { animation: none; flex-wrap: wrap; width: 100%; row-gap: var(--space-md); }
    .cta-close__logo[data-logo-dupe] { display: none; }
    .cta-close__marquee { -webkit-mask-image: none; mask-image: none; }
  }

  @media (max-width: 640px) {
    .cta-close__track { gap: var(--space-lg); }
    .cta-close__logo { height: 18px; }
    .cta-close__actions { flex-direction: column; width: 100%; }
    .cta-close__btn { justify-content: center; }
  }
</style>
