---
// src/components/home/SolutionPair.astro
// Home — Los 2 puntos de SolutionBento que no repiten SolutionSlide
// (promociones + backoffice). Par asimétrico con foto real, no bento de 4
// celdas iguales ni mockup abstracto. Formato distinto a SolutionSlide
// (galería horizontal) y BrandCompat (pin con imagen/color).
const { eyebrow, title, items } = Astro.props;
const list = items ?? [];
---

<section class="spair" data-gsap-section="spair">
  <div class="container spair__head">
    {eyebrow && <p class="spair__eyebrow" data-gsap-animate="fade-up">{eyebrow}</p>}
    <h2 class="spair__title" data-gsap-animate="fade-up">{title}</h2>
  </div>

  <div class="container spair__grid">
    {list.map((item, i) => (
      <article class={`spair__card spair__card--${i}`} data-spair-card>
        <div class="spair__frame">
          <img class="spair__img" src={item.image} alt={item.alt} />
        </div>
        <div class="spair__copy">
          <h3 class="spair__heading">{item.heading}</h3>
          <p class="spair__text">{item.text}</p>
        </div>
      </article>
    ))}
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initPair() {
    const section = document.querySelector('[data-gsap-section="spair"]');
    if (!section || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    gsap.from(section.querySelectorAll('[data-gsap-animate="fade-up"]'), {
      opacity: 0, y: 16, duration: 0.6, stagger: 0.08, ease: 'power2.out',
      scrollTrigger: { trigger: section, start: 'top 82%' },
    });

    gsap.from(section.querySelectorAll('[data-spair-card]'), {
      opacity: 0, y: 24, duration: 0.7, stagger: 0.12, ease: 'expo.out',
      scrollTrigger: { trigger: section, start: 'top 75%' },
    });
  }

  document.addEventListener('astro:page-load', initPair);
</script>

<style>
  .spair { padding-block: var(--space-2xl); background-color: var(--bg-secondary); }
  .spair__head { display: grid; gap: var(--space-sm); margin-bottom: var(--space-lg); }
  .spair__eyebrow { font-size: var(--text-sm); letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-secondary); }
  .spair__title { font-family: var(--font-heading); font-size: clamp(2.2rem, 5.2vw, 3.4rem); letter-spacing: -0.02em; max-width: 34ch; }

  .spair__grid { display: grid; gap: var(--space-lg); }
  .spair__card { display: grid; gap: var(--space-md); }
  .spair__frame { width: 100%; aspect-ratio: 4 / 3; border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-md); }
  .spair__img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .spair__copy { display: grid; gap: var(--space-xs); }
  .spair__heading { font-family: var(--font-heading); font-size: clamp(1.6rem, 2.8vw, 2.1rem); letter-spacing: -0.01em; color: var(--text-primary); }
  .spair__text { font-size: var(--text-lg); color: var(--text-secondary); line-height: 1.6; max-width: 42ch; }

  @media (min-width: 900px) {
    .spair__grid { grid-template-columns: 1.3fr 1fr; align-items: start; }
    .spair__card--1 { margin-top: var(--space-xl); }
  }
</style>
