---
// src/components/Footer.astro
// Chrome global del sitio. Lee contracts/site.json (marca + contacto + links legales).
import site from '../../contracts/site.json';

const year = new Date().getFullYear();
const { siteName } = site.site;
const company = site.company ?? {};
const legalLinks = site.footerLinks ?? [];

const columns = [
  {
    title: 'Producto',
    links: [
      { label: 'POS Mobile',      href: '/producto' },
      { label: 'BackOffice',      href: '/producto' },
      { label: 'Integraciones',   href: '/integraciones' },
      { label: 'Seguridad',       href: '/integraciones' },
    ],
  },
  {
    title: 'Soluciones',
    links: [
      { label: 'Moda y calzado',           href: '/soluciones' },
      { label: 'Electrónica y tecnología', href: '/soluciones' },
      { label: 'Multitienda / holdings',   href: '/soluciones' },
      { label: 'Retail con ERP SAP',       href: '/soluciones' },
    ],
  },
  {
    title: 'Compañía',
    links: [
      { label: 'Nosotros',       href: '/nosotros' },
      { label: 'Casos de éxito', href: '/casos-de-exito' },
      { label: 'Contacto',       href: '/contacto' },
    ],
  },
];
---

<footer class="site-footer">
  <div class="container site-footer__top">
    <div class="site-footer__brand">
      <img src="/brand/Imagotipo-logo.svg" alt={siteName} class="site-footer__logo" />
      <p class="site-footer__tagline">Un producto desarrollado por DOT Solutions.</p>
    </div>

    <div class="site-footer__cols">
      {columns.map((col) => (
        <nav class="site-footer__col" aria-label={col.title}>
          <h3>{col.title}</h3>
          <ul role="list">
            {col.links.map((item) => (
              <li><a href={item.href}>{item.label}</a></li>
            ))}
          </ul>
        </nav>
      ))}

      <div class="site-footer__col">
        <h3>Legal</h3>
        <ul role="list">
          {legalLinks.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
          {company.email && <li><a href={`mailto:${company.email}`}>{company.email}</a></li>}
        </ul>
      </div>
    </div>
  </div>

  <div class="container site-footer__bottom">
    <p>&copy; {year} {company.legalName ?? siteName}. Todos los derechos reservados.</p>
  </div>
</footer>

<style>
  .site-footer {
    padding-top: var(--space-xl);
    padding-bottom: var(--space-lg);
    border-top: 1px solid color-mix(in srgb, var(--border) 60%, transparent);
    background-color: var(--bg-secondary);
  }

  .site-footer__top {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
    padding-bottom: var(--space-lg);
  }

  .site-footer__logo {
    height: 26px;
    width: auto;
    display: block;
  }
  .site-footer__tagline {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    margin-block-start: var(--space-sm);
    max-width: 32ch;
  }

  .site-footer__cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-md);
    min-width: 0;
  }
  .site-footer__col { min-width: 0; }
  .site-footer__col h3 {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--navy);
    margin-bottom: var(--space-sm);
  }
  .site-footer__col ul { list-style: none; display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-xs); }
  .site-footer__col a,
  .site-footer__col span {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    text-decoration: none;
    transition: color var(--transition-fast);
    overflow-wrap: break-word;
  }
  .site-footer__col a:hover { color: var(--accent); }

  .site-footer__bottom {
    padding-top: var(--space-md);
    border-top: 1px solid color-mix(in srgb, var(--border) 40%, transparent);
  }
  .site-footer__bottom p {
    font-size: var(--text-xs);
    color: var(--text-secondary);
  }

  @media (min-width: 1024px) {
    .site-footer__top {
      grid-template-columns: 1fr 2fr;
      align-items: start;
      gap: var(--space-2xl);
    }
    .site-footer__cols { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-lg); }
  }
</style>
