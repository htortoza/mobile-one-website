---
// src/components/Footer.astro
// Chrome global del sitio. Lee contracts/site.json (marca + contacto + links legales).
import site from '../../contracts/site.json';
import { withBase } from '../utils/base.js';

const year = new Date().getFullYear();
const { siteName } = site.site;
const company = site.company ?? {};
const legalLinks = site.footerLinks ?? [];

// Solo se muestran enlaces a páginas que existen. Al publicar una página nueva
// (Integraciones, Seguridad, Casos, Privacidad, Términos…) basta con sumar su ruta aquí.
const LIVE_ROUTES = new Set([
  '/producto', '/integraciones', '/integraciones/erp', '/integraciones/facturacion',
  '/integraciones/medios-de-pago', '/integraciones/erp/sap-business-one', '/integraciones/erp/retail-pro',
  '/integraciones/erp/retail-pro-prism', '/integraciones/medios-de-pago/transbank', '/integraciones/medios-de-pago/getnet',
  '/integraciones/medios-de-pago/mercado-pago', '/integraciones/medios-de-pago/niubiz', '/recursos', '/contacto',
  '/recursos/industrias/moda-y-calzado', '/recursos/industrias/electronica-y-tecnologia',
  '/recursos/industrias/multitienda-y-holdings', '/recursos/industrias/retail-con-erp',
  '/comparativas', '/soluciones/pos-para-sap-business-one', '/soluciones/pos-movil-para-retail',
  '/soluciones/pos-para-tiendas-de-ropa',
]);
const isLive = (href) => LIVE_ROUTES.has(href);

const allColumns = [
  {
    title: 'Producto',
    links: [
      { label: 'POS móvil y caja de pago', href: '/producto' },
      { label: 'Panel de control',         href: '/producto' },
    ],
  },
  {
    title: 'Integraciones',
    links: [
      { label: 'SAP Business One',     href: '/integraciones/erp/sap-business-one' },
      { label: 'Retail Pro',           href: '/integraciones/erp/retail-pro' },
      { label: 'Retail Pro Prism',     href: '/integraciones/erp/retail-pro-prism' },
      { label: 'Medios de pago',       href: '/integraciones/medios-de-pago' },
      { label: 'Facturación electrónica', href: '/integraciones/facturacion' },
    ],
  },
  {
    title: 'Compañía',
    links: [
      { label: 'Recursos', href: '/recursos' },
      { label: 'Comparativas', href: '/comparativas' },
      { label: 'Contacto', href: '/contacto' },
    ],
  },
  {
    title: 'Industrias',
    links: [
      { label: 'Moda y calzado',          href: '/recursos/industrias/moda-y-calzado' },
      { label: 'Electrónica y tecnología', href: '/recursos/industrias/electronica-y-tecnologia' },
      { label: 'Multitienda y holdings',  href: '/recursos/industrias/multitienda-y-holdings' },
      { label: 'Retail con ERP',          href: '/recursos/industrias/retail-con-erp' },
    ],
  },
  {
    title: 'Soluciones',
    links: [
      { label: 'POS para SAP Business One', href: '/soluciones/pos-para-sap-business-one' },
      { label: 'POS móvil para retail',     href: '/soluciones/pos-movil-para-retail' },
      { label: 'POS para tiendas de ropa',  href: '/soluciones/pos-para-tiendas-de-ropa' },
      { label: 'Comparativas',              href: '/comparativas' },
    ],
  },
];
const columns = allColumns
  .map((col) => ({ ...col, links: col.links.filter((l) => isLive(l.href)) }))
  .filter((col) => col.links.length > 0);
const liveLegalLinks = legalLinks.filter((l) => isLive(l.href));
---

<footer class="site-footer">
  <div class="container site-footer__top">
    <div class="site-footer__brand">
      <img src={withBase('/brand/Imagotipo-logo.svg')} alt={siteName} class="site-footer__logo" />
      <p class="site-footer__tagline">Un producto desarrollado por DOT Solutions.</p>
    </div>

    <div class="site-footer__cols">
      {columns.map((col) => (
        <div class="site-footer__col">
          <h3>{col.title}</h3>
          <ul role="list">
            {col.links.map((item) => (
              <li><a href={withBase(item.href)}>{item.label}</a></li>
            ))}
          </ul>
        </div>
      ))}

      <div class="site-footer__col">
        <h3>Legal</h3>
        <ul role="list">
          {liveLegalLinks.map((item) => (
            <li><a href={withBase(item.href)}>{item.label}</a></li>
          ))}
          {company.email && <li><a href={`mailto:${company.email}`}>{company.email}</a></li>}
        </ul>
      </div>
    </div>
  </div>

  <div class="container site-footer__bottom">
    <p>&copy; {year} {company.legalName ?? siteName}. Todos los derechos reservados.</p>
  </div>
</footer>

<style>
  .site-footer {
    padding-top: var(--space-xl);
    padding-bottom: var(--space-lg);
    border-top: 1px solid color-mix(in srgb, var(--border) 60%, transparent);
    background-color: var(--bg-secondary);
  }

  .site-footer__top {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
    padding-bottom: var(--space-lg);
  }

  .site-footer__logo {
    height: 26px;
    width: auto;
    display: block;
  }
  .site-footer__tagline {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    margin-block-start: var(--space-sm);
    max-width: 32ch;
  }

  .site-footer__cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-md);
    min-width: 0;
  }
  .site-footer__col { min-width: 0; }
  .site-footer__col h3 {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--navy);
    margin-bottom: var(--space-sm);
  }
  .site-footer__col ul { list-style: none; display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-xs); }
  .site-footer__col a,
  .site-footer__col span {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    text-decoration: none;
    transition: color var(--transition-fast);
    overflow-wrap: break-word;
  }
  .site-footer__col a:hover { color: var(--accent); }

  .site-footer__bottom {
    padding-top: var(--space-md);
    border-top: 1px solid color-mix(in srgb, var(--border) 40%, transparent);
  }
  .site-footer__bottom p {
    font-size: var(--text-xs);
    color: var(--text-secondary);
  }

  @media (min-width: 1024px) {
    .site-footer__top {
      grid-template-columns: 1fr 2fr;
      align-items: start;
      gap: var(--space-2xl);
    }
    .site-footer__cols { grid-template-columns: repeat(auto-fit, minmax(0, 1fr)); gap: var(--space-lg); }
  }
</style>
