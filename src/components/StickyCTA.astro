---
// src/components/StickyCTA.astro
// CTA de conversión persistente (Pilar 3). Aparece tras el hero, se oculta cerca del footer.
// Lee el destino de pedido desde contracts/site.json.
// Incluye el botón "volver arriba": aparece tras ~1 pantalla de scroll, se
// apila sobre el CTA y baja a su lugar cuando el CTA se oculta.
import site from '../../contracts/site.json';
import { withBase } from '../utils/base.js';
const orderUrl = withBase(site.orderUrl ?? '#');
---

<a
  href={orderUrl}
  class="sticky-cta"
  data-sticky-cta
  aria-label="Agendar demo"
>
  <span class="sticky-cta__dot" aria-hidden="true"></span>
  Agendar demo
</a>

<button class="back-top" type="button" data-back-top aria-label="Volver arriba">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12 19V5" /><path d="M6 11l6-6 6 6" />
  </svg>
</button>

<script>
  const cta = document.querySelector('[data-sticky-cta]');
  if (cta) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const update = () => {
      const y = window.scrollY;
      const nearBottom = y + window.innerHeight > document.body.scrollHeight - 240;
      const pastHero = y > window.innerHeight * 0.8;
      cta.classList.toggle('is-visible', pastHero && !nearBottom);
    };
    update();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update, { passive: true });

    // Micro-pulso cada 8s para atraer el ojo
    if (!reduced) {
      const pulse = () => {
        if (!cta.classList.contains('is-visible')) return;
        cta.classList.add('is-pulsing');
        setTimeout(() => cta.classList.remove('is-pulsing'), 700);
      };
      const interval = setInterval(pulse, 8000);
      document.addEventListener('astro:before-swap', () => clearInterval(interval), { once: true });
    }
  }
</script>

<script>
  // Volver arriba — init en astro:page-load (sobrevive a la navegación con
  // View Transitions, que reemplaza el body).
  function initBackTop() {
    const btn = document.querySelector('[data-back-top]');
    if (!btn || btn.dataset.init) return;
    btn.dataset.init = '1';
    const cta = document.querySelector('[data-sticky-cta]');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const update = () => {
      btn.classList.toggle('is-visible', window.scrollY > window.innerHeight * 1.2);
      const ctaShown = cta && cta.classList.contains('is-visible') && !document.body.classList.contains('hide-sticky-cta');
      btn.classList.toggle('is-low', !ctaShown); // sin CTA debajo, baja a su lugar
    };
    update();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update, { passive: true });
    // el CTA cambia de estado también por clases (secciones fijas, footer)
    const mo = new MutationObserver(update);
    if (cta) mo.observe(cta, { attributes: true, attributeFilter: ['class'] });
    mo.observe(document.body, { attributes: true, attributeFilter: ['class'] });
    document.addEventListener('astro:before-swap', () => {
      mo.disconnect();
      window.removeEventListener('scroll', update);
      window.removeEventListener('resize', update);
    }, { once: true });

    btn.addEventListener('click', () => {
      const lenis = window.__lenis;
      if (lenis) lenis.scrollTo(0, { duration: reduced ? 0 : 1.4, force: true });
      else window.scrollTo({ top: 0, behavior: reduced ? 'auto' : 'smooth' });
    });
  }
  document.addEventListener('astro:page-load', initBackTop);
</script>

<style>
  /* ── Volver arriba ── */
  .back-top {
    --cta-h: 54px;
    position: fixed;
    right: var(--space-md);
    bottom: calc(var(--space-md) + var(--cta-h) + var(--space-sm));
    z-index: var(--z-modal);
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    padding: 0;
    border-radius: var(--radius-full);
    border: 1px solid color-mix(in srgb, var(--navy) 14%, transparent);
    background-color: color-mix(in srgb, var(--bg-primary) 82%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    color: var(--navy);
    box-shadow: var(--shadow-md);
    cursor: pointer;
    opacity: 0;
    transform: translateY(12px) scale(0.9);
    pointer-events: none;
    transition: opacity var(--transition-smooth), transform var(--transition-smooth), bottom var(--transition-smooth), background-color var(--transition-fast), color var(--transition-fast), border-color var(--transition-fast);
    touch-action: manipulation;
  }
  .back-top svg { width: 20px; height: 20px; transition: transform var(--transition-fast); }
  .back-top.is-visible { opacity: 1; transform: none; pointer-events: auto; }
  .back-top.is-low { bottom: var(--space-md); }
  .back-top:hover { background-color: var(--accent); border-color: var(--accent); color: var(--on-accent); }
  .back-top:hover svg { transform: translateY(-2px); }
  .back-top:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

  @media (prefers-reduced-motion: reduce) {
    .back-top { transition: opacity var(--transition-fast); transform: none; }
  }

  .sticky-cta {
    position: fixed;
    right: var(--space-md);
    bottom: var(--space-md);
    z-index: var(--z-modal);
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 600;
    letter-spacing: 0.03em;
    color: var(--bg-primary);
    background-color: var(--accent);
    padding: var(--space-sm) var(--space-md);
    border-radius: var(--radius-full);
    text-decoration: none;
    box-shadow: var(--shadow-lg);
    opacity: 0;
    transform: translateY(120%);
    pointer-events: none;
    transition: opacity var(--transition-smooth), transform var(--transition-smooth), background-color var(--transition-fast);
  }
  .sticky-cta.is-visible {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  /* Secciones con pin a pantalla completa (ej. SolutionSlide) piden ocultarlo
     mientras duran — tapa el copy en viewports bajos. */
  :global(body.hide-sticky-cta) .sticky-cta.is-visible {
    opacity: 0;
    transform: translateY(120%);
    pointer-events: none;
  }
  .sticky-cta:hover { background-color: var(--accent-hover); }

  .sticky-cta__dot {
    width: 0.5em;
    height: 0.5em;
    border-radius: var(--radius-full);
    background-color: var(--bg-primary);
  }

  .sticky-cta.is-pulsing { animation: sticky-pulse 0.7s var(--ease-out); }
  @keyframes sticky-pulse {
    0%   { box-shadow: var(--shadow-lg), 0 0 0 0 color-mix(in srgb, var(--accent) 70%, transparent); }
    100% { box-shadow: var(--shadow-lg), 0 0 0 18px color-mix(in srgb, var(--accent) 0%, transparent); }
  }

  @media (max-width: 640px) {
    .sticky-cta {
      left: var(--space-md);
      right: var(--space-md);
      justify-content: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sticky-cta { transition: opacity var(--transition-fast); transform: none; }
  }
</style>
