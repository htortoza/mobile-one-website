---
// src/components/Header.astro
// Chrome global del sitio. Lee contracts/site.json (fuente única de marca + navegación).
import site from '../../contracts/site.json';
import { withBase } from '../utils/base.js';

const { siteName } = site.site;
const orderUrl = withBase(site.orderUrl ?? '#');
const loginUrl = site.loginUrl ?? '#';
// Enlace principal de navegación (por ahora solo Producto, la única página
// del menú planificado que existe). aria-current marca la página activa.
const here = Astro.url.pathname.replace(/\/$/, '');
const MENUS = {
  '/integraciones': [
    { heading: 'Tu ERP', links: [
      { label: 'SAP Business One', href: '/integraciones/erp/sap-business-one' },
      { label: 'Retail Pro', href: '/integraciones/erp/retail-pro' },
      { label: 'Retail Pro Prism', href: '/integraciones/erp/retail-pro-prism' },
    ] },
    { heading: 'Medios de pago', links: [
      { label: 'Transbank', href: '/integraciones/medios-de-pago/transbank' },
      { label: 'Getnet', href: '/integraciones/medios-de-pago/getnet' },
      { label: 'Mercado Pago', href: '/integraciones/medios-de-pago/mercado-pago' },
      { label: 'Niubiz', href: '/integraciones/medios-de-pago/niubiz' },
    ] },
    { heading: 'Documentos', links: [
      { label: 'Facturación electrónica', href: '/integraciones/facturacion' },
    ] },
  ],
  '/recursos': [
    { heading: 'Aprende', links: [
      { label: 'Casos de uso', href: '/recursos#casos-de-uso' },
      { label: 'Guía de uso', href: '/recursos#guia-de-uso' },
      { label: 'Perfiles de usuario', href: '/recursos#perfiles' },
    ] },
    { heading: 'Por industria', links: [
      { label: 'Moda y calzado', href: '/recursos/industrias/moda-y-calzado' },
      { label: 'Electrónica y tecnología', href: '/recursos/industrias/electronica-y-tecnologia' },
      { label: 'Multitienda y holdings', href: '/recursos/industrias/multitienda-y-holdings' },
      { label: 'Retail con ERP', href: '/recursos/industrias/retail-con-erp' },
    ] },
    { heading: 'Conócenos', links: [
      { label: 'Equipo', href: '/recursos#equipo' },
    ] },
  ],
};
const navItems = [
  { label: 'Producto', href: '/producto' },
  { label: 'Integraciones', href: '/integraciones' },
  { label: 'Recursos', href: '/recursos' },
].map((i) => {
  const url = withBase(i.href);
  const base = url.replace(/\/$/, '');
  const groups = (MENUS[i.href] ?? []).map((g) => ({ ...g, links: g.links.map((l) => ({ ...l, url: withBase(l.href) })) }));
  return { ...i, url, groups, current: here === base || here.startsWith(base + '/') };
});

const ICON_USER = 'M12 8a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Z|M5 20c0-3.5 3-6 7-6s7 2.5 7 6';
const ICON_HEADSET = 'M4 13v-2a8 8 0 0 1 16 0v2|M3 13h4v6H4.5A1.5 1.5 0 0 1 3 17.5V13Z|M21 13h-4v6h2.5a1.5 1.5 0 0 0 1.5-1.5V13Z|M19 19v1a3 3 0 0 1-3 3h-3';
---

<header class="site-header" data-header>
  <div class="container site-header__inner">
    <a href={withBase('/')} class="logo" aria-label={`${siteName}: Inicio`}>
      <img src={withBase('/brand/Imagotipo-logo.svg')} alt={siteName} class="logo__img" />
    </a>

    <div class="header-actions">
      <nav class="header-nav" aria-label="Menú principal">
        {navItems.map((i) => i.groups.length ? (
          <div class="nav-item">
            <a href={i.url} class="header-link has-menu" aria-current={i.current ? 'page' : undefined} aria-haspopup="true">
              {i.label}
              <svg class="chev" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5" /></svg>
            </a>
            <div class="dd" role="group" aria-label={i.label}>
              <div class="dd__panel" style={`--cols:${i.groups.length}`}>
                {i.groups.map((g) => (
                  <div class="dd__group">
                    <p class="dd__head">{g.heading}</p>
                    {g.links.map((l) => <a class="dd__link" href={l.url}>{l.label}</a>)}
                  </div>
                ))}
                <a class="dd__all" href={i.url}>Ver {i.label.toLowerCase()} →</a>
              </div>
            </div>
          </div>
        ) : (
          <a href={i.url} class="header-link" aria-current={i.current ? 'page' : undefined}>{i.label}</a>
        ))}
      </nav>
      <span class="header-sep" aria-hidden="true"></span>
      <a href={loginUrl} class="header-login">
        <svg class="header-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          {ICON_USER.split('|').map((d) => <path d={d} />)}
        </svg>
        Iniciar sesión
      </a>
      <a href={orderUrl} class="header-cta">
        <svg class="header-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          {ICON_HEADSET.split('|').map((d) => <path d={d} />)}
        </svg>
        Agendar demo
      </a>
    </div>

    <button
      class="nav-toggle"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobile-overlay"
      data-nav-toggle
    >
      <span></span><span></span>
    </button>
  </div>
</header>

<!-- Drawer móvil — fuera de <header>: ese elemento tiene backdrop-filter,
     que crea un containing block nuevo para position:fixed y hacía que el
     overlay solo cubriera el alto del header en vez de toda la pantalla.
     Panel lateral (no full-screen) + backdrop clickeable + botón cerrar
     propio, visible siempre dentro del panel (no depende del toggle del
     header, que quedaba tapado detrás del overlay). -->
<div class="mobile-overlay" id="mobile-overlay" data-overlay hidden>
  <button
    class="mobile-overlay__backdrop"
    data-overlay-backdrop
    aria-label="Cerrar menú"
    tabindex="-1"
  ></button>

  <div class="mobile-overlay__panel" role="dialog" aria-modal="true" aria-label="Menú">
    <div class="mobile-overlay__head">
      <a href={withBase('/')} class="logo" aria-label={`${siteName}: Inicio`}>
        <img src={withBase('/brand/Imagotipo-logo.svg')} alt={siteName} class="logo__img" />
      </a>
      <button class="mobile-overlay__close" data-overlay-close aria-label="Cerrar menú">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </div>

    <nav class="overlay-actions" aria-label="Menú principal">
      {navItems.map((i) => i.groups.length ? (
        <details class="overlay-acc" open={i.current}>
          <summary class="overlay-link overlay-link--sum">{i.label}</summary>
          <div class="overlay-sub">
            {i.groups.map((g) => (
              <div>
                <p class="overlay-sub__head">{g.heading}</p>
                {g.links.map((l) => <a class="overlay-sub__link" href={l.url} data-overlay-link>{l.label}</a>)}
              </div>
            ))}
            <a class="overlay-sub__link overlay-sub__link--all" href={i.url} data-overlay-link>Ver todo →</a>
          </div>
        </details>
      ) : (
        <a href={i.url} class="overlay-link" data-overlay-link aria-current={i.current ? 'page' : undefined}>{i.label}</a>
      ))}
      <span class="overlay-sep" aria-hidden="true"></span>
      <a href={loginUrl} class="overlay-login" data-overlay-link>
        <svg class="header-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          {ICON_USER.split('|').map((d) => <path d={d} />)}
        </svg>
        Iniciar sesión
      </a>
      <a href={orderUrl} class="overlay-cta" data-overlay-link>
        <svg class="header-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          {ICON_HEADSET.split('|').map((d) => <path d={d} />)}
        </svg>
        Agendar demo
      </a>
    </nav>
  </div>
</div>

<script>
  // Astro usa View Transitions (<ClientRouter/>): el DOM se reemplaza en
  // cada navegación interna pero un <script> de módulo solo se evalúa una
  // vez, así que el listener del toggle quedaba enganchado a los nodos de
  // la PRIMERA carga — al navegar a otra página (o volver) el menú móvil
  // dejaba de responder. Por eso todo va dentro de una función reenganchada
  // en cada astro:page-load (mismo patrón que el resto de componentes:
  // ProductoChapterNav, SolutionSlide, BrandCompat, etc.).
  function initHeader() {
    const header  = document.querySelector('[data-header]');
    const toggle  = document.querySelector('[data-nav-toggle]');
    const overlay = document.querySelector('[data-overlay]');

    // Header se vuelve sólido al hacer scroll
    if (header) {
      const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 40);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
      document.addEventListener('astro:before-swap', () => window.removeEventListener('scroll', onScroll), { once: true });
    }

    // Toggle del overlay móvil
    if (toggle && overlay) {
      // Debe coincidir con --transition-smooth (panel) en la duración más
      // larga de las dos transiciones (panel/backdrop).
      const CLOSE_MS = 600;
      let closeTimeout;

      const setOpen = (open) => {
        clearTimeout(closeTimeout);

        if (open) {
          // Quitar "hidden" y agregar "is-open" en el mismo tick no anima
          // nada: el navegador nunca pinta el estado inicial (display:none →
          // abierto en un solo frame), así que el drawer solo "aparece".
          // Se fuerza un reflow entre ambos pasos para que sí anime.
          overlay.removeAttribute('hidden');
          void overlay.offsetHeight;
          overlay.classList.add('is-open');
        } else {
          overlay.classList.remove('is-open');
          closeTimeout = setTimeout(() => overlay.setAttribute('hidden', ''), CLOSE_MS);
        }

        toggle.classList.toggle('is-active', open);
        toggle.setAttribute('aria-expanded', String(open));
        toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
        document.body.style.overflow = open ? 'hidden' : '';
        // El sitio usa Lenis para el scroll suave — solo bloquear
        // overflow del body no lo frena (Lenis intercepta wheel/touch
        // aparte), así que hay que pausarlo/reanudarlo explícitamente.
        const lenis = window.__lenis;
        if (lenis) open ? lenis.stop() : lenis.start();
      };

      toggle.addEventListener('click', () => setOpen(overlay.hasAttribute('hidden')));
      overlay.querySelector('[data-overlay-close]')?.addEventListener('click', () => setOpen(false));
      overlay.querySelector('[data-overlay-backdrop]')?.addEventListener('click', () => setOpen(false));
      overlay.querySelectorAll('[data-overlay-link]').forEach((a) =>
        a.addEventListener('click', () => setOpen(false))
      );

      const onKeydown = (e) => {
        if (e.key === 'Escape' && !overlay.hasAttribute('hidden')) setOpen(false);
      };
      document.addEventListener('keydown', onKeydown);

      document.addEventListener('astro:before-swap', () => {
        clearTimeout(closeTimeout);
        document.removeEventListener('keydown', onKeydown);
        document.body.style.overflow = '';
        window.__lenis?.start();
      }, { once: true });
    }
  }

  document.addEventListener('astro:page-load', initHeader);
</script>

<style>
  /* Glass siempre activo (no transparente): el Hero tiene un panel azul debajo
     y uno claro — un header transparente perdería contraste contra el azul. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-overlay);
    transition: box-shadow var(--transition-fast);
    background-color: color-mix(in srgb, var(--bg-primary) 78%, transparent);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid color-mix(in srgb, var(--border) 40%, transparent);
  }

  .site-header.is-scrolled {
    box-shadow: var(--shadow-sm);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding-block: var(--space-sm);
  }

  /* ── Logo ── */
  .logo {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }
  .logo__img {
    height: 28px;
    width: auto;
    display: block;
  }

  /* ── Acciones header (login + CTA) ── */
  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }
  .header-icon { width: 16px; height: 16px; flex-shrink: 0; }

  /* Enlace de navegación: subrayado que se dibuja al hover; fijo en la página activa */
  .header-nav { display: flex; align-items: center; gap: 1.6rem; }
  .header-link {
    position: relative;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--text-primary);
    text-decoration: none;
    white-space: nowrap;
    padding: var(--space-xs) var(--space-sm);
  }
  .header-link::after {
    content: '';
    position: absolute;
    left: var(--space-sm);
    right: var(--space-sm);
    bottom: 2px;
    height: 1.5px;
    border-radius: 2px;
    background-color: var(--accent);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform var(--transition-fast);
  }
  .header-link:hover::after,
  .header-link[aria-current='page']::after { transform: scaleX(1); }
  .header-link[aria-current='page'] { color: var(--accent); }
  .header-sep { width: 1px; height: 18px; background-color: var(--border); }

  .header-login {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--text-secondary);
    text-decoration: none;
    white-space: nowrap;
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius-full);
    border: 1px solid transparent;
    transition: color var(--transition-fast), border-color var(--transition-fast);
  }
  .header-login:hover { color: var(--text-primary); border-color: var(--border); }

  .header-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--bg-primary);
    background-color: var(--accent);
    padding: var(--space-xs) var(--space-md);
    border-radius: var(--radius-full);
    text-decoration: none;
    white-space: nowrap;
    transition: background-color var(--transition-fast), transform var(--transition-fast);
  }
  .header-cta:hover { background-color: var(--accent-hover); transform: translateY(-2px); }

  /* ── Toggle móvil ── */
  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    width: 44px;
    height: 44px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 10px;
  }
  .nav-toggle span {
    display: block;
    height: 2px;
    width: 100%;
    background-color: var(--text-primary);
    transition: transform var(--transition-fast), opacity var(--transition-fast);
  }
  .nav-toggle.is-active span:nth-child(1) { transform: translateY(4px) rotate(45deg); }
  .nav-toggle.is-active span:nth-child(2) { transform: translateY(-4px) rotate(-45deg); }

  /* ── Drawer móvil — panel lateral, NO full-screen ── */
  .mobile-overlay {
    position: fixed;
    inset: 0;
    z-index: var(--z-overlay);
    visibility: hidden;
    pointer-events: none;
    /* Delay para que visibility cambie a hidden recién cuando termina la
       transición de salida del panel (0.6s, --transition-smooth) — sin
       esto, visibility:hidden aplica en el frame siguiente y el cierre
       nunca se alcanza a ver. */
    transition: visibility 0s linear 0.6s;
  }
  .mobile-overlay[hidden] { display: none; }
  .mobile-overlay.is-open {
    visibility: visible;
    pointer-events: auto;
    transition-delay: 0s;
  }

  .mobile-overlay__backdrop {
    position: absolute;
    inset: 0;
    width: 100%;
    border: none;
    padding: 0;
    margin: 0;
    background-color: color-mix(in srgb, var(--navy) 55%, transparent);
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
    opacity: 0;
    transition: opacity var(--transition-fast);
    cursor: default;
  }
  .mobile-overlay.is-open .mobile-overlay__backdrop { opacity: 1; }

  .mobile-overlay__panel {
    position: absolute;
    top: 0;
    right: 0;
    height: 100%;
    width: min(82vw, 340px);
    display: flex;
    flex-direction: column;
    padding: var(--space-sm) var(--space-md);
    background-color: var(--bg-primary);
    box-shadow: var(--shadow-lg);
    transform: translateX(100%);
    transition: transform var(--transition-smooth);
  }
  .mobile-overlay.is-open .mobile-overlay__panel { transform: translateX(0); }

  .mobile-overlay__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: var(--space-xs);
    margin-bottom: var(--space-sm);
    border-bottom: 1px solid color-mix(in srgb, var(--border) 70%, transparent);
  }
  .mobile-overlay__close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: none;
    border: none;
    border-radius: var(--radius-full);
    color: var(--text-primary);
    cursor: pointer;
    transition: background-color var(--transition-fast);
  }
  .mobile-overlay__close:hover { background-color: var(--bg-secondary); }
  .mobile-overlay__close svg { width: 20px; height: 20px; }

  /* flex (no grid): permite anclar el CTA abajo con margin-top:auto sin
     importar cuánto mida el panel — si cambia el alto de pantalla, el CTA
     sigue pegado al fondo en vez de quedar flotando a mitad de camino. */
  .overlay-actions { display: flex; flex-direction: column; flex: 1; gap: var(--space-sm); }
  .overlay-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--text-primary);
    text-decoration: none;
    padding: var(--space-sm) var(--space-xs);
    border-radius: var(--radius-md);
    transition: background-color var(--transition-fast), color var(--transition-fast);
  }
  .overlay-link::after { content: '→'; font-size: var(--text-base); color: var(--text-secondary); transition: transform var(--transition-fast); }
  .overlay-link:hover { background-color: var(--bg-secondary); }
  .overlay-link:hover::after { transform: translateX(3px); }
  .overlay-link[aria-current='page'] { color: var(--accent); }
  .overlay-sep { height: 1px; background-color: var(--border); margin-block: var(--space-xs); }
  .overlay-login {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
    box-sizing: border-box;
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    padding: var(--space-sm) var(--space-xs);
    border-radius: var(--radius-md);
    transition: background-color var(--transition-fast), color var(--transition-fast);
  }
  .overlay-login:hover { color: var(--text-primary); background-color: var(--bg-secondary); }
  .overlay-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    box-sizing: border-box;
    margin-top: auto;
    white-space: nowrap;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--bg-primary);
    background-color: var(--accent);
    padding: var(--space-sm) var(--space-xs);
    border-radius: var(--radius-full);
    text-decoration: none;
  }

  /* ── Desplegable (escritorio) ── */
  .nav-item { position: relative; }
  .has-menu { display: inline-flex; align-items: center; gap: 5px; }
  .chev { width: 10px; height: 10px; transition: transform var(--transition-fast); }
  .nav-item:hover .chev, .nav-item:focus-within .chev { transform: rotate(180deg); }
  .dd { position: absolute; top: 100%; left: 50%; padding-top: 14px; opacity: 0; visibility: hidden; transform: translate(-50%, 6px); transition: opacity .25s, transform .35s var(--ease-expo), visibility 0s linear .25s; z-index: 5; }
  .nav-item:hover .dd, .nav-item:focus-within .dd { opacity: 1; visibility: visible; transform: translate(-50%, 0); transition-delay: 0s; }
  .dd__panel { display: grid; grid-template-columns: repeat(var(--cols), auto); gap: 1.6rem; padding: 1.2rem 1.4rem; min-width: max-content; background: var(--bg-primary); border: 1px solid var(--border); border-radius: var(--radius-lg); box-shadow: 0 24px 50px -20px color-mix(in srgb, var(--accent-grad-start) 35%, transparent), var(--shadow-md); position: relative; }
  .dd__panel::before { content: ''; position: absolute; left: 0; right: 0; top: 0; height: 3px; border-radius: var(--radius-lg) var(--radius-lg) 0 0; background: var(--grad-brand); }
  .dd__group { display: grid; gap: 2px; align-content: start; min-width: 11rem; }
  .dd__head { font-size: var(--text-xs); letter-spacing: .12em; text-transform: uppercase; color: var(--accent); font-weight: 500; padding: 0 .6rem .4rem; }
  .dd__link { font-size: var(--text-sm); color: var(--navy); text-decoration: none; padding: .45rem .6rem; border-radius: var(--radius-md); white-space: nowrap; transition: background-color var(--transition-fast), color var(--transition-fast); }
  .dd__link:hover, .dd__link:focus-visible { background: var(--tint-strong); color: var(--accent); }
  .dd__all { grid-column: 1 / -1; font-size: var(--text-sm); color: var(--accent); text-decoration: none; padding: .6rem .6rem 0; border-top: 1px solid var(--border); font-weight: 500; }
  .dd__all:hover { text-decoration: underline; }

  /* ── Acordeón (móvil) ── */
  .overlay-acc > summary { list-style: none; cursor: pointer; }
  .overlay-acc > summary::-webkit-details-marker { display: none; }
  .overlay-link--sum::after { content: '+'; font-size: var(--text-lg); }
  .overlay-acc[open] > .overlay-link--sum::after { content: '−'; }
  .overlay-sub { display: grid; gap: var(--space-xs); padding: 0 var(--space-xs) var(--space-xs) var(--space-sm); border-left: 2px solid var(--tint-strong); margin-left: var(--space-xs); }
