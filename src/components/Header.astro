---
// src/components/Header.astro
// Chrome global del sitio. Lee contracts/site.json (fuente única de marca + navegación).
import site from '../../contracts/site.json';
import { withBase } from '../utils/base.js';

const { siteName } = site.site;
const orderUrl = withBase(site.orderUrl ?? '#');
const loginUrl = site.loginUrl ?? '#';

const ICON_USER = 'M12 8a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Z|M5 20c0-3.5 3-6 7-6s7 2.5 7 6';
const ICON_HEADSET = 'M4 13v-2a8 8 0 0 1 16 0v2|M3 13h4v6H4.5A1.5 1.5 0 0 1 3 17.5V13Z|M21 13h-4v6h2.5a1.5 1.5 0 0 0 1.5-1.5V13Z|M19 19v1a3 3 0 0 1-3 3h-3';
---

<header class="site-header" data-header>
  <div class="container site-header__inner">
    <a href={withBase('/')} class="logo" aria-label={`${siteName}: Inicio`}>
      <img src={withBase('/brand/Imagotipo-logo.svg')} alt={siteName} class="logo__img" />
    </a>

    <div class="header-actions">
      <a href={loginUrl} class="header-login">
        <svg class="header-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          {ICON_USER.split('|').map((d) => <path d={d} />)}
        </svg>
        Iniciar sesión
      </a>
      <a href={orderUrl} class="header-cta">
        <svg class="header-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          {ICON_HEADSET.split('|').map((d) => <path d={d} />)}
        </svg>
        Agendar demo
      </a>
    </div>

    <button
      class="nav-toggle"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobile-overlay"
      data-nav-toggle
    >
      <span></span><span></span>
    </button>
  </div>
</header>

<!-- Drawer móvil — fuera de <header>: ese elemento tiene backdrop-filter,
     que crea un containing block nuevo para position:fixed y hacía que el
     overlay solo cubriera el alto del header en vez de toda la pantalla.
     Panel lateral (no full-screen) + backdrop clickeable + botón cerrar
     propio, visible siempre dentro del panel (no depende del toggle del
     header, que quedaba tapado detrás del overlay). -->
<div class="mobile-overlay" id="mobile-overlay" data-overlay hidden>
  <button
    class="mobile-overlay__backdrop"
    data-overlay-backdrop
    aria-label="Cerrar menú"
    tabindex="-1"
  ></button>

  <div class="mobile-overlay__panel" role="dialog" aria-modal="true" aria-label="Menú">
    <div class="mobile-overlay__head">
      <a href={withBase('/')} class="logo" aria-label={`${siteName}: Inicio`}>
        <img src={withBase('/brand/Imagotipo-logo.svg')} alt={siteName} class="logo__img" />
      </a>
      <button class="mobile-overlay__close" data-overlay-close aria-label="Cerrar menú">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </div>

    <nav class="overlay-actions" aria-label="Menú principal">
      <a href={loginUrl} class="overlay-login" data-overlay-link>
        <svg class="header-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          {ICON_USER.split('|').map((d) => <path d={d} />)}
        </svg>
        Iniciar sesión
      </a>
      <a href={orderUrl} class="overlay-cta" data-overlay-link>
        <svg class="header-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          {ICON_HEADSET.split('|').map((d) => <path d={d} />)}
        </svg>
        Agendar demo
      </a>
    </nav>
  </div>
</div>

<script>
  const header  = document.querySelector('[data-header]');
  const toggle  = document.querySelector('[data-nav-toggle]');
  const overlay = document.querySelector('[data-overlay]');

  // Header se vuelve sólido al hacer scroll
  if (header) {
    const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 40);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  // Toggle del overlay móvil
  if (toggle && overlay) {
    // Debe coincidir con --transition-smooth (panel) en la duración más
    // larga de las dos transiciones (panel/backdrop).
    const CLOSE_MS = 600;
    let closeTimeout;

    const setOpen = (open) => {
      clearTimeout(closeTimeout);

      if (open) {
        // Quitar "hidden" y agregar "is-open" en el mismo tick no anima
        // nada: el navegador nunca pinta el estado inicial (display:none →
        // abierto en un solo frame), así que el drawer solo "aparece".
        // Se fuerza un reflow entre ambos pasos para que sí anime.
        overlay.removeAttribute('hidden');
        void overlay.offsetHeight;
        overlay.classList.add('is-open');
      } else {
        overlay.classList.remove('is-open');
        closeTimeout = setTimeout(() => overlay.setAttribute('hidden', ''), CLOSE_MS);
      }

      toggle.classList.toggle('is-active', open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
      document.body.style.overflow = open ? 'hidden' : '';
      // El sitio usa Lenis para el scroll suave — solo bloquear
      // overflow del body no lo frena (Lenis intercepta wheel/touch
      // aparte), así que hay que pausarlo/reanudarlo explícitamente.
      const lenis = window.__lenis;
      if (lenis) open ? lenis.stop() : lenis.start();
    };

    toggle.addEventListener('click', () => setOpen(overlay.hasAttribute('hidden')));
    overlay.querySelector('[data-overlay-close]')?.addEventListener('click', () => setOpen(false));
    overlay.querySelector('[data-overlay-backdrop]')?.addEventListener('click', () => setOpen(false));
    overlay.querySelectorAll('[data-overlay-link]').forEach((a) =>
      a.addEventListener('click', () => setOpen(false))
    );
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !overlay.hasAttribute('hidden')) setOpen(false);
    });
    document.addEventListener('astro:before-swap', () => { document.body.style.overflow = ''; }, { once: true });
  }
</script>

<style>
  /* Glass siempre activo (no transparente): el Hero tiene un panel azul debajo
     y uno claro — un header transparente perdería contraste contra el azul. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-overlay);
    transition: box-shadow var(--transition-fast);
    background-color: color-mix(in srgb, var(--bg-primary) 78%, transparent);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid color-mix(in srgb, var(--border) 40%, transparent);
  }

  .site-header.is-scrolled {
    box-shadow: var(--shadow-sm);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding-block: var(--space-sm);
  }

  /* ── Logo ── */
  .logo {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }
  .logo__img {
    height: 28px;
    width: auto;
    display: block;
  }

  /* ── Acciones header (login + CTA) ── */
  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }
  .header-icon { width: 16px; height: 16px; flex-shrink: 0; }

  .header-login {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--text-secondary);
    text-decoration: none;
    white-space: nowrap;
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius-full);
    border: 1px solid transparent;
    transition: color var(--transition-fast), border-color var(--transition-fast);
  }
  .header-login:hover { color: var(--text-primary); border-color: var(--border); }

  .header-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--bg-primary);
    background-color: var(--accent);
    padding: var(--space-xs) var(--space-md);
    border-radius: var(--radius-full);
    text-decoration: none;
    white-space: nowrap;
    transition: background-color var(--transition-fast), transform var(--transition-fast);
  }
  .header-cta:hover { background-color: var(--accent-hover); transform: translateY(-2px); }

  /* ── Toggle móvil ── */
  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    width: 44px;
    height: 44px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 10px;
  }
  .nav-toggle span {
    display: block;
    height: 2px;
    width: 100%;
    background-color: var(--text-primary);
    transition: transform var(--transition-fast), opacity var(--transition-fast);
  }
  .nav-toggle.is-active span:nth-child(1) { transform: translateY(4px) rotate(45deg); }
  .nav-toggle.is-active span:nth-child(2) { transform: translateY(-4px) rotate(-45deg); }

  /* ── Drawer móvil — panel lateral, NO full-screen ── */
  .mobile-overlay {
    position: fixed;
    inset: 0;
    z-index: var(--z-overlay);
    visibility: hidden;
    pointer-events: none;
    /* Delay para que visibility cambie a hidden recién cuando termina la
       transición de salida del panel (0.6s, --transition-smooth) — sin
       esto, visibility:hidden aplica en el frame siguiente y el cierre
       nunca se alcanza a ver. */
    transition: visibility 0s linear 0.6s;
  }
  .mobile-overlay[hidden] { display: none; }
  .mobile-overlay.is-open {
    visibility: visible;
    pointer-events: auto;
    transition-delay: 0s;
  }

  .mobile-overlay__backdrop {
    position: absolute;
    inset: 0;
    width: 100%;
    border: none;
    padding: 0;
    margin: 0;
    background-color: color-mix(in srgb, var(--navy) 55%, transparent);
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
    opacity: 0;
    transition: opacity var(--transition-fast);
    cursor: default;
  }
  .mobile-overlay.is-open .mobile-overlay__backdrop { opacity: 1; }

  .mobile-overlay__panel {
    position: absolute;
    top: 0;
    right: 0;
    height: 100%;
    width: min(82vw, 340px);
    display: flex;
    flex-direction: column;
    padding: var(--space-sm) var(--space-md) var(--space-lg);
    background-color: var(--bg-primary);
    box-shadow: var(--shadow-lg);
    transform: translateX(100%);
    transition: transform var(--transition-smooth);
  }
  .mobile-overlay.is-open .mobile-overlay__panel { transform: translateX(0); }

  .mobile-overlay__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: var(--space-xs);
    margin-bottom: var(--space-lg);
    border-bottom: 1px solid color-mix(in srgb, var(--border) 70%, transparent);
  }
  .mobile-overlay__close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: none;
    border: none;
    border-radius: var(--radius-full);
    color: var(--text-primary);
    cursor: pointer;
    transition: background-color var(--transition-fast);
  }
  .mobile-overlay__close:hover { background-color: var(--bg-secondary); }
  .mobile-overlay__close svg { width: 20px; height: 20px; }

  /* flex (no grid): permite anclar el CTA abajo con margin-top:auto sin
     importar cuánto mida el panel — si cambia el alto de pantalla, el CTA
     sigue pegado al fondo en vez de quedar flotando a mitad de camino. */
  .overlay-actions { display: flex; flex-direction: column; flex: 1; gap: var(--space-sm); }
  .overlay-login {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
    box-sizing: border-box;
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    padding: var(--space-sm) var(--space-xs);
    border-radius: var(--radius-md);
    transition: background-color var(--transition-fast), color var(--transition-fast);
  }
  .overlay-login:hover { color: var(--text-primary); background-color: var(--bg-secondary); }
  .overlay-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    box-sizing: border-box;
    margin-top: auto;
    white-space: nowrap;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--bg-primary);
    background-color: var(--accent);
    padding: var(--space-sm) var(--space-xs);
    border-radius: var(--radius-full);
    text-decoration: none;
  }

  /* ── Responsive ── */
  @media (max-width: 860px) {
    .header-actions { display: none; }
    .nav-toggle { display: flex; }

    .site-header .container { padding-inline: 20px; }
    .site-header__inner { padding-block: 4px; }
    .logo__img { height: 22px; }
  }
</style>
