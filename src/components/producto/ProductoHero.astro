---
// src/components/producto/ProductoHero.astro
// /producto — Hero a sangre completa con foto real (no split centrado como
// HeroSplit de Home). Tipografía gigante superpuesta a la imagen, marquee
// vertical de keywords en el borde derecho, CTA anclado abajo.
const { eyebrow, headline, subheadline, ctaText, ctaHref, keywords } = Astro.props;
const kw = keywords ?? [];
---

<section class="phero" data-gsap-section="phero">
  <img class="phero__bg" src="/images/producto/hero-venta.webp" alt="Vendedor cobrando con terminal Mobile One en una tienda de ropa de noche" />
  <div class="phero__scrim" aria-hidden="true"></div>

  <div class="phero__vmarquee" aria-hidden="true">
    <div class="phero__vtrack">
      {[...kw, ...kw].map((k) => <span>{k}</span>)}
    </div>
  </div>

  <div class="container phero__inner">
    {eyebrow && (
      <p class="phero__eyebrow" data-gsap-animate="fade-up">
        <span class="phero__dot" aria-hidden="true"></span>{eyebrow}
      </p>
    )}
    <h1 class="phero__headline" data-gsap-animate="headline">{headline}</h1>

    <div class="phero__foot" data-gsap-animate="fade-up">
      <p class="phero__sub">{subheadline}</p>
      <a href={ctaHref} class="phero__btn">{ctaText}</a>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';

  function initHero() {
    const section = document.querySelector('[data-gsap-section="phero"]');
    if (!section) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const headline = section.querySelector('[data-gsap-animate="headline"]');
    const rest = section.querySelectorAll('[data-gsap-animate="fade-up"]');
    const bg = section.querySelector('.phero__bg');

    const tl = gsap.timeline({ defaults: { ease: 'expo.out' } });
    if (bg) tl.from(bg, { scale: 1.12, duration: 1.6, ease: 'power2.out' });
    if (headline) tl.from(headline, { y: 60, opacity: 0, duration: 1 }, '-=1.3');
    tl.from(rest, { y: 20, opacity: 0, stagger: 0.1, duration: 0.8 }, '-=0.6');

    const mm = gsap.matchMedia();
    mm.add('(min-width: 900px)', () => {
      gsap.to(bg, {
        yPercent: 10,
        ease: 'none',
        scrollTrigger: { trigger: section, start: 'top top', end: 'bottom top', scrub: true },
      });
    });
  }

  document.addEventListener('astro:page-load', initHero);
</script>

<style>
  .phero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    color: var(--text-primary);
  }
  .phero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
    z-index: 0;
  }
  .phero__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(to top, color-mix(in srgb, var(--bg-primary) 92%, transparent) 0%, color-mix(in srgb, var(--bg-primary) 20%, transparent) 55%, transparent 85%),
      linear-gradient(to right, color-mix(in srgb, var(--bg-primary) 55%, transparent) 0%, transparent 40%);
  }

  .phero__vmarquee {
    position: absolute;
    top: 0; right: var(--space-md); bottom: 0;
    z-index: 1;
    width: 24px;
    overflow: hidden;
    display: none;
  }
  .phero__vtrack {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    writing-mode: vertical-rl;
    animation: phero-vscroll 22s linear infinite;
  }
  .phero__vtrack span {
    font-size: var(--text-xs);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--text-primary) 55%, transparent);
    white-space: nowrap;
  }
  @keyframes phero-vscroll { from { transform: translateY(0); } to { transform: translateY(-50%); } }

  .phero__inner {
    position: relative;
    z-index: 2;
    padding-block-end: var(--space-2xl);
    display: grid;
    gap: var(--space-lg);
  }

  .phero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: var(--text-sm);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--text-primary) 75%, transparent);
  }
  .phero__dot {
    width: 7px; height: 7px;
    border-radius: var(--radius-full);
    background-color: var(--accent-hover);
    box-shadow: 0 0 10px 2px color-mix(in srgb, var(--accent-hover) 70%, transparent);
    animation: phero-pulse 1.8s ease-in-out infinite;
  }
  @keyframes phero-pulse { 50% { opacity: 0.35; } }

  .phero__headline {
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: clamp(3rem, 10vw, 8rem);
    line-height: 0.96;
    letter-spacing: -0.03em;
    max-width: 18ch;
  }

  .phero__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-lg);
    border-top: 1px solid color-mix(in srgb, var(--text-primary) 20%, transparent);
    padding-top: var(--space-md);
  }
  .phero__sub {
    font-size: var(--text-lg);
    line-height: 1.5;
    color: color-mix(in srgb, var(--text-primary) 80%, transparent);
    max-width: 42ch;
  }
  .phero__btn {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: var(--text-base);
    padding: var(--space-sm) var(--space-lg);
    border-radius: var(--radius-full);
    background-color: var(--accent);
    color: var(--on-accent);
    text-decoration: none;
    transition: transform var(--transition-fast), background-color var(--transition-fast);
  }
  .phero__btn:hover { transform: translateY(-2px); background-color: var(--accent-hover); }

  @media (min-width: 900px) {
    .phero__vmarquee { display: block; }
  }
</style>
