---
// src/components/producto/ProductoHero.astro
// /producto §5.1 — Hero propio, distinto al split azul/claro de Home
// (HeroSplit). Fondo claro con grid+degradado de marca (mismo recurso visual
// de hero-split__light::before, reusado aquí a página completa) y el
// selector de las 2 superficies del producto como pieza central del Hero,
// no como tabs de texto aparte.
const { eyebrow, headline, subheadline, surfaces } = Astro.props;
const list = surfaces ?? [];
---

<section class="phero2" data-gsap-section="phero2">
  <div class="phero2__grid" aria-hidden="true"></div>

  <div class="container phero2__inner">
    {eyebrow && <p class="phero2__eyebrow" data-gsap-animate="fade-up">{eyebrow}</p>}
    <h1 class="phero2__headline" data-gsap-split="words">
      {headline.map((part, i) => (
        <>
          <span class="phero2__word-outer">
            <span class={`phero2__word ${part.accent ? `phero2__word--${part.accent}` : ''}`}>{part.text}</span>
          </span>
          {part.break && <span class="phero2__break" aria-hidden="true"></span>}
        </>
      ))}
    </h1>
    <p class="phero2__sub" data-gsap-animate="fade-up">{subheadline}</p>
  </div>

  <div class="container phero2__surfaces">
    {list.map((s, i) => (
      <a href={s.href} class="phero2__card" data-phero2-card data-index={i}>
        <div class="phero2__card-frame">
          <img src={s.image} alt={s.alt} class="phero2__card-img" />
        </div>
        <div class="phero2__card-foot">
          <span class="phero2__card-label">{s.label}</span>
          <span class="phero2__card-sub">{s.sub}</span>
        </div>
      </a>
    ))}
  </div>
</section>

<script>
  import { gsap } from 'gsap';

  function initHero2() {
    const section = document.querySelector('[data-gsap-section="phero2"]');
    if (!section) return;
    const grid = section.querySelector('.phero2__grid');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!reduced) {
      const words = section.querySelectorAll('.phero2__word');
      const eyebrow = section.querySelector('[data-gsap-animate="fade-up"]');
      const sub = section.querySelectorAll('[data-gsap-animate="fade-up"]')[1];
      const cards = section.querySelectorAll('[data-phero2-card]');

      const tl = gsap.timeline({ defaults: { ease: 'expo.out' } });
      if (eyebrow) tl.from(eyebrow, { y: 16, opacity: 0, duration: 0.7 });
      tl.from(words, { y: 40, opacity: 0, stagger: 0.04, duration: 0.9 }, '-=0.3');
      if (sub) tl.from(sub, { y: 20, opacity: 0, duration: 0.8 }, '-=0.4');
      tl.from(cards, { y: 30, opacity: 0, stagger: 0.12, duration: 0.8 }, '-=0.5');

      const mm = gsap.matchMedia();
      mm.add('(min-width: 900px)', () => {
        if (grid) {
          gsap.to(grid, {
            yPercent: 8,
            ease: 'none',
            scrollTrigger: { trigger: section, start: 'top top', end: 'bottom top', scrub: true },
          });
        }
        cards.forEach((card) => {
          const qx = gsap.quickTo(card, 'rotateY', { duration: 0.4, ease: 'power3.out' });
          const qy = gsap.quickTo(card, 'rotateX', { duration: 0.4, ease: 'power3.out' });
          card.addEventListener('mousemove', (e) => {
            const r = card.getBoundingClientRect();
            qx(((e.clientX - r.left) / r.width - 0.5) * 8);
            qy(-((e.clientY - r.top) / r.height - 0.5) * 8);
          });
          card.addEventListener('mouseleave', () => {
            gsap.to(card, { rotateX: 0, rotateY: 0, duration: 0.6, ease: 'power2.out' });
          });
        });
      });
    }
  }

  document.addEventListener('astro:page-load', initHero2);
</script>

<style>
  .phero2 {
    position: relative;
    padding-block: var(--space-xl) var(--space-2xl);
    background-color: var(--bg-primary);
    overflow: hidden;
  }
  .phero2__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(color-mix(in srgb, var(--navy) 8%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--navy) 8%, transparent) 1px, transparent 1px);
    background-size: 32px 32px;
    -webkit-mask-image: radial-gradient(circle at 50% 20%, black 0%, black 25%, transparent 65%);
    mask-image: radial-gradient(circle at 50% 20%, black 0%, black 25%, transparent 65%);
  }

  .phero2__inner { position: relative; z-index: 1; display: grid; gap: var(--space-md); max-width: 62ch; margin-bottom: var(--space-xl); }
  .phero2__eyebrow { font-size: var(--text-sm); letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-secondary); }
  .phero2__headline {
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.22em;
    row-gap: 0.05em;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: clamp(2.4rem, 6vw, 4.2rem);
    line-height: 1.06;
    letter-spacing: -0.02em;
    color: var(--navy);
  }
  .phero2__word-outer { overflow: hidden; padding-bottom: 0.06em; margin-bottom: -0.06em; }
  .phero2__break { flex-basis: 100%; height: 0; }
  .phero2__word { display: block; }
  .phero2__word--accent { color: var(--accent); }
  .phero2__word--navy { color: var(--accent-hover); }
  .phero2__sub { font-size: var(--text-lg); color: var(--text-secondary); line-height: 1.6; }

  .phero2__surfaces { position: relative; z-index: 1; display: grid; gap: var(--space-md); grid-template-columns: 1fr; }
  .phero2__card {
    display: block;
    text-decoration: none;
    color: var(--text-primary);
    background-color: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    transform-style: preserve-3d;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }
  .phero2__card:hover { box-shadow: var(--shadow-lg); transform: translateY(-4px); }
  .phero2__card-frame { aspect-ratio: 4 / 3; overflow: hidden; }
  .phero2__card-img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform var(--transition-smooth); }
  .phero2__card:hover .phero2__card-img { transform: scale(1.04); }
  .phero2__card-foot { display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-sm); padding: var(--space-md); }
  .phero2__card-label { font-family: var(--font-heading); font-weight: 600; font-size: var(--text-lg); color: var(--navy); }
  .phero2__card-sub { font-size: var(--text-sm); color: var(--accent); font-weight: 500; }

  @media (min-width: 800px) {
    .phero2__surfaces { grid-template-columns: 1fr 1fr; }
  }
</style>
