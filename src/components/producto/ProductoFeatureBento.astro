---
// src/components/producto/ProductoFeatureBento.astro
// /producto §5.2 — BackOffice "en la tienda". Mazo de paneles vivos: cada
// funcionalidad es un panel ancho que queda fijo (sticky) mientras el
// siguiente sube y se apoya encima; el de atrás se hunde (scale + velo).
// Cada panel trae una mini-UI del BackOffice que se "activa" al llegar
// (tabla de ventas, carro que se verifica en Mercado Pago, bitácora que
// conserva lo marcado). Hover desktop: halo sutil que sigue al cursor.
// Mini-UIs por índice de feature (0 ventas · 1 carros · 2 auditoría).
import { withBase } from '../../utils/base.js';
const { id, eyebrow, title, note, image, imageAlt, features } = Astro.props;
const list = features ?? [];
---

<section id={id} class="pfb" data-gsap-section={`pfb-${id}`}>
  <div class="container pfb__intro">
    <div class="pfb__copy">
      {eyebrow && <p class="pfb__eyebrow" data-gsap-animate="fade-up">{eyebrow}</p>}
      <h2 class="pfb__title" data-gsap-animate="fade-up">{title}</h2>
      {note && <p class="pfb__note" data-gsap-animate="fade-up">{note}</p>}
    </div>
    {image && (
      <div class="pfb__frame" data-gsap-animate="fade-up">
        <img class="pfb__img" src={withBase(image)} alt={imageAlt ?? ''} />
      </div>
    )}
  </div>

  <div class="container pfb__stack">
    {list.map((f, i) => (
      <article class="pfb__card" style={`--i:${i}`} data-pfb-card>
        <span class="pfb__glow" aria-hidden="true"></span>
        <span class="pfb__veil" aria-hidden="true" data-pfb-veil></span>

        <div class="pfb__card-copy">
          <span class="pfb__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}<small>/ {String(list.length).padStart(2, '0')}</small></span>
          <h3 class="pfb__heading">{f.title}</h3>
          <p class="pfb__text">{f.text}</p>
        </div>

        <div class="pfb__ui" aria-hidden="true" data-pfb-ui={i}>
          {i === 0 && (
            <>
              <div class="ui__bar"><span class="ui__dot"></span><span>Ventas · Hoy</span><span class="ui__filter">Todas las tiendas ▾</span></div>
              <div class="ui__thead"><span>Folio</span><span>Tienda</span><span>Estado</span><span>Total</span></div>
              <div class="ui__row" data-ui-row><span>B-004812</span><span>Providencia</span><span class="ui__tag ui__tag--ok">Emitida</span><span>$36.541<i class="ui__pdf">PDF</i></span></div>
              <div class="ui__row" data-ui-row><span>F-001337</span><span>Costanera</span><span class="ui__tag ui__tag--ok">Emitida</span><span>$128.900</span></div>
              <div class="ui__row" data-ui-row><span>B-004813</span><span>Mall Plaza</span><span class="ui__tag ui__tag--muted">Anulada</span><span>$12.990</span></div>
              <div class="ui__row" data-ui-row><span>B-004814</span><span>Providencia</span><span class="ui__tag ui__tag--ok">Emitida</span><span>$54.980</span></div>
            </>
          )}
          {i === 1 && (
            <>
              <div class="ui__bar"><span class="ui__dot"></span><span>Carros con pago pendiente</span><span class="ui__count">2</span></div>
              <div class="ui__cart" data-ui-row>
                <div><strong>Carro #219</strong><small>Terminal 04 · Providencia · $54.980</small></div>
                <span class="ui__status" data-ui-status>
                  <span class="ui__spin" data-ui-spin></span>
                  <span class="ui__status-a" data-ui-a>Verificando en Mercado Pago…</span>
                  <span class="ui__status-b" data-ui-b>✓ Pago aprobado</span>
                </span>
                <span class="ui__action" data-ui-action>Completar venta</span>
              </div>
              <div class="ui__cart" data-ui-row>
                <div><strong>Carro #221</strong><small>Terminal 02 · Costanera · $19.990</small></div>
                <span class="ui__tag ui__tag--muted">Pago rechazado</span>
                <span class="ui__action ui__action--ghost">Retirar</span>
              </div>
            </>
          )}
          {i === 2 && (
            <>
              <div class="ui__bar"><span class="ui__dot"></span><span>Bitácora de auditoría</span><span class="ui__filter">Hoy ▾</span></div>
              <ol class="ui__log">
                <li data-ui-row><time>10:42</time><span>Venta B-004812 emitida</span></li>
                <li data-ui-row data-ui-flag><time>10:57</time><span>Incidencia en cobro · B-004815</span><em class="ui__hidden" data-ui-hidden>No visible · conservada</em></li>
                <li data-ui-row><time>11:05</time><span>Stock sincronizado con ERP</span></li>
              </ol>
              <p class="ui__foot" data-ui-row>🔒 Nada se borra · 3 registros conservados</p>
            </>
          )}
        </div>
      </article>
    ))}
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initBento() {
    const section = document.querySelector('.pfb[data-gsap-section^="pfb-"]');
    if (!section || section.dataset.pfbInit) return;
    section.dataset.pfbInit = '1';
    const cards = [...section.querySelectorAll('[data-pfb-card]')];
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced) { section.classList.add('is-static'); return; }

    gsap.from(section.querySelectorAll('.pfb__intro [data-gsap-animate="fade-up"]'), {
      opacity: 0, y: 20, duration: 0.8, stagger: 0.08, ease: 'power3.out',
      scrollTrigger: { trigger: section, start: 'top 80%' },
    });

    cards.forEach((card, i) => {
      // Entrada del panel
      gsap.from(card, {
        y: 60, opacity: 0, duration: 0.9, ease: 'power3.out',
        scrollTrigger: { trigger: card, start: 'top 92%' },
      });

      // El panel de atrás se hunde mientras el siguiente sube encima
      const next = cards[i + 1];
      if (next) {
        gsap.timeline({
          scrollTrigger: { trigger: next, start: 'top bottom', end: 'top 25%', scrub: true },
        })
          .to(card, { scale: 0.94, ease: 'none' }, 0)
          .to(card.querySelector('[data-pfb-veil]'), { opacity: 1, ease: 'none' }, 0);
      }

      // Mini-UI: se activa una vez cuando el panel llega a su lugar
      const ui = card.querySelector('[data-pfb-ui]');
      const rows = ui.querySelectorAll('[data-ui-row]');
      const tl = gsap.timeline({ paused: true });
      tl.from(rows, { opacity: 0, x: 18, duration: 0.5, stagger: 0.09, ease: 'power3.out' });
      if (ui.dataset.pfbUi === '1') {
        gsap.set(ui.querySelector('[data-ui-b]'), { autoAlpha: 0, y: 8 });
        gsap.set(ui.querySelector('[data-ui-action]'), { autoAlpha: 0, scale: 0.9 });
        tl.to(ui.querySelector('[data-ui-spin]'), { autoAlpha: 0, duration: 0.25 }, '+=1.1')
          .to(ui.querySelector('[data-ui-a]'), { autoAlpha: 0, y: -8, duration: 0.3 }, '<')
          .to(ui.querySelector('[data-ui-b]'), { autoAlpha: 1, y: 0, duration: 0.4, ease: 'back.out(2)' }, '-=0.1')
          .add(() => ui.querySelector('[data-ui-status]').classList.add('is-ok'), '<')
          .to(ui.querySelector('[data-ui-action]'), { autoAlpha: 1, scale: 1, duration: 0.4, ease: 'back.out(2)' }, '-=0.15');
      }
      if (ui.dataset.pfbUi === '2') {
        const flag = ui.querySelector('[data-ui-flag]');
        gsap.set(ui.querySelector('[data-ui-hidden]'), { autoAlpha: 0, x: -6 });
        tl.add(() => flag.classList.add('is-hidden'), '+=0.6')
          .to(ui.querySelector('[data-ui-hidden]'), { autoAlpha: 1, x: 0, duration: 0.4, ease: 'power3.out' }, '<+=0.1');
      }
      ScrollTrigger.create({ trigger: card, start: 'top 60%', once: true, onEnter: () => tl.play() });

      // Halo que sigue al cursor (solo puntero fino)
      if (window.matchMedia('(pointer: fine)').matches) {
        card.addEventListener('pointermove', (e) => {
          const r = card.getBoundingClientRect();
          card.style.setProperty('--mx', `${e.clientX - r.left}px`);
          card.style.setProperty('--my', `${e.clientY - r.top}px`);
        });
      }
    });
  }

  document.addEventListener('astro:page-load', initBento);
</script>

<style>
  .pfb { padding-block: var(--space-2xl); background-color: var(--bg-primary); }

  .pfb__intro { display: grid; gap: var(--space-lg); margin-bottom: var(--space-xl); }
  .pfb__copy { display: grid; gap: var(--space-sm); max-width: 56ch; }
  .pfb__eyebrow { font-size: var(--text-sm); letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-secondary); }
  .pfb__title { font-family: var(--font-heading); font-weight: 600; font-size: clamp(2.2rem, 5vw, 3.4rem); letter-spacing: -0.03em; line-height: 1.08; color: var(--navy); text-wrap: balance; }
  .pfb__note { font-size: clamp(1.1rem, 1.5vw, 1.3rem); color: var(--text-secondary); line-height: 1.6; }
  .pfb__frame { border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-md); }
  .pfb__img { width: 100%; height: 100%; object-fit: cover; display: block; aspect-ratio: 16 / 9; }

  /* ── Mazo de paneles ── */
  .pfb__stack { display: grid; gap: var(--space-lg); padding-bottom: var(--space-lg); }
  .pfb__card {
    position: sticky;
    top: calc(84px + var(--i) * 18px); /* header + escalón por panel */
    display: grid;
    gap: var(--space-lg);
    align-items: center;
    padding: clamp(1.5rem, 3vw, 3rem);
    border-radius: 28px;
    background-color: var(--bg-primary);
    border: 1px solid var(--border);
    box-shadow: 0 1px 0 var(--border), 0 30px 60px -30px color-mix(in srgb, var(--navy) 30%, transparent);
    overflow: hidden;
    transform-origin: 50% 0%;
    will-change: transform;
  }
  .pfb__card:nth-child(2) { background-color: color-mix(in srgb, var(--bg-secondary) 60%, var(--bg-primary)); }
  .pfb__card:nth-child(3) { background-color: var(--bg-secondary); }

  /* velo del panel que queda atrás */
  .pfb__veil { position: absolute; inset: 0; z-index: 3; background: color-mix(in srgb, var(--navy) 10%, transparent); opacity: 0; pointer-events: none; }
  /* halo sutil que sigue al cursor */
  .pfb__glow {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: radial-gradient(420px circle at var(--mx, 70%) var(--my, 30%), color-mix(in srgb, var(--accent) 7%, transparent), transparent 70%);
    opacity: 0;
    transition: opacity 0.4s var(--ease-out, ease-out);
  }
  .pfb__card:hover .pfb__glow { opacity: 1; }

  .pfb__card-copy { position: relative; z-index: 1; display: grid; gap: var(--space-sm); align-content: center; }
  .pfb__num { font-family: var(--font-heading); font-weight: 600; font-size: clamp(2.6rem, 5vw, 4rem); letter-spacing: -0.04em; line-height: 1; color: var(--accent); font-variant-numeric: tabular-nums; }
  .pfb__num small { font-size: 0.32em; letter-spacing: 0.02em; color: var(--text-secondary); margin-left: 0.4em; vertical-align: 0.35em; }
  .pfb__heading { font-family: var(--font-heading); font-weight: 600; font-size: clamp(1.4rem, 2.2vw, 1.9rem); color: var(--navy); letter-spacing: -0.02em; line-height: 1.15; }
  .pfb__text { font-size: var(--text-base); color: var(--text-secondary); line-height: 1.6; max-width: 46ch; }

  /* ── Mini-UI del BackOffice ── */
  .pfb__ui {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 8px;
    padding: 16px;
    border-radius: 18px;
    background-color: var(--bg-primary);
    border: 1px solid var(--border);
    box-shadow: 0 20px 40px -24px color-mix(in srgb, var(--navy) 35%, transparent);
    font-size: 13px;
    color: var(--navy);
    min-width: 0;
  }
  .ui__bar { display: flex; align-items: center; gap: 8px; padding-bottom: 10px; margin-bottom: 2px; border-bottom: 1px solid var(--border); font-weight: 600; }
  .ui__dot { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 18%, transparent); }
  .ui__filter, .ui__count { margin-left: auto; font-weight: 500; color: var(--text-secondary); font-size: 12px; }
  .ui__count { color: var(--on-accent); background: var(--accent); border-radius: var(--radius-full); padding: 1px 8px; font-weight: 600; }
  .ui__thead, .ui__row { display: grid; grid-template-columns: 1.1fr 1.2fr 1fr 1fr; gap: 8px; align-items: center; padding: 8px 10px; }
  .ui__thead { font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-secondary); padding-block: 2px; }
  .ui__row { border-radius: 10px; background: var(--bg-secondary); font-variant-numeric: tabular-nums; }
  .ui__row span:last-child { display: flex; align-items: center; gap: 6px; justify-content: flex-end; }
  .ui__pdf { font-style: normal; font-size: 10px; font-weight: 600; color: var(--accent); border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent); border-radius: 4px; padding: 0 4px; }
  .ui__tag { justify-self: start; font-size: 11px; font-weight: 600; padding: 2px 8px; border-radius: var(--radius-full); white-space: nowrap; }
  .ui__tag--ok { color: var(--accent); background: color-mix(in srgb, var(--accent) 10%, transparent); }
  .ui__tag--muted { color: var(--text-secondary); background: color-mix(in srgb, var(--navy) 7%, transparent); }

  .ui__cart { display: grid; grid-template-columns: 1fr auto; gap: 8px 12px; align-items: center; padding: 12px; border-radius: 12px; background: var(--bg-secondary); }
  .ui__cart strong { display: block; font-weight: 600; }
  .ui__cart small { font-size: 12px; color: var(--text-secondary); }
  .ui__status { position: relative; display: inline-grid; grid-template-columns: auto; align-items: center; font-size: 12px; font-weight: 600; color: var(--text-secondary); min-width: 13.5em; justify-items: end; }
  .ui__status > span:not(.ui__spin) { grid-area: 1 / 1; white-space: nowrap; }
  .ui__spin { position: absolute; left: -18px; width: 12px; height: 12px; border-radius: 50%; border: 2px solid color-mix(in srgb, var(--accent) 25%, transparent); border-top-color: var(--accent); animation: ui-spin 0.8s linear infinite; }
  .ui__status.is-ok .ui__status-b { color: var(--accent); }
  @keyframes ui-spin { to { transform: rotate(360deg); } }
  .ui__action { grid-column: 1 / -1; justify-self: end; font-size: 12px; font-weight: 600; color: var(--on-accent); background: var(--accent); padding: 6px 14px; border-radius: var(--radius-full); }
  .ui__action--ghost { color: var(--navy); background: transparent; border: 1px solid var(--border); }

  .ui__log { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .ui__log li { position: relative; display: grid; grid-template-columns: 44px 1fr auto; gap: 10px; align-items: center; padding: 10px 12px; border-radius: 12px; background: var(--bg-secondary); transition: background-color 0.4s; }
  .ui__log time { font-variant-numeric: tabular-nums; color: var(--text-secondary); font-size: 12px; }
  .ui__log li.is-hidden { color: color-mix(in srgb, var(--navy) 55%, transparent); background: repeating-linear-gradient(-45deg, var(--bg-secondary) 0 8px, color-mix(in srgb, var(--navy) 5%, var(--bg-secondary)) 8px 16px); }
  .ui__log li.is-hidden > span { text-decoration: line-through; text-decoration-color: color-mix(in srgb, var(--navy) 35%, transparent); }
  .ui__hidden { font-style: normal; font-size: 11px; font-weight: 600; color: var(--navy); background: var(--bg-primary); border: 1px solid var(--border); border-radius: var(--radius-full); padding: 2px 8px; white-space: nowrap; }
  .ui__foot { margin-top: 4px; font-size: 12px; color: var(--text-secondary); text-align: right; }

  @media (min-width: 900px) {
    /* El rail de capítulos (ProductoChapterNav) es fixed en x 32–155px: el
       contenido arranca a ≥200px para dejar un margen prudente. */
    .pfb__intro,
    .pfb__stack {
      padding-inline-start: max(var(--container-pad), calc(200px - max(0px, (100vw - var(--container-max)) / 2)));
    }
    .pfb__intro { grid-template-columns: 1fr 1fr; align-items: center; }
    .pfb__card { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--space-xl); min-height: min(62vh, 520px); }
  }

  @media (max-width: 899px) {
    .pfb__card { top: calc(64px + var(--i) * 12px); border-radius: 22px; }
    .pfb__ui { font-size: 12px; padding: 12px; }
    .ui__thead, .ui__row { grid-template-columns: 1fr 1.1fr 0.9fr; }
    .ui__thead span:nth-child(3), .ui__row span:nth-child(3) { display: none; }
    .ui__status { min-width: 0; justify-items: start; }
    .ui__cart { grid-template-columns: 1fr; }
    .ui__log li { grid-template-columns: 40px minmax(0, 1fr); }
    .ui__log li > span { min-width: 0; }
    .ui__hidden { grid-column: 2; justify-self: start; }
    .ui__foot { text-align: left; }
    .ui__cart > .ui__tag { justify-self: start; }
    .ui__spin { position: static; margin-right: 6px; }
  }

  /* Sin motion: panel apilado normal (sin sticky), mini-UIs en estado final */
  .pfb.is-static .pfb__card { position: relative; top: auto; }
  @media (prefers-reduced-motion: reduce) {
    .pfb__card { position: relative; top: auto; }
    .ui__spin, .ui__status-a { display: none; }
  }
</style>
