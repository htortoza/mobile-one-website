---
// src/components/producto/ProductoSwitcher.astro
// /producto — sub-nav sticky (pegada bajo el header) que alterna entre los 2
// paneles de contenido con crossfade+slide (nunca los 2 a la vez). Un solo
// control segmentado (mismo peso visual en ambos lados, fondo que se rellena
// en el activo) — no 2 botones sueltos: así se lee como un toggle, no como
// 2 acciones distintas (UX de segmented control).
const { tabs } = Astro.props;
const list = tabs ?? [];

const ICONS = {
  pos: 'M8 2h8a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2Z|M9.5 6h5|M9.5 9.5h5|M9.5 13h2.5',
  panel: 'M3 4h18v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4Z|M8 20.5h8|M12 17v3.5|M6.5 11.5 9 8.5l2.2 2 3.3-4',
};
---

<div class="psw" data-psw>
  <div class="container psw__outer">
    <div class="psw__bar" data-psw-bar>
      {list.map((tab, i) => (
        <button
          type="button"
          class="psw__btn"
          data-psw-btn
          data-target={tab.target}
          aria-pressed={i === 0 ? 'true' : 'false'}
        >
          <span class="psw__icon-chip" data-psw-icon>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              {ICONS[tab.icon].split('|').map((d) => <path d={d} />)}
            </svg>
          </span>
          <span class="psw__text">
            <span class="psw__label">{tab.label}</span>
            <span class="psw__sub">{tab.sub}</span>
          </span>
        </button>
      ))}
    </div>
  </div>
</div>

<script>
  import { gsap } from 'gsap';

  function initSwitcher() {
    const wrap = document.querySelector('[data-psw]');
    const buttons = Array.from(document.querySelectorAll('[data-psw-btn]'));
    const panels = Array.from(document.querySelectorAll('[data-psw-panel]'));
    if (!wrap || !buttons.length || !panels.length) return;

    const header = document.querySelector('[data-header]');
    const syncHeaderHeight = () => {
      const h = header ? header.getBoundingClientRect().height : 0;
      document.documentElement.style.setProperty('--header-h', `${h}px`);
    };
    syncHeaderHeight();
    if (header && 'ResizeObserver' in window) {
      new ResizeObserver(syncHeaderHeight).observe(header);
    } else {
      window.addEventListener('resize', syncHeaderHeight);
    }

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const panelsWrap = document.querySelector('[data-psw-panels]');

    function scrollToPanels() {
      if (!panelsWrap) return;
      const switcherH = wrap.getBoundingClientRect().height;
      const headerH = header ? header.getBoundingClientRect().height : 0;
      const target = window.scrollY + panelsWrap.getBoundingClientRect().top - headerH - switcherH;
      if (window.scrollY > target) {
        window.scrollTo({ top: target, behavior: 'auto' });
      }
    }

    function activate(target, { animate = true, updateHash = true } = {}) {
      const btn = buttons.find((b) => b.dataset.target === target);
      const panel = panels.find((p) => p.dataset.pswPanel === target);
      if (!btn || !panel || btn.getAttribute('aria-pressed') === 'true') return;

      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));

      if (!reduced) {
        const icon = btn.querySelector('[data-psw-icon]');
        if (icon) gsap.fromTo(icon, { scale: 0.75 }, { scale: 1, duration: 0.4, ease: 'back.out(2)' });
      }

      const current = panels.find((p) => !p.hidden);
      if (updateHash) history.replaceState(null, '', `#${target}`);

      function swap() {
        if (current) current.hidden = true;
        panel.hidden = false;
        if (animate) scrollToPanels();
      }

      if (!current || current === panel) {
        panel.hidden = false;
        return;
      }

      if (reduced || !animate) {
        swap();
        return;
      }

      gsap.to(current, {
        opacity: 0, y: -8, duration: 0.22, ease: 'power2.in',
        onComplete: () => {
          swap();
          gsap.fromTo(panel, { opacity: 0, y: 8 }, { opacity: 1, y: 0, duration: 0.4, ease: 'expo.out' });
        },
      });
    }

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => activate(btn.dataset.target));
    });

    const initial = window.location.hash.replace('#', '');
    if (initial && buttons.some((b) => b.dataset.target === initial) && initial !== buttons[0].dataset.target) {
      activate(initial, { animate: false, updateHash: false });
    }
  }

  document.addEventListener('astro:page-load', initSwitcher);
</script>

<style>
  .psw {
    position: sticky;
    top: var(--header-h, 72px);
    z-index: var(--z-above);
    background-color: color-mix(in srgb, var(--bg-primary) 92%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .psw__outer {
    display: flex;
    justify-content: center;
    padding-block: var(--space-sm);
  }

  /* Control segmentado: un solo bloque con fondo propio — los 2 lados
     tienen el mismo peso visual y comparten el mismo contenedor, para que
     se lea como UN toggle (2 estados de lo mismo), no 2 botones sueltos. */
  .psw__bar {
    display: flex;
    gap: 4px;
    width: min(100%, 480px);
    padding: 4px;
    background-color: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
  }

  .psw__btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-xs);
    flex: 1 1 0;
    min-width: 0;
    background-color: transparent;
    border: none;
    border-radius: var(--radius-full);
    padding: var(--space-xs) var(--space-sm);
    cursor: pointer;
    transition: background-color var(--transition-fast), box-shadow var(--transition-fast);
  }
  .psw__btn:not([aria-pressed="true"]):hover { background-color: color-mix(in srgb, var(--bg-primary) 70%, transparent); }

  .psw__icon-chip {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border-radius: var(--radius-full);
    color: var(--accent);
    transition: color var(--transition-fast);
  }
  .psw__icon-chip svg { width: 16px; height: 16px; }

  .psw__text { display: none; min-width: 0; flex-direction: column; gap: 0; text-align: left; }
  .psw__label { font-family: var(--font-heading); font-weight: 600; font-size: var(--text-sm); color: var(--navy); line-height: 1.2; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .psw__sub { font-size: 0.6875rem; color: var(--text-secondary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  .psw__btn[aria-pressed="true"] {
    background: var(--accent-gradient);
    box-shadow: var(--shadow-sm);
  }
  .psw__btn[aria-pressed="true"] .psw__icon-chip { color: var(--on-accent); }
  .psw__btn[aria-pressed="true"] .psw__label { color: var(--on-accent); }
  .psw__btn[aria-pressed="true"] .psw__sub { color: color-mix(in srgb, var(--on-accent) 80%, transparent); }

  @media (min-width: 480px) {
    .psw__bar { width: min(100%, 560px); }
    .psw__text { display: flex; }
    .psw__btn { justify-content: flex-start; padding: var(--space-xs) var(--space-md); }
  }
</style>
