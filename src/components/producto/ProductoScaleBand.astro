---
// src/components/producto/ProductoScaleBand.astro
// /producto §5.4 — "Diseñado para escalar". Banda full-bleed azul, ahora con
// un diagrama propio (hub + nodos-tienda conectados, mismo lenguaje visual
// de cables/paquetes que ArchitectureTeaser en Home) para que la sección no
// sea solo texto — el diagrama ilustra "1 código base" alimentando a toda
// la red de tiendas al mismo tiempo.
const { title, text, stat, statLabel } = Astro.props;
const NODE_COUNT = 5;
---

<section class="psb" data-gsap-section="psb">
  <div class="container psb__grid">
    <div class="psb__copy" data-gsap-animate="psb-content">
      {stat && (
        <p class="psb__stat" data-psb-stat data-value={stat}>0{statLabel && <span class="psb__stat-label">{statLabel}</span>}</p>
      )}
      <h2 class="psb__title">{title}</h2>
      <p class="psb__text">{text}</p>
    </div>

    <div class="psb__diagram" data-psb-diagram aria-hidden="true">
      <svg class="psb__cables" viewBox="0 0 100 100" preserveAspectRatio="none">
        {Array.from({ length: NODE_COUNT }).map((_, i) => (
          <path class="psb__cable" data-psb-cable data-index={i} />
        ))}
      </svg>
      <div class="psb__hub">
        <span class="psb__hub-dot"></span>
      </div>
      <div class="psb__nodes">
        {Array.from({ length: NODE_COUNT }).map((_, i) => (
          <span class="psb__node" data-psb-node data-index={i}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 10 12 4l8 6" />
              <path d="M5 10v10h14V10" />
              <path d="M10 20v-6h4v6" />
            </svg>
          </span>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function layoutDiagram(diagram) {
    const svg = diagram.querySelector('.psb__cables');
    const hub = diagram.querySelector('.psb__hub');
    const nodes = diagram.querySelectorAll('[data-psb-node]');
    if (!svg || !hub || window.innerWidth < 900) return;

    const box = diagram.getBoundingClientRect();
    const toPct = (x, y) => ({ x: ((x - box.left) / box.width) * 100, y: ((y - box.top) / box.height) * 100 });

    const hubBox = hub.getBoundingClientRect();
    const start = toPct(hubBox.right, hubBox.top + hubBox.height / 2);

    nodes.forEach((node) => {
      const i = node.dataset.index;
      const nodeBox = node.getBoundingClientRect();
      const end = toPct(nodeBox.left, nodeBox.top + nodeBox.height / 2);
      const midX = (start.x + end.x) / 2;
      const d = `M ${start.x} ${start.y} C ${midX} ${start.y}, ${midX} ${end.y}, ${end.x} ${end.y}`;
      svg.querySelectorAll(`[data-index="${i}"]`).forEach((p) => p.setAttribute('d', d));
    });
  }

  document.addEventListener('astro:page-load', () => {
    const section = document.querySelector('[data-gsap-section="psb"]');
    const content = section && section.querySelector('[data-gsap-animate="psb-content"]');
    if (!content) return;
    const stat = section.querySelector('[data-psb-stat]');
    const diagram = section.querySelector('[data-psb-diagram]');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (stat) {
      const target = Number(stat.dataset.value) || 0;
      if (reduced) {
        stat.firstChild.textContent = String(target);
      } else {
        const counter = { n: 0 };
        gsap.to(counter, {
          n: target,
          duration: 1.1,
          ease: 'power1.out',
          onUpdate: () => { stat.firstChild.textContent = String(Math.round(counter.n)); },
          scrollTrigger: { trigger: section, start: 'top 78%' },
        });
      }
    }

    if (diagram) {
      layoutDiagram(diagram);
      const onResize = () => layoutDiagram(diagram);
      window.addEventListener('resize', onResize);
      document.addEventListener('astro:before-swap', () => window.removeEventListener('resize', onResize), { once: true });
      ScrollTrigger.addEventListener('refresh', () => layoutDiagram(diagram));
    }

    if (reduced) return;

    gsap.from(content, {
      opacity: 0, y: 24, duration: 0.8, ease: 'expo.out',
      scrollTrigger: { trigger: section, start: 'top 80%' },
    });

    if (diagram) {
      const nodes = diagram.querySelectorAll('[data-psb-node]');
      const cables = diagram.querySelectorAll('[data-psb-cable]');
      gsap.from(diagram.querySelector('.psb__hub'), {
        opacity: 0, scale: 0.7, duration: 0.5, ease: 'back.out(2)',
        scrollTrigger: { trigger: section, start: 'top 75%' },
      });
      gsap.from(cables, {
        opacity: 0, duration: 0.5, stagger: 0.08,
        scrollTrigger: { trigger: section, start: 'top 72%' },
      });
      gsap.from(nodes, {
        opacity: 0, scale: 0.6, duration: 0.5, stagger: 0.08, ease: 'back.out(2)',
        scrollTrigger: { trigger: section, start: 'top 70%' },
      });
      gsap.to(diagram.querySelector('.psb__hub-dot'), {
        scale: 1.6, opacity: 0.4, duration: 1.4, repeat: -1, yoyo: true, ease: 'sine.inOut',
      });
    }
  });
</script>

<style>
  .psb { padding-block: var(--space-2xl); background: var(--accent-gradient); color: var(--on-accent); overflow: hidden; }
  .psb__grid { display: grid; gap: var(--space-xl); }

  .psb__copy { display: grid; gap: var(--space-sm); }
  .psb__stat {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: clamp(3.5rem, 8vw, 6rem);
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .psb__stat-label {
    display: block;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: var(--text-sm);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--on-accent) 75%, transparent);
    margin-top: var(--space-xs);
  }
  .psb__title {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: clamp(2rem, 4vw, 2.8rem);
    letter-spacing: -0.02em;
    line-height: 1.15;
    max-width: 20ch;
  }
  .psb__text { font-size: var(--text-lg); color: color-mix(in srgb, var(--on-accent) 88%, transparent); line-height: 1.6; max-width: 46ch; }

  /* ── Diagrama: hub "1 código base" irradiando a N tiendas ── */
  .psb__diagram { position: relative; display: none; }
  .psb__cables { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .psb__cable {
    stroke: color-mix(in srgb, var(--on-accent) 35%, transparent);
    stroke-width: 1.2;
    fill: none;
    vector-effect: non-scaling-stroke;
  }
  .psb__hub {
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 64px;
    height: 64px;
    border-radius: var(--radius-full);
    background-color: var(--on-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 0 8px color-mix(in srgb, var(--on-accent) 12%, transparent);
    z-index: 1;
  }
  .psb__hub-dot { width: 14px; height: 14px; border-radius: var(--radius-full); background: var(--accent); }

  .psb__nodes { display: flex; flex-direction: column; justify-content: space-between; height: 100%; margin-left: auto; width: fit-content; }
  .psb__node {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    background-color: color-mix(in srgb, var(--on-accent) 14%, transparent);
    color: var(--on-accent);
    border: 1px solid color-mix(in srgb, var(--on-accent) 25%, transparent);
  }
  .psb__node svg { width: 22px; height: 22px; }

  @media (min-width: 900px) {
    .psb__grid { grid-template-columns: 1.1fr 0.9fr; align-items: center; }
    .psb__diagram { display: block; height: 320px; }
  }
</style>
