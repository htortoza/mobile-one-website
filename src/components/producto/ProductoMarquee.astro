---
// src/components/producto/ProductoMarquee.astro
// /producto — Momento tipográfico puro: marquee infinito de palabras gigantes
// en contorno (texto = el diseño, §15.3). Sin foto, sin mockup: separa el Hero
// del resto para que no se sienta "una sección más".
const { words } = Astro.props;
const list = words ?? [];
---

<div class="pmarquee" data-gsap-section="pmarquee" aria-hidden="true">
  <div class="pmarquee__track">
    {[...list, ...list].map((w, i) => (
      <span class={`pmarquee__word ${i % list.length % 2 === 1 ? 'is-solid' : ''}`}>{w}</span>
    ))}
  </div>
</div>

<style>
  .pmarquee {
    background-color: var(--bg-primary);
    color: var(--text-primary);
    overflow: hidden;
    padding-block: var(--space-lg);
    border-block: 1px solid color-mix(in srgb, var(--text-primary) 10%, transparent);
  }
  .pmarquee__track {
    display: flex;
    align-items: center;
    gap: var(--space-xl);
    width: max-content;
    animation: pmarquee-scroll 26s linear infinite;
  }
  .pmarquee:hover .pmarquee__track { animation-play-state: paused; }
  .pmarquee__word {
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: clamp(2rem, 6vw, 4.5rem);
    letter-spacing: -0.02em;
    white-space: nowrap;
    color: transparent;
    -webkit-text-stroke: 1.5px color-mix(in srgb, var(--text-primary) 55%, transparent);
  }
  .pmarquee__word.is-solid {
    color: var(--accent-hover);
    -webkit-text-stroke: 0;
  }

  @keyframes pmarquee-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .pmarquee__track { animation: none; flex-wrap: wrap; width: 100%; }
  }
</style>
