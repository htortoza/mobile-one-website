---
// src/components/producto/ProductoMetrics.astro
// /producto — Cifras reales (mismos datos ya validados en Home, sin inventar).
// Asimétrico: una cifra grande domina, las otras dos van apiladas y chicas
// (§15.5 — nada de 3 columnas iguales).
const { big, small } = Astro.props;
const smallList = small ?? [];
---

<section class="pmetrics" data-gsap-section="pmetrics">
  <div class="container pmetrics__grid">
    <div class="pmetrics__big">
      <p class="pmetrics__num pmetrics__num--big" data-pmetric-num data-target={big.value}>0</p>
      <p class="pmetrics__label">{big.label}</p>
    </div>

    <div class="pmetrics__col">
      {smallList.map((s) => (
        <div class="pmetrics__item">
          {typeof s.value === 'number' ? (
            <p class="pmetrics__num" data-pmetric-num data-target={s.value}>0</p>
          ) : (
            <p class="pmetrics__num">{s.text}</p>
          )}
          <p class="pmetrics__label">{s.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initMetrics() {
    const section = document.querySelector('[data-gsap-section="pmetrics"]');
    if (!section) return;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    section.querySelectorAll('[data-pmetric-num]').forEach((el) => {
      const target = Number(el.dataset.target);
      if (!Number.isFinite(target)) return;
      if (reduced) { el.textContent = String(target); return; }
      const obj = { v: 0 };
      gsap.to(obj, {
        v: target,
        duration: 1.4,
        ease: 'power2.out',
        scrollTrigger: { trigger: el, start: 'top 85%', once: true },
        onUpdate: () => { el.textContent = String(Math.round(obj.v)); },
      });
    });

    if (!reduced) {
      gsap.from(section.querySelectorAll('.pmetrics__big, .pmetrics__item'), {
        opacity: 0, y: 16, duration: 0.6, stagger: 0.1, ease: 'power2.out',
        scrollTrigger: { trigger: section, start: 'top 85%' },
      });
    }
  }

  document.addEventListener('astro:page-load', initMetrics);
</script>

<style>
  .pmetrics {
    padding-block: var(--space-2xl);
    background-color: var(--bg-primary);
    color: var(--text-primary);
  }
  .pmetrics__grid {
    display: grid;
    gap: var(--space-2xl);
    align-items: end;
  }
  .pmetrics__num {
    font-family: var(--font-heading);
    font-weight: 500;
    color: var(--accent-hover);
    line-height: 0.95;
    font-variant-numeric: tabular-nums;
    font-size: clamp(2.2rem, 6vw, 3.6rem);
  }
  .pmetrics__num--big {
    font-size: clamp(6rem, 18vw, 14rem);
    letter-spacing: -0.04em;
  }
  .pmetrics__label { color: var(--text-secondary); margin-block-start: var(--space-xs); max-width: 26ch; }

  .pmetrics__col { display: grid; gap: var(--space-lg); }

  @media (min-width: 900px) {
    .pmetrics__grid { grid-template-columns: 1.4fr 1fr; }
    .pmetrics__col { border-left: 1px solid color-mix(in srgb, var(--text-primary) 15%, transparent); padding-left: var(--space-xl); }
  }
</style>
