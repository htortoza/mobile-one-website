---
// src/components/producto/ProductoTour.astro
// /producto — "Sala de control" (§20.2) versión oscura/neón: device fijo con
// glow, pantalla cambia de módulo con el scroll; rail con índice + progreso.
// 5 módulos (deep-dive de producto, más que el teaser de Home).
const { eyebrow, title, modules } = Astro.props;
const list = modules ?? [];
---

<section class="ptour" data-gsap-section="ptour">
  <div class="container ptour__head">
    {eyebrow && <p class="ptour__eyebrow" data-gsap-animate="fade-up">{eyebrow}</p>}
    <h2 class="ptour__title" data-gsap-animate="fade-up">{title}</h2>
  </div>

  <div class="ptour__pin ptour__desktop-only" data-ptour-pin>
    <div class="container ptour__stage">
      <div class="ptour__rail">
        <div class="ptour__dots" role="list">
          {list.map((_, i) => (
            <span class={`ptour__dot ${i === 0 ? 'is-active' : ''}`} data-ptour-dot={i} role="listitem" aria-hidden="true"></span>
          ))}
        </div>

        {list.map((m, i) => (
          <div class="ptour__rail-text" data-rail-text={i} style={i > 0 ? 'opacity:0' : ''}>
            <span class="ptour__num" aria-hidden="true">{m.num}</span>
            <h3 class="ptour__heading">{m.heading}</h3>
            <p class="ptour__desc">{m.text}</p>
          </div>
        ))}

        <div class="ptour__progress"><span class="ptour__progress-fill" data-ptour-progress></span></div>
      </div>

      <div class="ptour__device-wrap">
        <div class="ptour__glow" aria-hidden="true"></div>
        <div class="ptour__device">
          <div class="ptour__device-notch"></div>
          <div class="ptour__device-screen">
            {list.map((m, i) => (
              <div class={`pscr pscr--${m.kind}`} data-ptour-screen={i} style={i > 0 ? 'opacity:0' : ''}>
                {m.kind === 'queue' && (
                  <>
                    <p class="pscr__label">En fila</p>
                    <div class="pscr__counter-wrap">
                      <span class="pscr__counter pscr__counter--before" data-anim>12</span>
                      <span class="pscr__counter pscr__counter--after" data-anim>0</span>
                    </div>
                    <p class="pscr__done" data-anim>Venta cerrada</p>
                  </>
                )}
                {m.kind === 'stock' && (
                  <>
                    <p class="pscr__label">Stock en la red</p>
                    <ul class="pscr__list">
                      <li class="pscr__row" data-anim><span>Tienda Providencia</span><strong>0</strong></li>
                      <li class="pscr__row" data-anim><span>Bodega Norte</span><strong class="pscr__ok">14</strong></li>
                      <li class="pscr__row" data-anim><span>Tienda Centro</span><strong class="pscr__ok">6</strong></li>
                    </ul>
                  </>
                )}
                {m.kind === 'bulk' && (
                  <>
                    <p class="pscr__label">Bulto #482</p>
                    <ul class="pscr__list">
                      <li class="pscr__row" data-anim><span>SKU 10234</span><span class="pscr__check">✓</span></li>
                      <li class="pscr__row" data-anim><span>SKU 10891</span><span class="pscr__check">✓</span></li>
                      <li class="pscr__row" data-anim><span>SKU 11007</span><span class="pscr__check">✓</span></li>
                    </ul>
                    <p class="pscr__done" data-anim>Recepción completa</p>
                  </>
                )}
                {m.kind === 'promo' && (
                  <>
                    <p class="pscr__label">CloudPromo</p>
                    <ul class="pscr__list">
                      <li class="pscr__row" data-anim><span>2x1 categoría Calzado</span><span class="pscr__check">✓</span></li>
                      <li class="pscr__row" data-anim><span>-15% ticket sobre $30.000</span><span class="pscr__check">✓</span></li>
                    </ul>
                    <p class="pscr__done" data-anim>Reglas aplicadas al cobrar</p>
                  </>
                )}
                {m.kind === 'erp' && (
                  <>
                    <p class="pscr__label">Sincronización ERP</p>
                    <ul class="pscr__list">
                      <li class="pscr__row" data-anim><span>Ventas del día</span><span class="pscr__check">✓</span></li>
                      <li class="pscr__row" data-anim><span>Stock actualizado</span><span class="pscr__check">✓</span></li>
                      <li class="pscr__row" data-anim><span>Documentos emitidos</span><span class="pscr__check">✓</span></li>
                    </ul>
                    <p class="pscr__done" data-anim>SAP Business One al día</p>
                  </>
                )}
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="container ptour__mobile-only">
    {list.map((m) => (
      <div class="ptour__card" data-ptour-card>
        <div class="ptour__device ptour__device--sm">
          <div class="ptour__device-screen">
            <div class={`pscr pscr--${m.kind}`}>
              {m.kind === 'queue' && (<><p class="pscr__label">En fila</p><div class="pscr__counter-wrap"><span class="pscr__counter pscr__counter--after" data-anim>0</span></div><p class="pscr__done" data-anim>Venta cerrada</p></>)}
              {m.kind === 'stock' && (<><p class="pscr__label">Stock en la red</p><ul class="pscr__list"><li class="pscr__row" data-anim><span>Bodega Norte</span><strong class="pscr__ok">14</strong></li></ul></>)}
              {m.kind === 'bulk' && (<><p class="pscr__label">Bulto #482</p><ul class="pscr__list"><li class="pscr__row" data-anim><span>SKU 10234</span><span class="pscr__check">✓</span></li></ul></>)}
              {m.kind === 'promo' && (<><p class="pscr__label">CloudPromo</p><ul class="pscr__list"><li class="pscr__row" data-anim><span>-15% ticket</span><span class="pscr__check">✓</span></li></ul></>)}
              {m.kind === 'erp' && (<><p class="pscr__label">Sincronización ERP</p><p class="pscr__done" data-anim>SAP Business One al día</p></>)}
            </div>
          </div>
        </div>
        <div class="ptour__rail-text">
          <span class="ptour__num" aria-hidden="true">{m.num}</span>
          <h3 class="ptour__heading">{m.heading}</h3>
          <p class="ptour__desc">{m.text}</p>
        </div>
      </div>
    ))}
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);
  ScrollTrigger.config({ ignoreMobileResize: true });

  function revealScreenContent(screen, tl, pos) {
    if (!screen) return;
    const items = screen.querySelectorAll('[data-anim]');
    if (items.length) tl.fromTo(items, { opacity: 0, y: 10 }, { opacity: 1, y: 0, duration: 0.4, stagger: 0.07, ease: 'power2.out' }, pos);
    const before = screen.querySelector('.pscr__counter--before');
    const after = screen.querySelector('.pscr__counter--after');
    if (before && after) {
      tl.to(before, { opacity: 0, duration: 0.3 }, pos);
      tl.to(after, { opacity: 1, duration: 0.3 }, pos + 0.15);
    }
  }

  function initTour() {
    const section = document.querySelector('[data-gsap-section="ptour"]');
    if (!section) return;

    const pinEl = section.querySelector('[data-ptour-pin]');
    const stage = section.querySelector('.ptour__stage');
    const railTexts = section.querySelectorAll('[data-rail-text]');
    const screens = section.querySelectorAll('[data-ptour-screen]');
    const dots = section.querySelectorAll('[data-ptour-dot]');
    const progressFill = section.querySelector('[data-ptour-progress]');
    if (!pinEl || !stage || !railTexts.length) return;

    const mm = gsap.matchMedia();

    mm.add('(min-width: 1024px) and (prefers-reduced-motion: no-preference)', () => {
      gsap.from(stage, {
        opacity: 0, y: 24, scale: 0.97, duration: 1, ease: 'power2.out',
        scrollTrigger: { trigger: pinEl, start: 'top 80%' },
      });

      const n = railTexts.length;
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: pinEl,
          start: 'top top',
          end: '+=' + (n * 90) + '%',
          scrub: 1,
          pin: pinEl,
          anticipatePin: 1,
          invalidateOnRefresh: true,
          onUpdate: (self) => { if (progressFill) progressFill.style.transform = `scaleX(${self.progress})`; },
        },
      });

      revealScreenContent(screens[0], tl, 0);

      function transition(toIndex) {
        const seg = gsap.timeline();
        seg.to(railTexts[toIndex - 1], { opacity: 0, y: -10, duration: 0.18, ease: 'power1.in' }, 0);
        seg.to(screens[toIndex - 1], { opacity: 0, duration: 0.25, ease: 'power1.inOut' }, 0.02);
        seg.add(() => { dots[toIndex - 1].classList.remove('is-active'); dots[toIndex].classList.add('is-active'); }, 0.1);
        seg.to(screens[toIndex], { opacity: 1, duration: 0.3, ease: 'power1.inOut' }, 0.2);
        seg.to(railTexts[toIndex], { opacity: 1, y: 0, duration: 0.28, ease: 'power2.out' }, 0.24);
        revealScreenContent(screens[toIndex], seg, 0.3);
        return seg;
      }

      for (let i = 1; i < n; i++) {
        tl.to({}, { duration: 0.55 });
        tl.add(transition(i), '+=0');
      }
      tl.to({}, { duration: 0.6 });
    });

    mm.add('(max-width: 1023px), (prefers-reduced-motion: reduce)', () => {
      section.querySelectorAll('[data-ptour-card]').forEach((card) => {
        const tl = gsap.timeline({ scrollTrigger: { trigger: card, start: 'top 78%' } });
        tl.from(card, { opacity: 0, y: 20, duration: 0.6, ease: 'power2.out' });
        revealScreenContent(card.querySelector('.pscr'), tl, 0.1);
      });
    });
  }

  document.addEventListener('astro:page-load', initTour);
</script>

<style>
  .ptour { padding-block: var(--space-2xl); background-color: var(--bg-primary); color: var(--text-primary); overflow: hidden; }
  .ptour__head { display: grid; gap: var(--space-sm); margin-bottom: var(--space-lg); }
  .ptour__eyebrow { font-size: var(--text-sm); letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-secondary); }
  .ptour__title { font-family: var(--font-heading); font-weight: 500; font-size: clamp(1.9rem, 4.6vw, 3rem); letter-spacing: -0.02em; max-width: 30ch; }

  .ptour__pin { min-height: 100vh; display: flex; align-items: center; }
  .ptour__stage { width: 100%; display: grid; grid-template-columns: 1fr; gap: var(--space-xl); align-items: center; }

  .ptour__rail { display: grid; gap: var(--space-md); max-width: 46ch; }
  .ptour__dots { display: flex; gap: var(--space-xs); }
  .ptour__dot { width: 8px; height: 8px; border-radius: var(--radius-full); background-color: color-mix(in srgb, var(--text-primary) 18%, transparent); transition: background-color var(--transition-fast), transform var(--transition-fast); }
  .ptour__dot.is-active { background-color: var(--accent-hover); transform: scale(1.3); box-shadow: 0 0 8px 2px color-mix(in srgb, var(--accent-hover) 60%, transparent); }

  .ptour__rail-text { position: relative; display: grid; gap: var(--space-sm); grid-row: 2; grid-column: 1; }
  .ptour__num { font-family: var(--font-heading); font-weight: 500; font-size: clamp(2.4rem, 5vw, 3.6rem); color: color-mix(in srgb, var(--accent-hover) 30%, transparent); line-height: 1; }
  .ptour__heading { font-family: var(--font-heading); font-weight: 500; font-size: clamp(1.4rem, 2.6vw, 1.9rem); letter-spacing: -0.01em; color: var(--text-primary); max-width: 22ch; }
  .ptour__desc { color: var(--text-secondary); line-height: 1.6; max-width: 38ch; }

  .ptour__progress { height: 3px; background-color: color-mix(in srgb, var(--text-primary) 12%, transparent); border-radius: var(--radius-full); overflow: hidden; }
  .ptour__progress-fill { display: block; height: 100%; width: 100%; background-color: var(--accent-hover); transform: scaleX(0); transform-origin: left; }

  .ptour__device-wrap { position: relative; }
  .ptour__glow {
    position: absolute; inset: 10% 20%;
    background: radial-gradient(circle, color-mix(in srgb, var(--accent) 40%, transparent), transparent 70%);
    filter: blur(40px); z-index: 0;
  }
  .ptour__device {
    position: relative; z-index: 1;
    width: 100%; max-width: 340px; margin-inline: auto;
    aspect-ratio: 3 / 4;
    background-color: color-mix(in srgb, var(--bg-secondary) 90%, black 10%);
    border: 1px solid color-mix(in srgb, var(--text-primary) 12%, transparent);
    border-radius: 28px; padding: 10px; box-shadow: var(--shadow-lg);
  }
  .ptour__device-notch { width: 60px; height: 6px; border-radius: var(--radius-full); background-color: color-mix(in srgb, var(--text-primary) 20%, transparent); margin-inline: auto; margin-block-end: 8px; }
  .ptour__device-screen { position: relative; width: 100%; height: calc(100% - 22px); background-color: var(--bg-primary); border-radius: 20px; overflow: hidden; }

  .pscr { position: absolute; inset: 0; padding: var(--space-md); display: grid; align-content: start; gap: var(--space-sm); }
  .pscr__label { font-size: var(--text-xs); letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-secondary); }
  .pscr__counter-wrap { position: relative; height: 3.4rem; }
  .pscr__counter { position: absolute; inset: 0; font-family: var(--font-heading); font-weight: 500; font-size: 2.6rem; color: var(--text-primary); }
  .pscr__counter--after { opacity: 0; color: var(--accent-hover); }
  .pscr__done { width: fit-content; font-size: var(--text-xs); font-weight: 500; color: var(--accent-hover); background-color: color-mix(in srgb, var(--accent) 16%, transparent); padding: 4px 10px; border-radius: var(--radius-full); }
  .pscr__list { display: grid; gap: 6px; list-style: none; }
  .pscr__row { display: flex; justify-content: space-between; gap: var(--space-sm); font-size: var(--text-sm); padding: 6px 10px; border-radius: var(--radius-sm); background-color: color-mix(in srgb, var(--text-primary) 5%, transparent); color: var(--text-secondary); }
  .pscr__ok { color: var(--accent-hover); font-weight: 500; }
  .pscr__check { color: var(--accent-hover); font-weight: 500; }

  .ptour__mobile-only { display: none; }
  @media (max-width: 1023px), (prefers-reduced-motion: reduce) {
    .ptour__desktop-only { display: none; }
    .ptour__mobile-only { display: grid; gap: var(--space-xl); }
    .ptour__card { display: grid; gap: var(--space-md); justify-items: center; text-align: center; }
    .ptour__device--sm { max-width: 220px; aspect-ratio: 3 / 4; }
    .ptour__card .ptour__rail-text { justify-items: center; }
    .ptour__card .ptour__desc { max-width: 32ch; }
  }

  @media (min-width: 1024px) {
    .ptour__stage { grid-template-columns: 0.9fr 1.1fr; }
  }
</style>
