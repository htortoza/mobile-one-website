---
// src/components/Features.astro
// AGENTE FRONTEND: pasa title, subtitle (opcional) e items[] desde el contrato JSON
// AGENTE MOTION: stagger scroll-reveal en cada card via ScrollTrigger

interface Item {
  icon: string;        // SVG inline o string de texto/emoji
  title: string;
  description: string;
}

interface Props {
  title: string;
  subtitle?: string;
  items: Item[];
}

const { title, subtitle, items = [] } = Astro.props;
---

<section class="features" data-gsap-section="features">
  <div class="container">

    <div class="features__header">
      <h2 class="features__title">{title}</h2>
      {subtitle && <p class="features__subtitle">{subtitle}</p>}
    </div>

    <ul class="features__grid" role="list">
      {items.map((item, i) => (
        <li class="features__card" data-gsap-animate="feature-card">
          <span class="features__number" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
          <div class="features__card-body">
            <span class="features__icon" aria-hidden="true" set:html={item.icon} />
            <h3 class="features__card-title">{item.title}</h3>
            <p class="features__card-desc">{item.description}</p>
          </div>
        </li>
      ))}
    </ul>

  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const section = document.querySelector('[data-gsap-section="features"]');
  if (section && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const cards = section.querySelectorAll('[data-gsap-animate="feature-card"]');

    gsap.from(cards, {
      y: 40,
      opacity: 0,
      stagger: 0.12,
      duration: 0.9,
      ease: 'expo.out',
      scrollTrigger: {
        trigger: section,
        start: 'top 80%',
      },
    });
  }
</script>

<style>
  .features {
    padding-block: var(--space-xl);
    background-color: var(--bg-primary);
  }

  .features__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    margin-bottom: var(--space-xl);
    max-width: 560px;
  }

  .features__title {
    font-family: var(--font-heading);
    font-size: clamp(var(--text-2xl), 5vw, var(--text-3xl));
    line-height: 1.05;
    color: var(--text-primary);
    letter-spacing: -0.03em;
  }

  .features__subtitle {
    font-family: var(--font-body);
    font-size: var(--text-lg);
    color: var(--text-secondary);
    line-height: 1.6;
  }

  /* ── Grid: 1 col → 2 col → featured first + 2 col ── */
  .features__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
    list-style: none;
    padding: 0;
  }

  @media (min-width: 640px) {
    .features__grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-lg);
    }

    /* Featured: first card spans full width */
    .features__card:first-child {
      grid-column: 1 / -1;
    }
  }

  /* ── Card ── */
  .features__card {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding: var(--space-md);
    background-color: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    transition:
      box-shadow var(--transition-fast),
      border-color var(--transition-fast),
      transform var(--transition-fast);
  }

  .features__card:hover {
    box-shadow: var(--shadow-lg);
    border-color: var(--accent);
    transform: translateY(-6px);
  }

  /* ── Número de sección (elemento gráfico) ── */
  .features__number {
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 4vw, 4rem);
    line-height: 1;
    letter-spacing: -0.05em;
    color: var(--accent);
    opacity: 0.2;
    display: block;
  }

  /* ── Card body ── */
  .features__card-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    flex: 1;
  }

  /* ── Featured first card: layout horizontal en ≥640px ── */
  @media (min-width: 640px) {
    .features__card:first-child {
      flex-direction: row;
      align-items: flex-start;
      gap: var(--space-xl);
      padding: var(--space-lg);
    }

    .features__card:first-child .features__number {
      font-size: clamp(5rem, 8vw, 10rem);
      flex-shrink: 0;
      opacity: 0.15;
    }

    .features__card:first-child .features__card-body {
      padding-top: var(--space-xs);
    }
  }

  /* ── Icono ── */
  .features__icon {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    color: var(--accent);
    width: 2rem;
    height: 2rem;
  }

  .features__icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  .features__card-title {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    color: var(--text-primary);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .features__card-desc {
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--text-secondary);
    line-height: 1.6;
  }
</style>
